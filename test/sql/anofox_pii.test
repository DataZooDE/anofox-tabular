# ============================================================================
# Name Detection Edge Cases
# ============================================================================

# Name at end of long text
query I
SELECT list_contains(list_transform(pii_detect(repeat('x', 100) || ' John Smith'), x -> x.type), 'NAME');
----
true

# Name with punctuation - comma
query I
SELECT list_contains(list_transform(pii_detect('Mr. John Smith, PhD'), x -> x.type), 'NAME');
----
true

# Multiple names in one string
query I
SELECT pii_count('John, Mary, and David are here') >= 3;
----
true

# Name after other PII
query I
SELECT pii_count('Email: test@test.com, Contact: Sarah') >= 2;
----
true

