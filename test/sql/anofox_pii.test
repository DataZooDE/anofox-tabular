# IBAN Validation Tests
# ============================================================================

# German IBAN
query I
SELECT list_contains(list_transform(pii_detect('IBAN: DE89370400440532013000'), x -> x.type), 'IBAN');
----
true

# UK IBAN
query I
SELECT list_contains(list_transform(pii_detect('IBAN: GB82WEST12345698765432'), x -> x.type), 'IBAN');
