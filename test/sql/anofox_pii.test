# ============================================================================
# PII Audit Table Tests (Row-Level Audit)
# ============================================================================

# Create test table for audit tests
statement ok
CREATE TABLE audit_test_data (
    id INTEGER,
    email VARCHAR,
    notes VARCHAR,
    clean_text VARCHAR
);

statement ok
INSERT INTO audit_test_data VALUES
    (1, 'user@example.com', 'SSN: 123-45-6789', 'clean text'),
    (2, 'test@test.com', 'Card: 4111111111111111', 'safe text'),
    (3, 'admin@site.org', NULL, 'other text');

# Test pii_audit_table returns results
query I
SELECT COUNT(*) > 0 FROM pii_audit_table('audit_test_data');
----
true

# Test pii_audit_table schema - 8 columns
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM pii_audit_table('audit_test_data'));
----
8

# Test row_id column is populated
query I
SELECT COUNT(DISTINCT row_id) FROM pii_audit_table('audit_test_data');
----
3

# Test column_name matches expected values
query I
SELECT COUNT(DISTINCT column_name)
FROM pii_audit_table('audit_test_data')
WHERE column_name IN ('email', 'notes');
----
2

# Test pii_type is populated
query I
SELECT COUNT(*) FROM pii_audit_table('audit_test_data') WHERE pii_type = 'EMAIL';
----
3

# Test original_value is populated
query I
SELECT original_value FROM pii_audit_table('audit_test_data')
WHERE row_id = 1 AND pii_type = 'EMAIL';
----
user@example.com

# Test masked_value is populated (REDACT strategy by default)
query I
SELECT masked_value LIKE '%[EMAIL]%' FROM pii_audit_table('audit_test_data')
WHERE row_id = 1 AND pii_type = 'EMAIL';
----
true

# Test start_pos and end_pos
query II
SELECT start_pos, end_pos FROM pii_audit_table('audit_test_data')
WHERE row_id = 1 AND pii_type = 'EMAIL';
----
0	16

# Test confidence is populated
query I
SELECT confidence FROM pii_audit_table('audit_test_data')
WHERE row_id = 1 AND pii_type = 'EMAIL';
----
1.0

# Test column filtering with single column
query I
SELECT COUNT(DISTINCT column_name) FROM pii_audit_table('audit_test_data', 'email');
----
1

# Test column filtering with multiple columns
query I
SELECT COUNT(DISTINCT column_name) FROM pii_audit_table('audit_test_data', 'email,notes');
----
2

# Test clean column returns no results
query I
SELECT COUNT(*) FROM pii_audit_table('audit_test_data', 'clean_text');
----
0

# Test integration with pii_config - min_confidence filtering
statement ok
SET anofox_pii_min_confidence = 0.99;

query I
SELECT COUNT(*) FROM pii_audit_table('audit_test_data')
WHERE pii_type = 'EMAIL';
----
3

# Reset min_confidence
statement ok
SET anofox_pii_min_confidence = 0.5;

# Test integration with pii_config - enabled_types filtering
statement ok
SET anofox_pii_enabled_types = 'EMAIL';

query I
SELECT COUNT(DISTINCT pii_type) FROM pii_audit_table('audit_test_data');
----
1

query I
SELECT DISTINCT pii_type FROM pii_audit_table('audit_test_data');
----
EMAIL

# Reset enabled_types
statement ok
SET anofox_pii_enabled_types = '';

# Test integration with mask strategy
statement ok
SET anofox_pii_default_mask_strategy = 'partial';

query I
SELECT masked_value LIKE '%**@example.com%' FROM pii_audit_table('audit_test_data')
WHERE row_id = 1 AND pii_type = 'EMAIL';
----
true

# Reset mask strategy
statement ok
SET anofox_pii_default_mask_strategy = 'redact';

# Clean up
statement ok
DROP TABLE audit_test_data;

# ============================================================================
# Individual Validation Function Tests
# ============================================================================

# --- SSN Validation ---

# Valid SSN format
query I
SELECT pii_is_valid_ssn('123-45-6789');
----
true

# Valid SSN without dashes
query I
SELECT pii_is_valid_ssn('123456789');
----
true

# Invalid SSN (all zeros area)
query I
SELECT pii_is_valid_ssn('000-45-6789');
----
false

# Not an SSN format
query I
SELECT pii_is_valid_ssn('invalid');
----
false

# --- IBAN Validation ---

# Valid German IBAN (MOD-97 checksum)
query I
SELECT pii_is_valid_iban('DE89370400440532013000');
----
true

# Valid UK IBAN
query I
SELECT pii_is_valid_iban('GB82WEST12345698765432');
----
true

# Invalid IBAN checksum
query I
SELECT pii_is_valid_iban('DE00000000000000000000');
----
false

# Not an IBAN format
query I
SELECT pii_is_valid_iban('invalid');
----
false

# --- Credit Card Validation (Luhn) ---

# Valid Visa card
query I
SELECT pii_is_valid_credit_card('4111111111111111');
----
true

# Valid Mastercard
query I
SELECT pii_is_valid_credit_card('5500000000000004');
----
true

# Valid with spaces
query I
SELECT pii_is_valid_credit_card('4111 1111 1111 1111');
----
true

# Invalid Luhn checksum
query I
SELECT pii_is_valid_credit_card('4111111111111112');
----
false

# Not a card format
query I
SELECT pii_is_valid_credit_card('invalid');
----
false

# --- UK NINO Validation ---

# Valid NINO format
query I
SELECT pii_is_valid_nino('AB123456C');
----
true

# Valid NINO with spaces
query I
SELECT pii_is_valid_nino('AB 12 34 56 C');
----
true

# Invalid prefix (BG is forbidden)
query I
SELECT pii_is_valid_nino('BG123456C');
----
false

# Invalid prefix (TN is forbidden)
query I
SELECT pii_is_valid_nino('TN123456C');
----
false

# Not a NINO format
query I
SELECT pii_is_valid_nino('invalid');
----
false

# --- Crypto Address Validation ---

# Valid Bitcoin P2PKH (Genesis block)
query I
SELECT pii_is_valid_crypto_address('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa');
----
true

# Valid Bitcoin P2SH
query I
SELECT pii_is_valid_crypto_address('3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy');
----
true

# Valid Ethereum address
query I
SELECT pii_is_valid_crypto_address('0x742d35Cc6634C0532925a3b844Bc454e4438f44e');
----
true

# Invalid Bitcoin checksum (last char changed)
query I
SELECT pii_is_valid_crypto_address('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb');
----
false

# Not a crypto address
query I
SELECT pii_is_valid_crypto_address('invalid');
----
false

# --- German Tax ID Validation ---

# Test German Tax ID function exists and returns boolean
query I
SELECT typeof(pii_is_valid_de_tax_id('12345678903'));
----
BOOLEAN

# Invalid format
query I
SELECT pii_is_valid_de_tax_id('invalid');
----
false

# ============================================================================
# Type-Specific Detection Function Tests
# ============================================================================

# --- pii_detect_emails ---

# Single email
query I
SELECT len(pii_detect_emails('Contact: john@test.com'));
----
1

# Multiple emails
query I
SELECT len(pii_detect_emails('john@a.com and jane@b.com'));
----
2

# No emails returns empty list
query I
SELECT pii_detect_emails('No emails here');
----
[]

# Only returns EMAIL type
query I
SELECT DISTINCT (unnest(pii_detect_emails('Email: test@test.com, SSN: 123-45-6789'))).type;
----
EMAIL

# --- pii_detect_phones ---

# Phone number detection
query I
SELECT len(pii_detect_phones('Call +1-555-123-4567 now')) > 0;
----
true

# Only returns PHONE type
query I
SELECT DISTINCT (unnest(pii_detect_phones('Phone: (555) 123-4567, Email: test@test.com'))).type;
----
PHONE

# --- pii_detect_credit_cards ---

# Credit card detection
query I
SELECT len(pii_detect_credit_cards('Card: 4111111111111111'));
----
1

# Multiple cards
query I
SELECT len(pii_detect_credit_cards('4111111111111111 and 5500000000000004'));
----
2

# Only returns CREDIT_CARD type
query I
SELECT DISTINCT (unnest(pii_detect_credit_cards('Card: 4111111111111111, SSN: 123-45-6789'))).type;
----
CREDIT_CARD

# --- pii_detect_ssns ---

# SSN detection
query I
SELECT len(pii_detect_ssns('SSN: 123-45-6789'));
----
1

# Only returns US_SSN type (ignores email)
query I
SELECT len(pii_detect_ssns('SSN: 123-45-6789, email: test@test.com'));
----
1

# --- pii_detect_names ---

# Name detection
query I
SELECT len(pii_detect_names('Hello John Smith')) > 0;
----
true

# Only returns NAME type
query I
SELECT DISTINCT (unnest(pii_detect_names('John Smith at test@test.com'))).type;
----
NAME

# --- pii_detect_ibans ---

# IBAN detection
query I
SELECT len(pii_detect_ibans('IBAN: DE89370400440532013000'));
----
1

# Only returns IBAN type
query I
SELECT DISTINCT (unnest(pii_detect_ibans('IBAN: DE89370400440532013000, SSN: 123-45-6789'))).type;
----
IBAN

# --- NULL handling ---

# NULL input returns NULL
query I
SELECT pii_detect_emails(NULL);
----
NULL

query I
SELECT pii_detect_ssns(NULL);
----
NULL

# ============================================================================
# Batch Detection Function Tests
# ============================================================================

# Basic batch detection - returns array of arrays
query I
SELECT len(pii_detect_batch(['a@b.com', '123-45-6789', 'no pii']));
----
3

# First element has email
query I
SELECT len(pii_detect_batch(['a@b.com', 'no pii'])[1]) > 0;
----
true

# Second element has no PII
query I
SELECT pii_detect_batch(['a@b.com', 'no pii'])[2];
----
[]

# Empty array input
query I
SELECT pii_detect_batch([]);
----
[]

# NULL input returns NULL
query I
SELECT pii_detect_batch(NULL);
----
NULL

# NULL element in array is handled
query I
SELECT len(pii_detect_batch(['a@b.com', NULL, 'test']));
----
3

# Access specific match from batch result
query I
SELECT pii_detect_batch(['john@test.com'])[1][1].type;
----
EMAIL

# ============================================================================
# Advanced Masking Function Tests (Phase 6)
# ============================================================================

# --- pii_mask_column(value, pii_type, strategy) ---

# Basic type-specific masking with PARTIAL strategy
query I
SELECT pii_mask_column('My SSN is 123-45-6789', 'US_SSN', 'partial');
----
My SSN is ***-**-6789

# Type-specific masking with REDACT strategy
query I
SELECT pii_mask_column('Email: test@example.com', 'EMAIL', 'redact');
----
Email: [EMAIL]

# Type-specific masking with ASTERISK strategy
query I
SELECT pii_mask_column('Card: 4111111111111111', 'CREDIT_CARD', 'asterisk');
----
Card: ****************

# Type-specific masking with HASH strategy (8 hex chars)
query I
SELECT regexp_matches(pii_mask_column('SSN: 123-45-6789', 'US_SSN', 'hash'), '[0-9a-f]{8}');
----
true

# Only masks the specified type (ignores other PII)
query I
SELECT pii_mask_column('SSN: 123-45-6789, Email: a@b.com', 'US_SSN', 'redact');
----
SSN: [US_SSN], Email: a@b.com

# Returns original when no PII of specified type found
query I
SELECT pii_mask_column('Just email: test@test.com', 'US_SSN', 'redact');
----
Just email: test@test.com

# NULL input returns NULL
query I
SELECT pii_mask_column(NULL, 'EMAIL', 'redact');
----
NULL

# Case-insensitive type name
query I
SELECT pii_mask_column('Email: a@b.com', 'email', 'redact');
----
Email: [EMAIL]

# Case-insensitive strategy
query I
SELECT pii_mask_column('SSN: 123-45-6789', 'US_SSN', 'PARTIAL');
----
SSN: ***-**-6789

# IBAN partial masking (first 4, last 4 visible)
query I
SELECT pii_mask_column('IBAN: DE89370400440532013000', 'IBAN', 'partial');
----
IBAN: DE89**************3000

# Credit card partial masking (first 4 and last 4 visible)
query I
SELECT pii_mask_column('Card: 4111111111111111', 'CREDIT_CARD', 'partial');
----
Card: 4111********1111

# Invalid type throws error
statement error
SELECT pii_mask_column('test', 'INVALID_TYPE', 'redact');
----
Unknown PII type

# --- pii_redact_column(value, strategy) ---

# Masks all PII types with specified strategy
query I
SELECT pii_redact_column('Email: a@b.com, SSN: 123-45-6789', 'redact');
----
Email: [EMAIL], SSN: [US_SSN]

# All PII with asterisk strategy
query I
SELECT pii_redact_column('Email: a@b.com, SSN: 123-45-6789', 'asterisk');
----
Email: *******, SSN: ***********

# All PII with partial strategy
query I
SELECT pii_redact_column('SSN: 123-45-6789', 'partial');
----
SSN: ***-**-6789

# All PII with hash strategy (8 hex chars)
query I
SELECT regexp_matches(pii_redact_column('Email: test@test.com', 'hash'), '[0-9a-f]{8}');
----
true

# Returns original when no PII found
query I
SELECT pii_redact_column('No PII here', 'redact');
----
No PII here

# NULL input returns NULL
query I
SELECT pii_redact_column(NULL, 'redact');
----
NULL

# Multiple types masked
query I
SELECT length(pii_redact_column('IBAN: DE89370400440532013000, SSN: 123-45-6789', 'asterisk')) > 0;
----
true

# --- pii_redact_column(value) - default strategy ---

# Default uses configuration default (REDACT)
query I
SELECT pii_redact_column('Email: test@test.com');
----
Email: [EMAIL]

# SSN with default strategy (using longer text to avoid NER false positives)
query I
SELECT pii_redact_column('My social security number is 123-45-6789');
----
My social security number is [US_SSN]

# Multiple PII with default
query I
SELECT pii_redact_column('Contact me at a@b.com and my SSN is 123-45-6789');
----
Contact me at [EMAIL] and my SSN is [US_SSN]

# NULL input returns NULL
query I
SELECT pii_redact_column(NULL);
----
NULL

# No PII returns original
query I
SELECT pii_redact_column('Hello World');
----
Hello World

# --- Configuration Integration ---

# Set default mask strategy to PARTIAL
statement ok
SET anofox_pii_default_mask_strategy = 'partial';

# pii_redact_column now uses PARTIAL
query I
SELECT pii_redact_column('SSN: 123-45-6789');
----
SSN: ***-**-6789

# Reset to REDACT
statement ok
SET anofox_pii_default_mask_strategy = 'redact';

# Verify reset (using longer text to avoid NER false positives)
query I
SELECT pii_redact_column('My SSN is 123-45-6789');
----
My SSN is [US_SSN]

# --- Use in UPDATE-style scenarios (via subquery) ---

# Can be used with table data
statement ok
CREATE TEMP TABLE test_masking AS SELECT * FROM (VALUES
    (1, 'Contact me at john@test.com please'),
    (2, 'My SSN is 123-45-6789'),
    (3, 'No PII here')
) AS t(id, text_value);

# Query with masking applied
query II
SELECT id, pii_redact_column(text_value) FROM test_masking ORDER BY id;
----
1	Contact me at [EMAIL] please
2	My SSN is [US_SSN]
3	No PII here

# Query with type-specific masking
query II
SELECT id, pii_mask_column(text_value, 'US_SSN', 'partial') FROM test_masking ORDER BY id;
----
1	Contact me at john@test.com please
2	My SSN is ***-**-6789
3	No PII here

statement ok
DROP TABLE test_masking;

# ============================================================================
# Deep Validation Tests (Phase 7) - Phone Number Integration
# ============================================================================

# Check deep_validation appears in pii_config
query I
SELECT option_value FROM pii_config() WHERE option_name = 'anofox_pii_deep_validation';
----
false

# Enable deep validation
statement ok
SET anofox_pii_deep_validation = true;

# Verify enabled
query I
SELECT option_value FROM pii_config() WHERE option_name = 'anofox_pii_deep_validation';
----
true

# Phone detection with deep validation - valid US number
query I
SELECT len(pii_detect('+1-415-123-4567')) > 0;
----
true

# Phone detection with deep validation - properly formatted international
query I
SELECT len(pii_detect('+44 20 7946 0958')) > 0;
----
true

# Phone detection with deep validation - too short number fails
# (The regex might not match this, but if it does, deep validation should reject it)
query I
SELECT len(pii_detect('+1-555')) > 0;
----
false

# Disable deep validation
statement ok
SET anofox_pii_deep_validation = false;

# Verify disabled
query I
SELECT option_value FROM pii_config() WHERE option_name = 'anofox_pii_deep_validation';
----
false

# Reset to ensure clean state for any subsequent tests
statement ok
SET anofox_pii_min_confidence = 0.5;

statement ok
SET anofox_pii_default_mask_strategy = 'redact';

statement ok
SET anofox_pii_enabled_types = '';