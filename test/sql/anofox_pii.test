# ============================================================================
# Multi-Entity Type Detection Tests
# ============================================================================

# All 4 NER entity types in one text
query I
SELECT pii_count('John Smith from Microsoft visited Paris to study French') >= 4;
----
true

# Verify distinct entity types detected
query I
SELECT list_contains(list_transform(pii_detect('Alice works at Google in Berlin'), x -> x.type), 'NAME')
   AND list_contains(list_transform(pii_detect('Alice works at Google in Berlin'), x -> x.type), 'ORGANIZATION')
   AND list_contains(list_transform(pii_detect('Alice works at Google in Berlin'), x -> x.type), 'LOCATION');
----
true

# Masking preserves all entity types
query I
SELECT pii_mask('John Smith from Microsoft visited Paris', 'redact')
    LIKE '%[NAME]%[ORGANIZATION]%[LOCATION]%';
----
true

# ============================================================================
# Entity Type Detection in pii_detect Output
# ============================================================================

# Verify ORGANIZATION in detect output
query I
SELECT list_contains(list_transform(pii_detect('I work at Facebook'), x -> x.type), 'ORGANIZATION');
----
true

# Verify LOCATION in detect output
query I
SELECT list_contains(list_transform(pii_detect('I visited Tokyo'), x -> x.type), 'LOCATION');
----
true

# Verify MISC in detect output (languages are typically classified as MISC)
query I
SELECT list_contains(list_transform(pii_detect('He speaks Spanish fluently'), x -> x.type), 'MISC');
----
true

