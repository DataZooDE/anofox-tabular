# name: test/sql/anofox_pii.test
# description: Test PII detection and masking functions
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

# ============================================================================
# Basic PII Detection Tests
# ============================================================================

# pii_detect now returns LIST(STRUCT(type VARCHAR, text VARCHAR, start_pos BIGINT, end_pos BIGINT, confidence DOUBLE))
# This is idiomatic DuckDB style, allowing struct field access and unnest operations

# Test email detection - using list_contains with list_transform
query I
SELECT list_contains(list_transform(pii_detect('Contact: john.doe@example.com'), x -> x.type), 'EMAIL');
----
true

# Test email detection - verify struct fields via unnest
query IIIII
SELECT match.type, match.text, match.start_pos, match.end_pos, match.confidence
FROM (SELECT unnest(pii_detect('Contact: john.doe@example.com')) as match);
----
EMAIL	john.doe@example.com	9	29	1.0

# Test SSN detection
query I
SELECT list_contains(list_transform(pii_detect('SSN: 123-45-6789'), x -> x.type), 'US_SSN');
----
true

# Test credit card detection
query I
SELECT list_contains(list_transform(pii_detect('Card: 4111111111111111'), x -> x.type), 'CREDIT_CARD');
----
true

# Test IBAN detection
query I
SELECT list_contains(list_transform(pii_detect('IBAN: DE89370400440532013000'), x -> x.type), 'IBAN');
----
true

# Test IP address detection
query I
SELECT list_contains(list_transform(pii_detect('Server: 192.168.1.100'), x -> x.type), 'IP_ADDRESS');
----
true

# Test URL detection
query I
SELECT list_contains(list_transform(pii_detect('Visit https://example.com/page'), x -> x.type), 'URL');
----
true

# Test multiple PII types in one string - detect both types
query II
SELECT
    list_contains(list_transform(pii_detect('Email: test@test.com, SSN: 123-45-6789'), x -> x.type), 'EMAIL'),
    list_contains(list_transform(pii_detect('Email: test@test.com, SSN: 123-45-6789'), x -> x.type), 'US_SSN');
----
true	true

# Test counting matches by type
query II
SELECT match.type, count(*) as cnt
FROM (SELECT unnest(pii_detect('Emails: a@b.com, c@d.com')) as match)
GROUP BY match.type;
----
EMAIL	2

# Test no PII detected (empty list)
query I
SELECT pii_detect('This is a normal text with no sensitive data');
----
[]

# Test NULL input
query I
SELECT pii_detect(NULL);
----
NULL

# Test empty string
query I
SELECT len(pii_detect(''));
----
0

# ============================================================================
# PII Masking Tests
# ============================================================================

# Test REDACT masking strategy (replaces with [TYPE] where TYPE is EMAIL, SSN, etc.)
query I
SELECT pii_mask('Email: test@example.com', 'redact') LIKE '%[EMAIL]%';
----
true

# Test PARTIAL masking for email
query I
SELECT pii_mask('Email: test@example.com', 'partial');
----
Email: te**@example.com

# Test PARTIAL masking for SSN
query I
SELECT pii_mask('SSN: 123-45-6789', 'partial');
----
SSN: ***-**-6789

# Test ASTERISK masking
query I
SELECT pii_mask('Email: test@example.com', 'asterisk');
----
Email: ****************

# Test HASH masking (should contain hash characters)
query I
SELECT length(pii_mask('Email: test@example.com', 'hash')) > 0;
----
true

# Test masking with no PII
query I
SELECT pii_mask('Normal text', 'redact');
----
Normal text

# Test NULL input for masking
query I
SELECT pii_mask(NULL, 'redact');
----
NULL

# ============================================================================
# PII Contains and Count Tests
# ============================================================================

# Test pii_contains
query I
SELECT pii_contains('Email: test@example.com');
----
true

query I
SELECT pii_contains('Normal text without PII');
----
false

# Test pii_count
query I
SELECT pii_count('Email: test@example.com and SSN: 123-45-6789');
----
2

query I
SELECT pii_count('No PII here');
----
0

# ============================================================================
# Credit Card Validation Tests
# ============================================================================

# Visa card (valid format)
query I
SELECT list_contains(list_transform(pii_detect('Card: 4111111111111111'), x -> x.type), 'CREDIT_CARD');
----
true

# Mastercard (valid format)
query I
SELECT list_contains(list_transform(pii_detect('Card: 5500000000000004'), x -> x.type), 'CREDIT_CARD');
----
true

# Amex (valid format)
query I
SELECT list_contains(list_transform(pii_detect('Card: 340000000000009'), x -> x.type), 'CREDIT_CARD');
----
true

# Card with spaces
query I
SELECT list_contains(list_transform(pii_detect('Card: 4111 1111 1111 1111'), x -> x.type), 'CREDIT_CARD');
----
true

# Card with dashes
query I
SELECT list_contains(list_transform(pii_detect('Card: 4111-1111-1111-1111'), x -> x.type), 'CREDIT_CARD');
----
true

