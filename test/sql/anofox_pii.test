# name: test/sql/anofox_pii.test
# description: Test PII detection and masking functions
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

# ============================================================================
# Basic PII Detection Tests
# ============================================================================

# Test email detection
query I
SELECT pii_detect('Contact: john.doe@example.com') LIKE '%EMAIL%';
----
true

# Test SSN detection
query I
SELECT pii_detect('SSN: 123-45-6789') LIKE '%US_SSN%';
----
true

# Test credit card detection
query I
SELECT pii_detect('Card: 4111111111111111') LIKE '%CREDIT_CARD%';
----
true

# Test IBAN detection
query I
SELECT pii_detect('IBAN: DE89370400440532013000') LIKE '%IBAN%';
----
true

# Test IP address detection
query I
SELECT pii_detect('Server: 192.168.1.100') LIKE '%IP_ADDRESS%';
----
true

# Test URL detection
query I
SELECT pii_detect('Visit https://example.com/page') LIKE '%URL%';
----
true

# Test multiple PII types in one string
query I
SELECT pii_detect('Email: test@test.com, SSN: 123-45-6789') LIKE '%EMAIL%'
   AND pii_detect('Email: test@test.com, SSN: 123-45-6789') LIKE '%US_SSN%';
----
true

# Test no PII detected
query I
SELECT pii_detect('This is a normal text with no PII');
----
[]

# Test NULL input
query I
SELECT pii_detect(NULL);
----
NULL

# ============================================================================
# PII Masking Tests
# ============================================================================

# Test REDACT masking strategy (replaces with [TYPE] where TYPE is EMAIL, SSN, etc.)
query I
SELECT pii_mask('Email: test@example.com', 'redact') LIKE '%[EMAIL]%';
----
true

# Test PARTIAL masking for email
query I
SELECT pii_mask('Email: test@example.com', 'partial');
----
Email: te**@example.com

# Test PARTIAL masking for SSN
query I
SELECT pii_mask('SSN: 123-45-6789', 'partial');
----
SSN: ***-**-6789

# Test ASTERISK masking
query I
SELECT pii_mask('Email: test@example.com', 'asterisk');
----
Email: ****************

# Test HASH masking (should contain hash characters)
query I
SELECT length(pii_mask('Email: test@example.com', 'hash')) > 0;
----
true

# Test masking with no PII
query I
SELECT pii_mask('Normal text', 'redact');
----
Normal text

# Test NULL input for masking
query I
SELECT pii_mask(NULL, 'redact');
----
NULL

# ============================================================================
# PII Contains and Count Tests
# ============================================================================

# Test pii_contains
query I
SELECT pii_contains('Email: test@example.com');
----
true

query I
SELECT pii_contains('Normal text without PII');
----
false

# Test pii_count
query I
SELECT pii_count('Email: test@example.com and SSN: 123-45-6789');
----
2

query I
SELECT pii_count('No PII here');
----
0

# ============================================================================
# Credit Card Validation Tests
# ============================================================================

# Visa card (valid format)
query I
SELECT pii_detect('Card: 4111111111111111') LIKE '%CREDIT_CARD%';
----
true

# Mastercard (valid format)
query I
SELECT pii_detect('Card: 5500000000000004') LIKE '%CREDIT_CARD%';
----
true

# Amex (valid format)
query I
SELECT pii_detect('Card: 340000000000009') LIKE '%CREDIT_CARD%';
----
true

# Card with spaces
query I
SELECT pii_detect('Card: 4111 1111 1111 1111') LIKE '%CREDIT_CARD%';
----
true

# Card with dashes
query I
SELECT pii_detect('Card: 4111-1111-1111-1111') LIKE '%CREDIT_CARD%';
----
true

# ============================================================================
# IBAN Validation Tests
# ============================================================================

# German IBAN
query I
SELECT pii_detect('IBAN: DE89370400440532013000') LIKE '%IBAN%';
----
true

# UK IBAN
query I
SELECT pii_detect('IBAN: GB82WEST12345698765432') LIKE '%IBAN%';
----
true

# ============================================================================
# Edge Cases
# ============================================================================

# Empty string
query I
SELECT pii_detect('');
----
[]

# String with only whitespace
query I
SELECT pii_detect('   ');
----
[]

# Very long text with PII at the end
query I
SELECT pii_detect(repeat('x', 1000) || ' email: test@example.com') LIKE '%EMAIL%';
----
true

# ============================================================================
# MAC Address Detection Tests
# ============================================================================

# Colon-separated format
query I
SELECT pii_detect('Device MAC: 00:1A:2B:3C:4D:5E') LIKE '%MAC_ADDRESS%';
----
true

# Hyphen-separated format
query I
SELECT pii_detect('NIC: 00-1A-2B-3C-4D-5E') LIKE '%MAC_ADDRESS%';
----
true

# Dot-separated format (Cisco style)
query I
SELECT pii_detect('Switch: 001A.2B3C.4D5E') LIKE '%MAC_ADDRESS%';
----
true

# No separator format
query I
SELECT pii_detect('MAC 001A2B3C4D5E') LIKE '%MAC_ADDRESS%';
----
true

# MAC masking - REDACT
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'redact') LIKE '%[MAC_ADDRESS]%';
----
true

# MAC masking - PARTIAL (shows vendor prefix)
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'partial');
----
MAC: 00:1A:**:**:**:**

# MAC masking - ASTERISK
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'asterisk');
----
MAC: *****************

# ============================================================================
# UK National Insurance Number (NINO) Tests
# ============================================================================

# Standard format without spaces
query I
SELECT pii_detect('NINO: AB123456C') LIKE '%UK_NINO%';
----
true

# Format with spaces
query I
SELECT pii_detect('NI Number: AB 12 34 56 C') LIKE '%UK_NINO%';
----
true

# NINO masking - REDACT
query I
SELECT pii_mask('NINO: AB123456C', 'redact') LIKE '%[UK_NINO]%';
----
true

# NINO masking - PARTIAL (shows first 2 and last 1, formatted with spaces)
query I
SELECT pii_mask('NINO: AB123456C', 'partial');
----
NINO: AB ** ** ** C

# Invalid prefix - should not match (D is forbidden as first char)
query I
SELECT pii_detect('Invalid: DA123456C') LIKE '%UK_NINO%';
----
false

# Invalid prefix - BG is forbidden
query I
SELECT pii_detect('Invalid: BG123456C') LIKE '%UK_NINO%';
----
false

# ============================================================================
# US Passport Tests
# ============================================================================

# Current format (9 digits)
query I
SELECT pii_detect('Passport: 123456789') LIKE '%US_PASSPORT%';
----
true

# Legacy format (letter + 8 digits)
query I
SELECT pii_detect('Passport: A12345678') LIKE '%US_PASSPORT%';
----
true

# US Passport masking - REDACT
query I
SELECT pii_mask('Passport: A12345678', 'redact') LIKE '%[US_PASSPORT]%';
----
true

# US Passport masking - PARTIAL
query I
SELECT pii_mask('Passport: A12345678', 'partial');
----
Passport: A********

# Should NOT match 10 digits (too long for passport)
query I
SELECT pii_detect('Not passport: 1234567890') LIKE '%US_PASSPORT%';
----
false

# ============================================================================
# Phone Number Tests
# ============================================================================

# International format with + prefix
query I
SELECT pii_detect('Call me at +1-555-123-4567 anytime') LIKE '%PHONE%';
----
true

# UK international format
query I
SELECT pii_detect('UK: +44 20 7946 0958 today') LIKE '%PHONE%';
----
true

# US format with parentheses
query I
SELECT pii_detect('Phone: (555) 123-4567') LIKE '%PHONE%';
----
true

# Phone masking - REDACT
query I
SELECT pii_mask('Call +1-555-123-4567 now', 'redact') LIKE '%[PHONE]%';
----
true

# Phone masking - PARTIAL (shows last 4 digits)
query I
SELECT pii_mask('Phone: (555) 123-4567', 'partial');
----
Phone: ***-***-4567

# SSN should NOT be detected as phone
query I
SELECT pii_detect('SSN: 123-45-6789') LIKE '%PHONE%';
----
false

# ============================================================================
# API Key Tests
# ============================================================================

# AWS Access Key ID
query I
SELECT pii_detect('Key: AKIAIOSFODNN7EXAMPLE') LIKE '%API_KEY%';
----
true

# GitHub Personal Access Token
query I
SELECT pii_detect('Token: ghp_1234567890abcdefghijklmnopqrstuvwxyz') LIKE '%API_KEY%';
----
true

# GitHub OAuth Token
query I
SELECT pii_detect('OAuth: gho_abcdefghijklmnopqrstuvwxyz012345') LIKE '%API_KEY%';
----
true

# API Key masking - REDACT
query I
SELECT pii_mask('Key: AKIAIOSFODNN7EXAMPLE', 'redact') LIKE '%[API_KEY]%';
----
true

# API Key masking - PARTIAL (AWS shows AKIA prefix)
query I
SELECT pii_mask('Key: AKIAIOSFODNN7EXAMPLE', 'partial');
----
Key: AKIA****************

# Low entropy string should NOT match (repetitive)
query I
SELECT pii_detect('Not a key: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa') LIKE '%API_KEY%';
----
false

# ============================================================================
# Multiple New PII Types in One String
# ============================================================================

# Multiple new types detected
query I
SELECT pii_detect('MAC: 00:1A:2B:3C:4D:5E, Call +44-20-7946-0958 now') LIKE '%MAC_ADDRESS%'
   AND pii_detect('MAC: 00:1A:2B:3C:4D:5E, Call +44-20-7946-0958 now') LIKE '%PHONE%';
----
true

# Mixed old and new types
query I
SELECT pii_count('Email: test@test.com, MAC: 00:1A:2B:3C:4D:5E, SSN: 123-45-6789');
----
3

# ============================================================================
# Cryptocurrency Address Tests
# ============================================================================

# Bitcoin legacy (P2PKH) - Genesis block address
query I
SELECT pii_detect('Wallet: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa') LIKE '%CRYPTO_ADDRESS%';
----
true

# Bitcoin P2SH
query I
SELECT pii_detect('Send: 3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy') LIKE '%CRYPTO_ADDRESS%';
----
true

# Bitcoin SegWit (bech32)
query I
SELECT pii_detect('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq') LIKE '%CRYPTO_ADDRESS%';
----
true

# Ethereum address
query I
SELECT pii_detect('0x742d35Cc6634C0532925a3b844Bc454e4438f44e') LIKE '%CRYPTO_ADDRESS%';
----
true

# Invalid Bitcoin checksum (last char changed)
query I
SELECT pii_detect('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb') LIKE '%CRYPTO_ADDRESS%';
----
false

# Invalid Ethereum (wrong length - too short)
query I
SELECT pii_detect('0x742d35Cc6634') LIKE '%CRYPTO_ADDRESS%';
----
false

# CRYPTO_ADDRESS masking - REDACT
query I
SELECT pii_mask('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa', 'redact') LIKE '%[CRYPTO_ADDRESS]%';
----
true

# CRYPTO_ADDRESS masking - PARTIAL (first 4 + last 4)
query I
SELECT pii_mask('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq', 'partial');
----
bc1q**********************************5mdq

# CRYPTO_ADDRESS masking - ASTERISK
query I
SELECT length(pii_mask('0x742d35Cc6634C0532925a3b844Bc454e4438f44e', 'asterisk')) = 42;
----
true

# Multiple crypto addresses in one string
query I
SELECT pii_count('BTC: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa, ETH: 0x742d35Cc6634C0532925a3b844Bc454e4438f44e') >= 2;
----
true

# Mixed PII types including crypto
query I
SELECT pii_count('Email: test@test.com, BTC: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa, Card: 4111111111111111') >= 3;
----
true

# Ethereum lowercase (valid)
query I
SELECT pii_detect('0x742d35cc6634c0532925a3b844bc454e4438f44e') LIKE '%CRYPTO_ADDRESS%';
----
true

# Ethereum uppercase (valid)
query I
SELECT pii_detect('0x742D35CC6634C0532925A3B844BC454E4438F44E') LIKE '%CRYPTO_ADDRESS%';
----
true

# Bitcoin address in context
query I
SELECT pii_contains('Please send payment to 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa');
----
true

# ============================================================================
# PII Status Table Function Tests
# ============================================================================

# Returns all 13 PII types
query I
SELECT COUNT(*) = 13 FROM pii_status();
----
true

# Schema validation - check column count
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM pii_status());
----
4

# EMAIL type is listed
query I
SELECT COUNT(*) FROM pii_status() WHERE pii_type = 'EMAIL';
----
1

# CRYPTO_ADDRESS type is listed
query I
SELECT COUNT(*) FROM pii_status() WHERE pii_type = 'CRYPTO_ADDRESS';
----
1

# All recognizers are enabled
query I
SELECT COUNT(*) FROM pii_status() WHERE enabled = false;
----
0

# No empty pattern_info
query I
SELECT COUNT(*) FROM pii_status() WHERE pattern_info IS NULL OR pattern_info = '';
----
0

# Verify specific row - CREDIT_CARD
query III
SELECT pii_type, enabled, recognizer_name FROM pii_status() WHERE pii_type = 'CREDIT_CARD';
----
CREDIT_CARD	true	Credit Card

# ============================================================================
# PII Scan Table Function Tests
# ============================================================================

# Create test table
statement ok
CREATE TABLE pii_test_data (
    id INTEGER,
    email VARCHAR,
    notes VARCHAR,
    phone VARCHAR,
    clean_text VARCHAR
);

statement ok
INSERT INTO pii_test_data VALUES
    (1, 'user@example.com', 'SSN: 123-45-6789', '+1-555-123-4567', 'No PII'),
    (2, 'test@test.com', 'Card: 4111111111111111', '(555) 234-5678', 'Text'),
    (3, 'admin@site.org', NULL, '+44-20-7946-0958', 'Data');

# Returns results
query I
SELECT COUNT(*) > 0 FROM pii_scan_table('pii_test_data');
----
true

# EMAIL detection
query III
SELECT column_name, pii_type, match_count
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'email' AND pii_type = 'EMAIL';
----
email	EMAIL	3

# SSN detection
query III
SELECT column_name, pii_type, match_count
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'notes' AND pii_type = 'US_SSN';
----
notes	US_SSN	1

# Column filter - single column
query I
SELECT COUNT(*) FROM pii_scan_table('pii_test_data', 'email');
----
1

# Multiple column filter
query I
SELECT COUNT(DISTINCT column_name)
FROM pii_scan_table('pii_test_data', 'email,notes');
----
2

# sample_values is array with content
query I
SELECT array_length(sample_values) > 0
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'email';
----
true

# Confidence is 1.0
query I
SELECT confidence FROM pii_scan_table('pii_test_data') WHERE pii_type = 'EMAIL';
----
1.0

# No PII in clean column
query I
SELECT COUNT(*) FROM pii_scan_table('pii_test_data', 'clean_text');
----
0

# Clean up
statement ok
DROP TABLE pii_test_data;