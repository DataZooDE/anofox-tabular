true

# ============================================================================
# Edge Cases
# ============================================================================

# Empty string
query I
SELECT pii_detect('');
----
[]

# String with only whitespace
query I
SELECT pii_detect('   ');
----
[]

# Very long text with PII at the end
query I
SELECT list_contains(list_transform(pii_detect(repeat('x', 1000) || ' email: test@example.com'), x -> x.type), 'EMAIL');
----
true

# ============================================================================
# MAC Address Detection Tests
# ============================================================================

# Colon-separated format
query I
SELECT list_contains(list_transform(pii_detect('Device MAC: 00:1A:2B:3C:4D:5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Hyphen-separated format
query I
SELECT list_contains(list_transform(pii_detect('NIC: 00-1A-2B-3C-4D-5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Dot-separated format (Cisco style)
query I
SELECT list_contains(list_transform(pii_detect('Switch: 001A.2B3C.4D5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# No separator format
query I
SELECT list_contains(list_transform(pii_detect('MAC 001A2B3C4D5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# MAC masking - REDACT
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'redact') LIKE '%[MAC_ADDRESS]%';
----
true

# MAC masking - PARTIAL (shows vendor prefix)
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'partial');
----
MAC: 00:1A:**:**:**:**

# MAC masking - ASTERISK
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'asterisk');
----
MAC: *****************

# ============================================================================
# UK National Insurance Number (NINO) Tests
# ============================================================================

# Standard format without spaces
query I
SELECT list_contains(list_transform(pii_detect('NINO: AB123456C'), x -> x.type), 'UK_NINO');
----
true

# Format with spaces
query I
SELECT list_contains(list_transform(pii_detect('NI Number: AB 12 34 56 C'), x -> x.type), 'UK_NINO');
----
true

# NINO masking - REDACT
query I
SELECT pii_mask('NINO: AB123456C', 'redact') LIKE '%[UK_NINO]%';
----
true

# NINO masking - PARTIAL (shows first 2 and last 1, formatted with spaces)
query I
SELECT pii_mask('NINO: AB123456C', 'partial');
----
NINO: AB ** ** ** C

# Invalid prefix - should not match (D is forbidden as first char)
query I
SELECT list_contains(list_transform(pii_detect('Invalid: DA123456C'), x -> x.type), 'UK_NINO');
----
false

# Invalid prefix - BG is forbidden
query I
SELECT list_contains(list_transform(pii_detect('Invalid: BG123456C'), x -> x.type), 'UK_NINO');
----
false

# ============================================================================
# US Passport Tests
# ============================================================================

# Current format (9 digits)
query I
SELECT list_contains(list_transform(pii_detect('Passport: 123456789'), x -> x.type), 'US_PASSPORT');
----
true

# Legacy format (letter + 8 digits)
query I
SELECT list_contains(list_transform(pii_detect('Passport: A12345678'), x -> x.type), 'US_PASSPORT');
----
true

# US Passport masking - REDACT
query I
SELECT pii_mask('My passport number is A12345678', 'redact') LIKE '%[US_PASSPORT]%';
----
true

# US Passport masking - PARTIAL (check it contains masked passport)
query I
SELECT pii_mask('My passport number is A12345678', 'partial') LIKE '%A********%';
----
true

# Should NOT match 10 digits (too long for passport)
query I
SELECT list_contains(list_transform(pii_detect('Not passport: 1234567890'), x -> x.type), 'US_PASSPORT');
----
false

# ============================================================================
# Phone Number Tests
# ============================================================================

# International format with + prefix
query I
SELECT list_contains(list_transform(pii_detect('Call me at +1-555-123-4567 anytime'), x -> x.type), 'PHONE');
----
true

# UK international format
query I
SELECT list_contains(list_transform(pii_detect('UK: +44 20 7946 0958 today'), x -> x.type), 'PHONE');
----
true

# US format with parentheses
query I
SELECT list_contains(list_transform(pii_detect('Phone: (555) 123-4567'), x -> x.type), 'PHONE');
----
true

# Phone masking - REDACT
query I
SELECT pii_mask('Call +1-555-123-4567 now', 'redact') LIKE '%[PHONE]%';
----
true

# Phone masking - PARTIAL (shows last 4 digits)
query I
SELECT pii_mask('Phone: (555) 123-4567', 'partial');
----
Phone: ***-***-4567

# SSN should NOT be detected as phone
query I
SELECT list_contains(list_transform(pii_detect('SSN: 123-45-6789'), x -> x.type), 'PHONE');
----
false

# ============================================================================
# API Key Tests
# ============================================================================

# AWS Access Key ID
query I
SELECT list_contains(list_transform(pii_detect('Key: AKIAIOSFODNN7EXAMPLE'), x -> x.type), 'API_KEY');
----
true

# GitHub Personal Access Token
query I
SELECT list_contains(list_transform(pii_detect('Token: ghp_1234567890abcdefghijklmnopqrstuvwxyz'), x -> x.type), 'API_KEY');
----
true

# GitHub OAuth Token
query I
SELECT list_contains(list_transform(pii_detect('OAuth: gho_abcdefghijklmnopqrstuvwxyz012345'), x -> x.type), 'API_KEY');
----
true

# API Key masking - REDACT
query I
SELECT pii_mask('Key: AKIAIOSFODNN7EXAMPLE', 'redact') LIKE '%[API_KEY]%';
----
true

# API Key masking - PARTIAL (AWS shows AKIA prefix)
query I
SELECT pii_mask('Key: AKIAIOSFODNN7EXAMPLE', 'partial');
----
Key: AKIA****************

# Low entropy string should NOT match (repetitive)
query I
SELECT list_contains(list_transform(pii_detect('Not a key: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'), x -> x.type), 'API_KEY');
----
false

# ============================================================================
# Multiple New PII Types in One String
# ============================================================================

# Multiple new types detected
query I
SELECT list_contains(list_transform(pii_detect('MAC: 00:1A:2B:3C:4D:5E, Call +44-20-7946-0958 now'), x -> x.type), 'MAC_ADDRESS')
   AND list_contains(list_transform(pii_detect('MAC: 00:1A:2B:3C:4D:5E, Call +44-20-7946-0958 now'), x -> x.type), 'PHONE');
----
true

# Mixed old and new types
query I
SELECT pii_count('Email: test@test.com, MAC: 00:1A:2B:3C:4D:5E, SSN: 123-45-6789');
----
3

# ============================================================================
# Cryptocurrency Address Tests
# ============================================================================

# Bitcoin legacy (P2PKH) - Genesis block address
query I
SELECT list_contains(list_transform(pii_detect('Wallet: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Bitcoin P2SH
query I
SELECT list_contains(list_transform(pii_detect('Send: 3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Bitcoin SegWit (bech32)
query I
SELECT list_contains(list_transform(pii_detect('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Ethereum address
query I
SELECT list_contains(list_transform(pii_detect('0x742d35Cc6634C0532925a3b844Bc454e4438f44e'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Invalid Bitcoin checksum (last char changed)
query I
SELECT list_contains(list_transform(pii_detect('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb'), x -> x.type), 'CRYPTO_ADDRESS');
----
false

# Invalid Ethereum (wrong length - too short)
query I
SELECT list_contains(list_transform(pii_detect('0x742d35Cc6634'), x -> x.type), 'CRYPTO_ADDRESS');
----
false

# CRYPTO_ADDRESS masking - REDACT
query I
SELECT pii_mask('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa', 'redact') LIKE '%[CRYPTO_ADDRESS]%';
----
true

# CRYPTO_ADDRESS masking - PARTIAL (first 4 + last 4)
query I
SELECT pii_mask('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq', 'partial');
----
bc1q**********************************5mdq

# CRYPTO_ADDRESS masking - ASTERISK
query I
SELECT length(pii_mask('0x742d35Cc6634C0532925a3b844Bc454e4438f44e', 'asterisk')) = 42;
----
true

# Multiple crypto addresses in one string
query I
SELECT pii_count('BTC: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa, ETH: 0x742d35Cc6634C0532925a3b844Bc454e4438f44e') >= 2;
----
true

# Mixed PII types including crypto
query I
SELECT pii_count('Email: test@test.com, BTC: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa, Card: 4111111111111111') >= 3;
----
true

# Ethereum lowercase (valid)
query I
SELECT list_contains(list_transform(pii_detect('0x742d35cc6634c0532925a3b844bc454e4438f44e'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Ethereum uppercase (valid)
query I
SELECT list_contains(list_transform(pii_detect('0x742D35CC6634C0532925A3B844BC454E4438F44E'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Bitcoin address in context
query I
SELECT pii_contains('Please send payment to 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa');
----
true

# ============================================================================
# PII Status Table Function Tests
# ============================================================================

# Returns all 17 PII types (14 original + ORGANIZATION, LOCATION, MISC)
query I
SELECT COUNT(*) = 17 FROM pii_status();
----
true

# Schema validation - check column count
query I
SELECT COUNT(*) FROM (DESCRIBE SELECT * FROM pii_status());
----
4

# EMAIL type is listed
query I
SELECT COUNT(*) FROM pii_status() WHERE pii_type = 'EMAIL';
----
1

# CRYPTO_ADDRESS type is listed
query I
SELECT COUNT(*) FROM pii_status() WHERE pii_type = 'CRYPTO_ADDRESS';
----
1

# All recognizers are enabled
query I
SELECT COUNT(*) FROM pii_status() WHERE enabled = false;
----
0

# No empty pattern_info
query I
SELECT COUNT(*) FROM pii_status() WHERE pattern_info IS NULL OR pattern_info = '';
----
0

# Verify specific row - CREDIT_CARD
query III
SELECT pii_type, enabled, recognizer_name FROM pii_status() WHERE pii_type = 'CREDIT_CARD';
----
CREDIT_CARD	true	Credit Card

# ============================================================================
# PII Scan Table Function Tests
# ============================================================================

# Create test table
statement ok
CREATE TABLE pii_test_data (
    id INTEGER,
    email VARCHAR,
    notes VARCHAR,
    phone VARCHAR,
    clean_text VARCHAR
);

statement ok
INSERT INTO pii_test_data VALUES
    (1, 'user@example.com', 'SSN: 123-45-6789', '+1-555-123-4567', 'clean text'),
    (2, 'test@test.com', 'Card: 4111111111111111', '(555) 234-5678', 'safe text'),
    (3, 'admin@site.org', NULL, '+44-20-7946-0958', 'other text');

# Returns results
query I
SELECT COUNT(*) > 0 FROM pii_scan_table('pii_test_data');
----
true

# EMAIL detection
query III
SELECT column_name, pii_type, match_count
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'email' AND pii_type = 'EMAIL';
----
email	EMAIL	3

# SSN detection
query III
SELECT column_name, pii_type, match_count
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'notes' AND pii_type = 'US_SSN';
----
notes	US_SSN	1

# Column filter - single column
query I
SELECT COUNT(*) FROM pii_scan_table('pii_test_data', 'email');
----
1

# Multiple column filter
query I
SELECT COUNT(DISTINCT column_name)
FROM pii_scan_table('pii_test_data', 'email,notes');
----
2

# sample_values is array with content
query I
SELECT array_length(sample_values) > 0
FROM pii_scan_table('pii_test_data')
WHERE column_name = 'email';
----
true

# Confidence is 1.0
query I
SELECT confidence FROM pii_scan_table('pii_test_data') WHERE pii_type = 'EMAIL';
----
1.0

# No PII in clean column
query I
SELECT COUNT(*) FROM pii_scan_table('pii_test_data', 'clean_text');
----
0

# Clean up
statement ok
DROP TABLE pii_test_data;

# ============================================================================
# Person Name Detection Tests
# ============================================================================

# Basic name detection - single name
query I
SELECT list_contains(list_transform(pii_detect('Hello John'), x -> x.type), 'NAME');
----
true

# Basic name detection - full name
query I
SELECT list_contains(list_transform(pii_detect('Hello John Smith'), x -> x.type), 'NAME');
----
true

# Multiple names
query I
SELECT pii_count('John Smith and Mary Johnson visited today') >= 2;
----
true

# Single name - Sarah
query I
SELECT list_contains(list_transform(pii_detect('Contact: Sarah'), x -> x.type), 'NAME');
----
true

# Full name (3 parts) - common name
query I
SELECT list_contains(list_transform(pii_detect('Dr. Michael James Brown'), x -> x.type), 'NAME');
----
true

# No false positives - common words (not capitalized as first name would be)
query I
SELECT len(pii_detect('the quick brown fox jumps')) = 0;
----
true

# All caps text - NER model may produce fragmented results (model limitation)
# Skip this test as NER behavior on all-caps is model-dependent

# Name in context
query I
SELECT pii_contains('Employee John Doe submitted the report');
----
true

# Mixed PII types - name with email
query I
SELECT pii_count('John Smith (john@example.com)') >= 2;
----
true

# ============================================================================
# Name Masking Tests
# ============================================================================

# REDACT masking
query I
SELECT pii_mask('Contact John Smith', 'redact') LIKE '%[NAME]%';
----
true

# PARTIAL masking (first letter + asterisks)
query I
SELECT pii_mask('Hello Mary Johnson', 'partial') LIKE '%M*** J******%';
----
true

# ASTERISK masking
query I
SELECT pii_mask('Hello David Williams', 'asterisk') LIKE '%*****%';
----
true

# HASH masking (length > 0)
query I
SELECT length(pii_mask('Bob Jones', 'hash')) > 0;
----
true

# ============================================================================
# Dictionary Fallback Tests
# ============================================================================

# Common first name (dictionary hit) - John
query I
SELECT list_contains(list_transform(pii_detect('Contact John for details'), x -> x.type), 'NAME');
----
true

# Common first name (dictionary hit) - Elizabeth
query I
SELECT list_contains(list_transform(pii_detect('Ask Elizabeth'), x -> x.type), 'NAME');
----
true

# Uncommon name - NER model correctly detects proper noun as a name
# (Xibalba is a Mayan mythological term that the model identifies as a name)
query I
SELECT list_contains(list_transform(pii_detect('Xibalba visited'), x -> x.type), 'NAME');
----
true

# Common name in sentence
query I
SELECT pii_contains('I met William yesterday');
----
true

# ============================================================================
# Status Functions for NAME
# ============================================================================

# NAME type in status
query I
SELECT COUNT(*) FROM pii_status() WHERE pii_type = 'NAME';
