statement ok
CREATE TABLE business_data (
    id INTEGER,
    description VARCHAR
);

statement ok
INSERT INTO business_data VALUES
    (1, 'John works at Microsoft'),
    (2, 'Sarah moved to London'),
    (3, 'Bob studies French');

