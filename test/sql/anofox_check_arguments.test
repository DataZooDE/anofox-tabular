----
rel_count_change: date_column must not be empty

statement error
SELECT * FROM freshness('support_tickets', '', INTERVAL '1 day')
----
freshness: timestamp_column must not be empty

# ===--------------------------------------------------------------------===
# Relations the catalog does not know still work: TEMP tables, views, files
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE open_tickets AS SELECT * FROM support_tickets WHERE status <> 'resolved'

query TII
SELECT status, null_count, total_count FROM null_rate('open_tickets', 'resolution_hours', 1.0)
----
pass	2	3

statement error
SELECT * FROM null_rate('open_tickets', 'resolution', 1.0)
----
null_rate: column 'resolution' not found in table 'open_tickets'

statement ok
CREATE VIEW high_priority AS SELECT ticket_id, priority FROM support_tickets WHERE priority IN ('high', 'urgent')

query TI
SELECT status, row_count FROM volume('high_priority', 1, NULL)
----
pass	3

statement error
SELECT * FROM distinct_count('high_priority', 'status', 1, NULL)
----
distinct_count: column 'status' not found in table 'high_priority' (available columns: ticket_id, priority)

statement ok
COPY support_tickets TO '__TEST_DIR__/support_tickets.csv' (HEADER)

query TI
SELECT status, row_count FROM volume('__TEST_DIR__/support_tickets.csv', 6, 6)
----
pass	6

statement error
SELECT * FROM null_rate('__TEST_DIR__/support_tickets.csv', 'customer', 0.1)
----
null_rate: column 'customer' not found in table

statement error
SELECT * FROM volume('__TEST_DIR__/no_such_file.csv', 1, NULL)
----
volume: cannot read table
