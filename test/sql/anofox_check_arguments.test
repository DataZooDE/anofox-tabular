# name: test/sql/anofox_check_arguments.test
# description: Every direct check validates its arguments when the query is bound: a NULL
#              required threshold or list raises "<fn>: <arg> must not be NULL" (optional
#              arguments keep their documented NULL = default rule), and an unknown table, an
#              unknown column or an empty name raises a check-specific error instead of a raw
#              binder/catalog error leaking the generated SQL.
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# ===--------------------------------------------------------------------===
# A support desk: tickets and the customers they belong to
# ===--------------------------------------------------------------------===

statement ok
CREATE TABLE support_tickets (ticket_id INTEGER, customer_id INTEGER, priority VARCHAR, status VARCHAR,
                              channel VARCHAR, opened_at TIMESTAMP, opened_on DATE, resolution_hours DOUBLE)

statement ok
INSERT INTO support_tickets VALUES
    (9001, 501, 'high',   'resolved', 'email', TIMESTAMP '2026-10-20 08:15:00', DATE '2026-10-20',  4.5),
    (9002, 502, 'low',    'resolved', 'phone', TIMESTAMP '2026-10-20 09:40:00', DATE '2026-10-20', 26.0),
    (9003, 503, 'medium', 'open',     'chat',  TIMESTAMP '2026-10-21 11:05:00', DATE '2026-10-21', NULL),
    (9004, 501, 'high',   'pending',  'email', TIMESTAMP '2026-10-22 14:30:00', DATE '2026-10-22',  8.0),
    (9005, 504, 'urgent', 'resolved', 'phone', TIMESTAMP '2026-10-23 07:55:00', DATE '2026-10-23',  1.5),
    (9006, NULL, 'low',   'open',     'web',   TIMESTAMP '2026-10-23 16:20:00', DATE '2026-10-23', NULL)

statement ok
CREATE TABLE support_customers (customer_id INTEGER, company VARCHAR, tier VARCHAR)

statement ok
INSERT INTO support_customers VALUES (501, 'Brauhaus Mueller GmbH', 'gold'), (502, 'Nordlicht AG', 'silver'),
    (503, 'Kaffeerösterei Kranz', 'bronze'), (504, 'Elbtal Logistik KG', 'gold')

# The direct check functions covered by this file. A new check function (categories 'metric'
# and 'data-quality') fails this query until its argument validation is tested here.
query T
SELECT DISTINCT function_name FROM duckdb_functions()
WHERE function_name LIKE 'anofox_tab_%' AND list_contains(categories, 'metric')
  AND list_contains(categories, 'data-quality')
  AND function_name <> 'anofox_tab_run_checks'
ORDER BY 1
----
anofox_tab_agg_check
anofox_tab_compliance
anofox_tab_distinct_count
anofox_tab_duplicate_count
anofox_tab_freshness
anofox_tab_iqr
anofox_tab_match_rate
anofox_tab_metric_anomaly_iqr
anofox_tab_metric_anomaly_iqr_events
anofox_tab_null_rate
anofox_tab_occurrence
anofox_tab_regex_match
anofox_tab_rel_count_change
anofox_tab_rel_count_change_events
anofox_tab_rolling_values_in_set
anofox_tab_rolling_values_in_set_events
anofox_tab_schema_check
anofox_tab_values_in_set
anofox_tab_volume
anofox_tab_zscore

# ===--------------------------------------------------------------------===
# F4: NULL required thresholds and lists
# ===--------------------------------------------------------------------===

statement error
SELECT * FROM null_rate('support_tickets', 'customer_id', NULL)
----
null_rate: max_null_rate must not be NULL

statement error
SELECT * FROM schema_check('support_tickets', NULL)
----
schema_check: required_columns must not be NULL

statement error
SELECT * FROM freshness('support_tickets', 'opened_at', NULL)
----
freshness: max_age must not be NULL

statement error
SELECT * FROM freshness('support_tickets', 'opened_at', NULL, TIMESTAMP '2026-10-24 06:00:00')
----
freshness: max_age must not be NULL

statement error
SELECT * FROM zscore('support_tickets', 'resolution_hours', NULL)
----
zscore: threshold must not be NULL

statement error
SELECT * FROM iqr('support_tickets', 'resolution_hours', NULL)
----
iqr: iqr_multiplier must not be NULL

statement error
SELECT * FROM agg_check('support_tickets', 'resolution_hours', NULL, 0, 24)
----
agg_check: agg must not be NULL

statement error
SELECT * FROM occurrence('support_tickets', 'priority', NULL, NULL, 3)
----
occurrence: mode must not be NULL

statement error
SELECT * FROM values_in_set('support_tickets', 'status', NULL)
----
values_in_set: allowed_values must not be NULL

statement error
SELECT * FROM rolling_values_in_set('support_tickets', 'status', NULL, 'opened_on')
----
rolling_values_in_set: allowed_values must not be NULL

statement error
SELECT * FROM rolling_values_in_set_events('support_tickets', 'status', NULL, 'opened_on')
----
rolling_values_in_set_events: allowed_values must not be NULL

statement error
SELECT * FROM regex_match('support_tickets', 'channel', NULL, 0.5)
----
regex_match: pattern must not be NULL

statement error
SELECT * FROM compliance('support_tickets', NULL)
----
compliance: expression must not be NULL

statement error
SELECT * FROM match_rate('support_tickets', 'support_customers', 'customer_id', NULL)
----
match_rate: right_keys must not be NULL

statement error
SELECT * FROM duplicate_count('support_tickets', NULL)
----
duplicate_count: column_names must not be NULL

statement error
SELECT * FROM rel_count_change('support_tickets', NULL)
----
rel_count_change: date_column must not be NULL

statement error
SELECT * FROM metric_anomaly_iqr_events('support_tickets', NULL)
----
metric_anomaly_iqr_events: date_column must not be NULL

# A prepared statement with a NULL parameter is the same error
statement ok
PREPARE nr AS SELECT status FROM null_rate('support_tickets', 'customer_id', $1)

statement error
EXECUTE nr(NULL)
----
null_rate: max_null_rate must not be NULL

query T
EXECUTE nr(0.2)
----
pass

# Optional arguments keep their NULL = default/unbounded rule
query TT
SELECT status, message FROM volume('support_tickets', NULL, NULL)
----
pass	Row count 6 is within acceptable range

query TR
SELECT status, threshold FROM values_in_set('support_tickets', 'channel', ['email', 'phone', 'chat', 'web'], NULL)
----
pass	1.0

query TI
SELECT status, threshold FROM duplicate_count('support_tickets', 'ticket_id', NULL)
----
pass	0

# (ticket 9006 has no customer: a NULL key is left out of the rate, the other 5 all match)
query TR
SELECT status, threshold FROM match_rate('support_tickets', 'support_customers', 'customer_id', 'customer_id', NULL)
----
pass	1.0

query TR
SELECT status, threshold FROM compliance('support_tickets', 'ticket_id > 9000', NULL)
----
pass	1.0

statement ok
SELECT status, message FROM freshness('support_tickets', 'opened_at', INTERVAL '1 day', NULL)

