----
null_rate: table_name must not be empty

statement error
SELECT * FROM volume('  ', 1, NULL)
----
volume: table_name must not be empty

statement error
SELECT * FROM null_rate('support_tickets', '', 0.1)
----
null_rate: column_name must not be empty

statement error
SELECT * FROM match_rate('support_tickets', '', 'customer_id', 'customer_id')
----
match_rate: right_table must not be empty

statement error
