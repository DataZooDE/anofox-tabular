# name: test/sql/anofox_phonenumber_format.test
# description: per-region number formats (NATIONAL / INTERNATIONAL / RFC3966) and round trips
# group: [phonenumber]

require anofox_tabular

statement ok
LOAD anofox_tabular;

statement ok
SET anofox_tab_phonenumber_default_region='US';

# Every region's example number formats with the region's own grouping, as libphonenumber does
query TTT
SELECT r,
       phonenumber_format(phonenumber_example(r), r, 'NATIONAL'),
       phonenumber_format(phonenumber_example(r), r, 'INTERNATIONAL')
FROM (VALUES ('AR'),('AU'),('BR'),('CA'),('CH'),('CN'),('DE'),('DK'),('ES'),('FI'),('FR'),
             ('GB'),('IN'),('IT'),('JP'),('MX'),('NL'),('NO'),('RU'),('SE'),('US')) v(r)
ORDER BY r;
----
AR	011 2345-6789	+54 11 2345-6789
AU	02 1234 5678	+61 2 1234 5678
BR	(11) 2345-6789	+55 11 2345-6789
CA	(506) 234-5678	+1 506 234 5678
CH	021 234 56 78	+41 21 234 56 78
CN	010 1234 5678	+86 10 1234 5678
DE	030 12345678	+49 30 12345678
DK	32 12 34 56	+45 32 12 34 56
ES	912 34 56 78	+34 912 34 56 78
FI	09 12345678	+358 9 12345678
FR	01 23 45 67 89	+33 1 23 45 67 89
GB	0121 234 5678	+44 121 234 5678
IN	022 1234 5678	+91 22 1234 5678
IT	02 1234 5678	+39 02 1234 5678
JP	03-1234-5678	+81 3-1234-5678
MX	55 1234 5678	+52 55 1234 5678
NL	020 123 4567	+31 20 123 4567
NO	21 23 45 67	+47 21 23 45 67
RU	8 (495) 123-45-67	+7 495 123-45-67
SE	08-123 456 78	+46 8 123 456 78
US	(201) 555-0123	+1 201 555 0123

# RFC3966 uses the international grouping with '-' separators
query TT
SELECT r, phonenumber_format(phonenumber_example(r), r, 'RFC3966')
FROM (VALUES ('DE'),('FR'),('GB'),('JP'),('RU'),('SE'),('US')) v(r)
ORDER BY r;
----
DE	tel:+49-30-12345678
FR	tel:+33-1-23-45-67-89
GB	tel:+44-121-234-5678
JP	tel:+81-3-1234-5678
RU	tel:+7-495-123-45-67
SE	tel:+46-8-123-456-78
US	tel:+1-201-555-0123

# Common fixed-line and mobile layouts
query TTTT
SELECT n, r, phonenumber_format(n, r, 'NATIONAL'), phonenumber_format(n, r, 'INTERNATIONAL')
FROM (VALUES (1, '030 12345678', 'DE'),
             (2, '0171 1234567', 'DE'),
             (3, '01512 3456789', 'DE'),
             (4, '089 123456', 'DE'),
             (5, '0511 1234567', 'DE'),
             (6, '07400 123456', 'GB'),
             (7, '020 7946 0018', 'GB'),
             (8, '01 23 45 67 89', 'FR'),
             (9, '06 12 34 56 78', 'FR'),
             (10, '044 668 18 00', 'CH'),
             (11, '079 123 45 67', 'CH'),
             (12, '020 123 4567', 'NL'),
             (13, '06 12345678', 'NL'),
             (14, '0412 345 678', 'AU'),
             (15, '090-1234-5678', 'JP'),
             (16, '138 0013 8000', 'CN'),
             (17, '98765 43210', 'IN'),
             (18, '(11) 91234-5678', 'BR'),
             (19, '312 345 6789', 'IT'),
             (20, '612 34 56 78', 'ES'),
             (21, '070-123 45 67', 'SE'),
             (22, '412 34 567', 'NO'),
             (23, '040 1234567', 'FI')) v(id, n, r)
ORDER BY id;
----
030 12345678	DE	030 12345678	+49 30 12345678
0171 1234567	DE	0171 1234567	+49 171 1234567
01512 3456789	DE	01512 3456789	+49 1512 3456789
089 123456	DE	089 123456	+49 89 123456
0511 1234567	DE	0511 1234567	+49 511 1234567
07400 123456	GB	07400 123456	+44 7400 123456
020 7946 0018	GB	020 7946 0018	+44 20 7946 0018
01 23 45 67 89	FR	01 23 45 67 89	+33 1 23 45 67 89
06 12 34 56 78	FR	06 12 34 56 78	+33 6 12 34 56 78
044 668 18 00	CH	044 668 18 00	+41 44 668 18 00
079 123 45 67	CH	079 123 45 67	+41 79 123 45 67
020 123 4567	NL	020 123 4567	+31 20 123 4567
06 12345678	NL	06 12345678	+31 6 12345678
0412 345 678	AU	0412 345 678	+61 412 345 678
090-1234-5678	JP	090-1234-5678	+81 90-1234-5678
138 0013 8000	CN	138 0013 8000	+86 138 0013 8000
98765 43210	IN	098765 43210	+91 98765 43210
(11) 91234-5678	BR	(11) 91234-5678	+55 11 91234-5678
312 345 6789	IT	312 345 6789	+39 312 345 6789
612 34 56 78	ES	612 34 56 78	+34 612 34 56 78
070-123 45 67	SE	070-123 45 67	+46 70 123 45 67
412 34 567	NO	412 34 567	+47 412 34 567
040 1234567	FI	040 1234567	+358 40 1234567

query T
SELECT phonenumber_format('030 12345678', 'DE', 'RFC3966');
----
tel:+49-30-12345678

# E164 is unchanged by the format rules
query T
SELECT phonenumber_format('030 12345678', 'DE', 'E164');
----
+493012345678

# US/CA output stays as before
query TTTT
SELECT phonenumber_format('6502530000', 'US', 'NATIONAL'),
       phonenumber_format('6502530000', 'US', 'INTERNATIONAL'),
       phonenumber_format('6502530000', 'US', 'RFC3966'),
       phonenumber_format('+1 506 234 5678', 'CA', 'NATIONAL');
----
(650) 253-0000	+1 650 253 0000	tel:+1-650-253-0000	(506) 234-5678

# Round trip: parsing the NATIONAL (with the region) and INTERNATIONAL (without a region)
# output of every region's example number gives back the same E164 number
query I
SELECT list(r ORDER BY r) FROM (VALUES ('AR'),('AU'),('BR'),('CA'),('CH'),('CN'),('DE'),('DK'),('ES'),('FI'),('FR'),
             ('GB'),('IN'),('IT'),('JP'),('MX'),('NL'),('NO'),('RU'),('SE'),('US')) v(r)
WHERE phonenumber_format(phonenumber_format(phonenumber_example(r), r, 'NATIONAL'), r, 'E164')
          IS DISTINCT FROM phonenumber_example(r)
   OR phonenumber_format(phonenumber_format(phonenumber_example(r), r, 'INTERNATIONAL'), r, 'E164')
          IS DISTINCT FROM phonenumber_example(r)
   OR phonenumber_format(phonenumber_format(phonenumber_example(r), r, 'INTERNATIONAL'), NULL, 'E164')
          IS DISTINCT FROM phonenumber_example(r)
   OR phonenumber_format(phonenumber_format(phonenumber_example(r), r, 'RFC3966'), NULL, 'E164')
          IS DISTINCT FROM phonenumber_example(r)
   OR NOT phonenumber_is_valid(phonenumber_format(phonenumber_example(r), r, 'NATIONAL'), r);
----
NULL
