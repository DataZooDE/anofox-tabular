require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# ===--------------------------------------------------------------------===
# Metric Framework Test - Actual Metric Function Tests
# This test verifies that all 7 metric functions are properly registered and working
# ===--------------------------------------------------------------------===

# ===--------------------------------------------------------------------===
# Test Setup: Create test tables
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE test_orders (
    order_id INTEGER,
    customer_id INTEGER,
    amount DECIMAL(10,2),
    status VARCHAR,
    created_at TIMESTAMP
)

statement ok
INSERT INTO test_orders VALUES
    (1, 100, 99.99, 'completed', TIMESTAMP '2025-10-19 10:00:00'),
    (2, 101, 149.99, 'pending', TIMESTAMP '2025-10-19 10:30:00'),
    (3, 102, 299.99, 'completed', TIMESTAMP '2025-10-19 11:00:00'),
    (4, 103, 49.99, 'failed', TIMESTAMP '2025-10-19 11:30:00'),
    (5, 104, 199.99, 'completed', TIMESTAMP '2025-10-19 12:00:00')

statement ok
CREATE TEMP TABLE test_nulls (
    id INTEGER,
    email VARCHAR,
    age INTEGER
)

statement ok
INSERT INTO test_nulls VALUES
    (1, 'alice@example.com', 25),
    (2, NULL, 30),
    (3, 'charlie@example.com', NULL),
    (4, NULL, 35),
    (5, 'eve@example.com', 28)

statement ok
CREATE TEMP TABLE test_numeric (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO test_numeric VALUES
    (1, 100.0),
    (2, 105.0),
    (3, 102.0),
    (4, 101.0),
    (5, 103.0),
    (6, 500.0)

# ===--------------------------------------------------------------------===
# Volume Metrics - volume() function
# ===--------------------------------------------------------------------===

# Test 1: Volume metric - should pass (5 rows within 5-10 range)
query T
SELECT status FROM volume('test_orders', 5, 10)
----
pass

# Test 2: Volume metric - should fail (5 rows exceeds max of 4)
query T
SELECT status FROM volume('test_orders', 1, 4)
----
fail

# Test 3: Volume metric - should pass (5 rows above minimum of 3)
query T
SELECT status FROM volume('test_orders', 3, NULL)
----
pass

# Test 4: Check row_count is correctly reported
query I
SELECT row_count FROM volume('test_orders', 1, 100)
----
5

# ===--------------------------------------------------------------------===
# Null Rate Metrics - null_rate() function
# ===--------------------------------------------------------------------===

# Test 1: Null rate - should pass (40% nulls <= 50% threshold)
query T
SELECT status FROM null_rate('test_nulls', 'email', 0.5)
----
pass

# Test 2: Null rate - should fail (40% nulls > 10% threshold)
query T
SELECT status FROM null_rate('test_nulls', 'email', 0.1)
----
fail

# Test 3: Check null_rate is correctly reported
query R
SELECT null_rate FROM null_rate('test_nulls', 'email', 1.0)
----
0.400000

# ===--------------------------------------------------------------------===
# Distinct Count Metrics - distinct_count() function
# ===--------------------------------------------------------------------===

# Test 1: Distinct count - should pass (3 distinct statuses >= 3)
query T
SELECT status FROM distinct_count('test_orders', 'status', 3, NULL)
----
pass

# Test 2: Distinct count - should fail (3 distinct statuses < 5)
query T
SELECT status FROM distinct_count('test_orders', 'status', 1, 2)
----
fail

# Test 3: Check distinct_count is correctly reported
query I
SELECT distinct_count FROM distinct_count('test_orders', 'status', 1, 100)
----
3

# ===--------------------------------------------------------------------===
# Z-Score and IQR Anomaly Detection - Fixed with CTEs
# ===--------------------------------------------------------------------===
# Z-score and IQR functions now use CTEs internally to avoid nested aggregate errors.
# They can now be called directly as table functions.

# Test 1: Z-Score metric - should fail (one outlier detected at 2 std devs)
query T
SELECT status FROM zscore('test_numeric', 'value', 2)
----
fail

# Test 2: Z-Score metric - should pass (one outlier but threshold is 3 std devs)
query T
SELECT status FROM zscore('test_numeric', 'value', 3)
----
pass

# Test 3: Check z-score mean is correctly reported
query R
SELECT mean FROM zscore('test_numeric', 'value', 2)
----
168.5

# Test 4: Check z-score outlier_count is correctly reported
query I
SELECT outlier_count FROM zscore('test_numeric', 'value', 2)
----
1

# Test 5: IQR metric - should fail (one outlier detected outside bounds)
query T
SELECT status FROM iqr('test_numeric', 'value', 1.5)
----
fail

# Test 6: IQR metric - should pass (no outliers in smaller dataset)
query T
SELECT status FROM iqr('test_nulls', 'age', 1.5)
----
pass

# Test 7: Check IQR q1 is correctly reported
query R
SELECT q1 FROM iqr('test_numeric', 'value', 1.5)
----
101.25

# Test 8: Check IQR q3 is correctly reported
query R
SELECT q3 FROM iqr('test_numeric', 'value', 1.5)
----
104.5

# Test 9: Check IQR outlier_count is correctly reported
query I
SELECT outlier_count FROM iqr('test_numeric', 'value', 1.5)
----
1

# ===--------------------------------------------------------------------===
# Freshness Metrics - freshness() function
# ===--------------------------------------------------------------------===

# Test 1: Freshness - should pass (data is fresh - 1 hour old <= 1 hour threshold)
query T
SELECT status FROM freshness('test_orders', 'created_at', INTERVAL '1 hour', TIMESTAMP '2025-10-19 13:00:00')
----
pass

# Test 2: Freshness - should fail (data is stale - 1 hour old > 1 minute threshold)
query T
SELECT status FROM freshness('test_orders', 'created_at', INTERVAL '1 minute', TIMESTAMP '2025-10-19 13:00:00')
----
fail

# Test 3: Check metric_value (latest timestamp) is correctly reported
query T
SELECT metric_value FROM freshness('test_orders', 'created_at', INTERVAL '1 day', TIMESTAMP '2025-10-19 13:00:00')
----
2025-10-19 12:00:00

# ===--------------------------------------------------------------------===
# Edge Cases
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE test_empty (id INTEGER, value INTEGER)

# Test 1: Volume metric on empty table - should fail (0 rows < min of 1)
query T
SELECT status FROM volume('test_empty', 1, 100)
----
fail

# ===--------------------------------------------------------------------===
# Schema Metrics - schema_check() function
# ===--------------------------------------------------------------------===

# Test 1: Schema validation - should pass (both columns exist)
query T
SELECT status FROM schema_check('test_orders', ['order_id', 'customer_id'])
----
pass

# Test 2: Schema validation - should fail (missing column)
query T
SELECT status FROM schema_check('test_orders', ['order_id', 'nonexistent_column'])
----
fail

# ===--------------------------------------------------------------------===
# Regression: schema-qualified tables, quoted identifiers, and safe failures
# ===--------------------------------------------------------------------===

statement ok
CREATE SCHEMA metric_schema

statement ok
CREATE TABLE metric_schema.events (
    id INTEGER,
    "a""b" INTEGER,
    created_at TIMESTAMP
)

statement ok
INSERT INTO metric_schema.events VALUES
    (1, 10, TIMESTAMP '2025-10-19 10:00:00'),
    (2, NULL, TIMESTAMP '2025-10-19 11:00:00'),
    (3, 30, TIMESTAMP '2025-10-19 12:00:00')

# same table name in main schema (different shape) must not affect schema_check
statement ok
CREATE TABLE events (
    wrong_col INTEGER
)

# schema_check must resolve relation columns via the target relation
query T
SELECT status FROM schema_check('metric_schema.events', ['id', 'a"b', 'created_at'])
----
pass

# quoted column name containing double quote must be escaped in generated SQL
query T
SELECT status FROM null_rate('metric_schema.events', 'a"b', 0.5)
----
pass

# freshness should work against schema-qualified relation
query T
SELECT status FROM freshness('metric_schema.events', 'created_at', INTERVAL '1 hour', TIMESTAMP '2025-10-19 13:00:00')
----
pass

# injection-shaped table argument should fail safely and not execute appended SQL
statement error
SELECT status FROM volume('metric_schema.events''); DROP TABLE events; --', 1, 10)
----
does not exist

query I
SELECT COUNT(*) FROM events
----
0
