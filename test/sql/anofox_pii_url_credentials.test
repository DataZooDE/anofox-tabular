# name: test/sql/anofox_pii_url_credentials.test
# description: Credentials in the userinfo of a URL ("https://user:password@host/") never leak:
#              an email-shaped "password@host" is the userinfo of the URL, not an email address,
#              so the whole URL is one URL match and neither user name nor password stays readable
#              (A-F1). An address in the path or query still yields the URL to the EMAIL match.
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

# Pattern types only, so the results do not depend on the NER model
statement ok
SET anofox_pii_enabled_types = 'EMAIL,PHONE,IBAN,IP_ADDRESS,URL';

statement ok
CREATE MACRO found(t) AS array_to_string(list_transform(pii_detect(t), lambda m: m.type || ':' || m.text), ' ; ');

# The reported case: user name and password both disappear
query T
SELECT pii_mask('https://john.smith:pass123@claims.example.com/case');
----
[URL]

query T
SELECT found('https://john.smith:pass123@claims.example.com/case');
----
URL:https://john.smith:pass123@claims.example.com/case

query T
SELECT pii_mask('https://user:pw@host.example.com/p');
----
[URL]

query T
SELECT pii_mask('https://user@host.example.com/p');
----
[URL]

# FTP URLs carry credentials just as often (a trailing '/' is no part of a URL match)
query T
SELECT found('ftp://admin:secret@files.example.org/');
----
URL:ftp://admin:secret@files.example.org

query T
SELECT pii_mask('ftp://admin:secret@files.example.org/');
----
[URL]/

query T
SELECT pii_mask('sftp mirror: ftps://mirror:Herbst2026@ftp.example.de/pub/', 'partial');
----
sftp mirror: ftps://*********************.*******.de/***/

# The partial mask of a credentialed URL hides user name and password with the host labels
query T
SELECT pii_mask('https://john.smith:pass123@claims.example.com/case', 'partial');
----
https://****.********************.*******.com/***

# Credentials and an address in the query: the URL stays one match, the credentials do not leak
query T
SELECT pii_mask('https://svc:pw@api.example.com:8443/notify?to=lena.schmidt@t-online.de');
----
[URL]

# Round-5 rule unchanged: an address in the query or path yields the URL to the EMAIL
query T
SELECT pii_mask('https://h.example.com/p?email=a@b.de');
----
https://h.example.com/p?email=[EMAIL]

query T
SELECT found('https://h.example.com/p?email=a@b.de');
----
EMAIL:a@b.de

query T
SELECT pii_mask('mailto:anna@corp.com');
----
mailto:[EMAIL]

# Realistic application and proxy logs
statement ok
CREATE TABLE app_log AS SELECT * FROM (VALUES
    (1, '2026-10-27T08:12:44Z ERROR backup: upload to https://svc_backup:Winter2026@backup.example.net/api/v2/upload failed (503)'),
    (2, '2026-10-27T08:13:02Z WARN  sync: retrying ftp://exporter:Kd8-pL2x@files.partner-logistik.de/outbound/orders.csv'),
    (3, '2026-10-27T08:14:10Z INFO  git: cloned https://deploy@git.example.com/claims/portal.git'),
    (4, '2026-10-27T08:15:55Z INFO  mail: unsubscribe https://shop.example.com/unsubscribe?email=max.mustermann@web.de&id=7'),
    (5, '2026-10-27T08:16:30Z INFO  crm: reply to mailto:anna@gmx.net queued'),
    (6, '2026-10-27T08:17:01Z ERROR claims: GET https://john.smith:pass123@claims.example.com/case/4711 -> 401')
) t(id, line);

query IT
SELECT id, pii_mask(line) FROM app_log ORDER BY id;
----
1	2026-10-27T08:12:44Z ERROR backup: upload to [URL] failed (503)
2	2026-10-27T08:13:02Z WARN  sync: retrying [URL]
3	2026-10-27T08:14:10Z INFO  git: cloned [URL]
4	2026-10-27T08:15:55Z INFO  mail: unsubscribe https://shop.example.com/unsubscribe?email=[EMAIL]&id=7
5	2026-10-27T08:16:30Z INFO  crm: reply to mailto:[EMAIL] queued
6	2026-10-27T08:17:01Z ERROR claims: GET [URL] -> 401

# No user name or password survives in any masked line
query I
SELECT count(*) FROM app_log
WHERE regexp_matches(pii_mask(line), 'svc_backup|Winter2026|exporter|Kd8-pL2x|deploy|john\.smith|pass123');
----
0

# The audit reports the whole credentialed URL as the URL match
query ITT
SELECT id, pii_type, matched_text
FROM pii_audit_table('app_log', 'line', id_column := 'id')
ORDER BY id, start_pos;
----
1	URL	https://svc_backup:Winter2026@backup.example.net/api/v2/upload
2	URL	ftp://exporter:Kd8-pL2x@files.partner-logistik.de/outbound/orders.csv
3	URL	https://deploy@git.example.com/claims/portal.git
4	EMAIL	max.mustermann@web.de
5	EMAIL	anna@gmx.net
6	URL	https://john.smith:pass123@claims.example.com/case/4711

query I
SELECT count(*) FROM pii_audit_table('app_log', 'line', id_column := 'id')
WHERE regexp_matches(masked_value, 'svc_backup|Winter2026|exporter|Kd8-pL2x|deploy|john\.smith|pass123');
----
0

statement ok
RESET anofox_pii_enabled_types;
