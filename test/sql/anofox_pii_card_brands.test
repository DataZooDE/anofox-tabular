# name: test/sql/anofox_pii_card_brands.test
# description: Card numbers of all major brands are detected wherever pii_is_valid_credit_card accepts them; other digit runs are not cards
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_pii_enabled_types = 'CREDIT_CARD';

# Published test card numbers of the card networks and payment providers
statement ok
CREATE TABLE test_pans (brand VARCHAR, pan VARCHAR);

statement ok
INSERT INTO test_pans VALUES
    ('Visa', '4111111111111111'),
    ('Visa', '4012888888881881'),
    ('Visa', '4000056655665556'),
    ('Visa 13 digits', '4222222222222'),
    ('Visa 19 digits', '4111111111111111110'),
    ('Mastercard', '5555555555554444'),
    ('Mastercard', '5105105105105100'),
    ('Mastercard 2-series', '2223003122003222'),
    ('Mastercard 2-series', '2221000000000009'),
    ('American Express', '378282246310005'),
    ('American Express', '371449635398431'),
    ('Discover', '6011111111111117'),
    ('Discover', '6011000990139424'),
    ('Discover 644', '6445644564456445'),
    ('Maestro', '6759649826438453'),
    ('Maestro', '5018000000000009'),
    ('Maestro', '6304000000000000'),
    ('JCB', '3530111333300000'),
    ('JCB', '3566002020360505'),
    ('Diners Club', '36227206271667'),
    ('Diners Club', '30569309025904'),
    ('Diners Club', '38520000023237'),
    ('UnionPay', '6200000000000005'),
