    ('Luhn fails', '6200000000000006'),
    ('Luhn fails', '36227206271668');

# Detection agrees with the checksum function on every number
query I
SELECT count(*) FROM test_pans WHERE pii_contains(pan) <> pii_is_valid_credit_card(pan);
----
0

query I
SELECT count(*) FROM test_pans WHERE pii_contains(pan);
----
24

# Formatted in sentences: grouped by spaces, dashes or dots
query I
SELECT list_transform(pii_detect(s), lambda m: m.text) FROM (VALUES
    ('Bitte belasten Sie meine Karte 2223 0031 2200 3222 mit 49,90 EUR.'),
    ('Amex 3782-822463-10005, gültig bis 12/28'),
    ('Diners: 3622 720627 1667.'),
    ('JCB card 3530 1113 3330 0000 expires 04/27'),
    ('UnionPay 6200-0000-0000-0005'),
    ('Maestro 6759 6498 2643 8453 und Visa 4222 2222 2222 2'),
    ('Karte 4111.1111.1111.1111'),
    ('Ref 12 4111 1111 1111 1111 erhalten'),
    ('Visa 4111 1111 1111 1111 110 (19 Stellen)')
) v(s);
----
[2223 0031 2200 3222]
[3782-822463-10005]
[3622 720627 1667]
[3530 1113 3330 0000]
[6200-0000-0000-0005]
[6759 6498 2643 8453, 4222 2222 2222 2]
[4111.1111.1111.1111]
[4111 1111 1111 1111]
[4111 1111 1111 1111 110]

query I
SELECT pii_mask('Karte 4111.1111.1111.1111, Ablauf 09/27');
----
Karte [CREDIT_CARD], Ablauf 09/27

# Other digit runs are not card numbers, even where the Luhn checksum holds
query I
SELECT count(*) FROM (VALUES
    ('Bestellnummer 1234567890123452 vom 25.10.2026'),
    ('IBAN DE89 3704 0044 0532 0130 00'),
    ('IBAN DE44500105175407324931'),
    ('Zeitstempel 2026-10-25 14:30:00.123456'),
    ('Log 20261025143000123 OK'),
    ('Tracking 1Z999AA10123456784'),
    ('Betrag 4.111.111.111.111,11 EUR'),
    ('Version 4111111111111111.2'),
    ('Telefon +4111111111111111'),
    ('Seriennummer SN4111111111111111'),
    ('Rechnung 4111111111111111-01'),
    ('Kundennummer 41111111111111111111 (20 Stellen)'),
    ('Messwerte 4111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111 1111')
) v(s) WHERE pii_contains(s);
----
0

# Restore the process-wide PII settings for the tests that follow
statement ok
SET anofox_pii_enabled_types = '';
