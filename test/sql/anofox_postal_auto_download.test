# name: test/sql/anofox_postal_auto_download.test
# description: anofox_tab_postal_auto_download = false stops the first postal call from
#              downloading the libpostal data bundle (~500 MB); the call raises an error
#              that says how to get the data instead (issue #125). Never downloads: the
#              data path points at an empty directory and the switch is off.
# group: [anofox_tabular]

# The postal module is only compiled where libpostal is available (Linux).
require-env POSTAL_AVAILABLE

# libpostal is initialised once per process and its data path cannot change afterwards, so
# this file needs a process in which no postal function ran yet: `make test` runs it on its
# own with ANOFOX_TEST_POSTAL_FRESH_PROCESS=1 (in a full test/* run it is skipped).
require-env ANOFOX_TEST_POSTAL_FRESH_PROCESS

require anofox_tabular

statement ok
LOAD anofox_tabular;

statement ok
SET anofox_tab_trace_level = 'warn';

# The default keeps today's behaviour: the first postal call downloads the data.
query T
SELECT current_setting('anofox_tab_postal_auto_download');
----
true

# An offline ETL runner: no libpostal data in its data directory, downloads disabled.
statement ok
SET anofox_tab_postal_data_path = '{TEST_DIR}/offline-etl-runner/libpostal';

statement ok
SET anofox_tab_postal_auto_download = false;

query T
SELECT current_setting('anofox_tab_postal_auto_download');
----
false

query T
SELECT data_present FROM postal_status();
----
false

statement ok
CREATE TABLE customer_addresses AS SELECT * FROM (VALUES
    (1001, 'Hauptstr. 5, 80331 München'),
    (1002, 'Hauptstraße 5 80331 Muenchen'),
    (1003, NULL)
) t(customer_id, address);

statement error
SELECT customer_id, postal_parse_address(address) FROM customer_addresses;
----
libpostal data not downloaded: anofox_tab_postal_auto_download is false

statement error
SELECT anofox_tab_postal_expand_address('Hauptstraße 5 80331 Muenchen');
----
SET anofox_tab_postal_auto_download = true to download it on first use, or call postal_load_data()

# NULL-only input still needs no data
query T
SELECT postal_expand_address(address) IS NULL FROM customer_addresses WHERE customer_id = 1003;
----
true

# Nothing was downloaded or created
query TT
SELECT initialized, data_present FROM postal_status();
----
false	false

# NULL is rejected like the NER switch
statement error
SET anofox_tab_postal_auto_download = NULL;
----
anofox_tab_postal_auto_download cannot be NULL

# The switch and the data path are process-wide state; restore the defaults.
statement ok
RESET anofox_tab_postal_auto_download;

query T
SELECT current_setting('anofox_tab_postal_auto_download');
----
true

statement ok
RESET anofox_tab_postal_data_path;
