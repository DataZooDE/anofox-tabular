# Test anofox_money_format with NULL values
query T
SELECT anofox_money_format(NULL, 'symbol');
----
NULL

query T
SELECT anofox_money_format(anofox_money(100.50, 'USD'), NULL);
----
NULL

# Test anofox_money_format in vector context
query T
SELECT anofox_money_format(anofox_money(amount, code), 'symbol') FROM (
    SELECT 100.50 as amount, 'USD' as code
    UNION ALL
    SELECT 75.00 as amount, 'EUR' as code
    UNION ALL
    SELECT 50.00 as amount, 'GBP' as code
) ORDER BY amount DESC;
----
$100.50
75,00 €
£50.00

# Test formatting with different amount values
query T
SELECT anofox_money_format(anofox_money(0.01, 'USD'), 'symbol');
----
$0.01

query T
SELECT anofox_money_format(anofox_money(999999.99, 'USD'), 'symbol');
----
$999999.99

query T
SELECT anofox_money_format(anofox_money(1000.00, 'USD'), 'symbol');
----
$1000.00

