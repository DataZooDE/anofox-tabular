{'amount': 50.0, 'currency': EUR}

query T
SELECT anofox_money_multiply(anofox_money(50.0, 'USD'), 1.0);
----
{'amount': 50.0, 'currency': USD}

query T
SELECT anofox_money_multiply(anofox_money(50.0, 'USD'), 0.0);
----
{'amount': 0.0, 'currency': USD}

query T
SELECT anofox_money_multiply(anofox_money(10.0, 'USD'), 1.5);
