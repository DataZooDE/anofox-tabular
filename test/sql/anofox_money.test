require anofox_tabular

# Test anofox_money creation
query T
SELECT anofox_money(100.50, 'USD');
----
{'amount': 100.5, 'currency': USD}

# Test anofox_money with different currencies
query T
SELECT anofox_money(50.00, 'EUR');
----
{'amount': 50.0, 'currency': EUR}

query T
SELECT anofox_money(1000.0, 'JPY');
----
{'amount': 1000.0, 'currency': JPY}

# Test anofox_money_from_cents
query T
SELECT anofox_money_from_cents(10050, 'USD');
----
{'amount': 10050.0, 'currency': USD}

query T
SELECT anofox_money_from_cents(5000, 'EUR');
----
{'amount': 5000.0, 'currency': EUR}

# Test anofox_money_amount extraction
query I
SELECT anofox_money_amount(anofox_money(100.50, 'USD'));
----
100

query I
SELECT anofox_money_amount(anofox_money(75.25, 'EUR'));
----
75

# Test anofox_money_currency extraction
query T
SELECT anofox_money_currency(anofox_money(100.50, 'USD'));
----
USD

query T
SELECT anofox_money_currency(anofox_money(50.00, 'GBP'));
----
GBP

