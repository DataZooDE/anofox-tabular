query T
SELECT anofox_money_format(anofox_money(75.25, 'EUR'), 'symbol');
----
75,25 €

query T
SELECT anofox_money_format(anofox_money(1000.00, 'JPY'), 'symbol');
----
¥1000.00

# Test anofox_money_format with 'code' style
query T
SELECT anofox_money_format(anofox_money(100.50, 'USD'), 'code');
----
100.50 USD

query T
SELECT anofox_money_format(anofox_money(75.25, 'EUR'), 'code');
----
75.25 EUR

# Test anofox_money_format with 'long' style
query T
SELECT anofox_money_format(anofox_money(100.50, 'USD'), 'long');
----
100.50 United States Dollar

query T
SELECT anofox_money_format(anofox_money(75.25, 'EUR'), 'long');
----
