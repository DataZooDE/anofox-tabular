# Test arithmetic operations on vectors
query T
SELECT anofox_money_add(anofox_money(amount1, 'USD'), anofox_money(amount2, 'USD')) FROM (
    SELECT 100.0 as amount1, 50.0 as amount2
    UNION ALL
    SELECT 200.0 as amount1, 75.0 as amount2
) ORDER BY amount1;
----
{'amount': 150.0, 'currency': USD}
{'amount': 275.0, 'currency': USD}

# Test chaining arithmetic operations
query T
SELECT anofox_money_format(
    anofox_money_add(
        anofox_money_multiply(anofox_money(10.0, 'USD'), 2.0),
        anofox_money(5.0, 'USD')
    ),
    'symbol'
);
----
$25.00

# Test extracting amount from arithmetic result
query R
SELECT anofox_money_amount(anofox_money_add(anofox_money(33.33, 'USD'), anofox_money(66.67, 'USD')));
----
100.0

# Test validation on arithmetic result
query I
SELECT anofox_money_is_positive(anofox_money_subtract(anofox_money(100.0, 'USD'), anofox_money(50.0, 'USD')));
----
true

query I
SELECT anofox_money_is_negative(anofox_money_subtract(anofox_money(50.0, 'USD'), anofox_money(100.0, 'USD')));
----
true

# Test anofox_money_in_range (quality validation)
query I
SELECT anofox_money_in_range(anofox_money(50.0, 'USD'), 10.0, 100.0);
----
true

query I
SELECT anofox_money_in_range(anofox_money(5.0, 'USD'), 10.0, 100.0);
----
false

query I
SELECT anofox_money_in_range(anofox_money(150.0, 'USD'), 10.0, 100.0);
----
false

query I
SELECT anofox_money_in_range(anofox_money(10.0, 'USD'), 10.0, 100.0);
----
true

query I
SELECT anofox_money_in_range(anofox_money(100.0, 'USD'), 10.0, 100.0);
----
true

# Test anofox_money_in_range with NULL values
query I
SELECT anofox_money_in_range(NULL, 10.0, 100.0);
----
NULL

query I
SELECT anofox_money_in_range(anofox_money(50.0, 'USD'), NULL, 100.0);
----
NULL

# Test anofox_money_same_currency
query I
SELECT anofox_money_same_currency(anofox_money(100.0, 'USD'), anofox_money(50.0, 'USD'));
----
true

query I
SELECT anofox_money_same_currency(anofox_money(100.0, 'USD'), anofox_money(50.0, 'EUR'));
----
false

query I
SELECT anofox_money_same_currency(anofox_money(100.0, 'EUR'), anofox_money(50.0, 'EUR'));
----
true

query I
SELECT anofox_money_same_currency(anofox_money(100.0, 'JPY'), anofox_money(50.0, 'GBP'));
----
false

# Test anofox_money_same_currency with NULL values
query I
