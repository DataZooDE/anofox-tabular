# Test quality validation in WHERE clause
query I
SELECT COUNT(*) FROM (
    SELECT anofox_money(amount, currency) as m FROM (
        SELECT 50.0 as amount, 'USD' as currency
        UNION ALL
        SELECT 150.0 as amount, 'USD' as currency
        UNION ALL
        SELECT 75.0 as amount, 'USD' as currency
    )
) WHERE anofox_money_in_range(m, 10.0, 100.0);
----
2

# Test currency consistency validation
query I
SELECT COUNT(*) FROM (
    SELECT
        anofox_money(100.0, c1) as m1,
        anofox_money(50.0, c2) as m2
    FROM (
        SELECT 'USD' as c1, 'USD' as c2
        UNION ALL
        SELECT 'EUR' as c1, 'USD' as c2
        UNION ALL
        SELECT 'USD' as c1, 'EUR' as c2
    )
) WHERE anofox_money_same_currency(m1, m2);
----
1
