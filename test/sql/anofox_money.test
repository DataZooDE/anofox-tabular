# Test anofox_money_abs
query T
SELECT anofox_money_abs(anofox_money(-100.0, 'USD'));
----
{'amount': 100.0, 'currency': USD}

query T
SELECT anofox_money_abs(anofox_money(100.0, 'USD'));
----
{'amount': 100.0, 'currency': USD}

query T
SELECT anofox_money_abs(anofox_money(0.0, 'EUR'));
----
{'amount': 0.0, 'currency': EUR}

query T
SELECT anofox_money_abs(NULL);
----
NULL

# Test anofox_money_abs with amount extraction
query R
SELECT anofox_money_amount(anofox_money_abs(anofox_money(-999.99, 'USD')));
----
999.99

# Test validation functions on vectors
query I
SELECT COUNT(*) FROM (
    SELECT anofox_money_is_positive(anofox_money(amount, 'USD')) as is_pos FROM (
        SELECT 100.0 as amount
        UNION ALL
        SELECT -50.0 as amount
        UNION ALL
        SELECT 0.0 as amount
    )
    WHERE is_pos
);
----
1

# Test validation functions in WHERE clause
query I
SELECT COUNT(*) FROM (
    SELECT anofox_money(amount, 'USD') as m FROM (
        SELECT 100.0 as amount
        UNION ALL
        SELECT -50.0 as amount
        UNION ALL
        SELECT 75.0 as amount
    )
) WHERE anofox_money_is_positive(m);
----
2

