# Test anofox_money_add with same currency
query T
SELECT anofox_money_add(anofox_money(100.0, 'USD'), anofox_money(50.0, 'USD'));
----
{'amount': 150.0, 'currency': USD}

query T
SELECT anofox_money_add(anofox_money(25.50, 'EUR'), anofox_money(75.50, 'EUR'));
----
{'amount': 101.0, 'currency': EUR}

query T
SELECT anofox_money_add(anofox_money(-10.0, 'USD'), anofox_money(10.0, 'USD'));
----
{'amount': 0.0, 'currency': USD}

