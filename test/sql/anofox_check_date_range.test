query I
SELECT COUNT(*) FROM (
    SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM rvs_range)
    EXCEPT ALL
    SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-13'))
