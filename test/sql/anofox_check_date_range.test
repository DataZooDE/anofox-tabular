# sample violations are the sorted distinct violating values of the window
query TT
SELECT reference_date, sample_violations
FROM rolling_values_in_set('daily_orders', 'status', ['shipped'], 'order_date', 1, 1.0, start_date := DATE '2026-01-15', end_date := DATE '2026-01-15')
----
2026-01-15	['SHIPPED ', open]

# ===--------------------------------------------------------------------===
# Validation
# ===--------------------------------------------------------------------===

statement error
SELECT * FROM rel_count_change('daily_orders', 'order_date', start_date := DATE '2026-01-01')
----
start_date and end_date must be given together

statement error
SELECT * FROM metric_anomaly_iqr('daily_orders', 'order_date', end_date := DATE '2026-01-01')
----
start_date and end_date must be given together

statement error
SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['open'], 'order_date', start_date := DATE '2026-01-05', end_date := DATE '2026-01-01')
----
start_date must not be after end_date

statement error
SELECT * FROM rel_count_change('daily_orders', 'order_date', NULL, 7, -0.5, 0.5, DATE '2026-01-03', start_date := DATE '2026-01-01', end_date := DATE '2026-01-02')
----
reference_date cannot be combined with start_date/end_date

statement error
SELECT * FROM metric_anomaly_iqr('daily_orders', 'order_date', NULL, 30, 1.5, 'both', DATE '2026-01-03', start_date := DATE '2026-01-01', end_date := DATE '2026-01-02')
----
reference_date cannot be combined with start_date/end_date

statement error
SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['open'], 'order_date', 7, 1.0, DATE '2026-01-03', start_date := DATE '2026-01-01', end_date := DATE '2026-01-02')
----
reference_date cannot be combined with start_date/end_date

statement error
SELECT * FROM rel_count_change('daily_orders', 'order_date', start_date := NULL, end_date := DATE '2026-01-02')
----
start_date and end_date must not be NULL

# an explicit NULL reference_date is the default, not a conflict
query I
SELECT COUNT(*) FROM rel_count_change('daily_orders', 'order_date', NULL, 7, -0.5, 0.5, NULL, start_date := DATE '2026-01-01', end_date := DATE '2026-01-03')
----
3
