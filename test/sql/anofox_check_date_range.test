UNION ALL SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-01')
UNION ALL SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-02')
