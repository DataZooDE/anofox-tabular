UNION ALL SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-16')
UNION ALL SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-17')
UNION ALL SELECT * FROM rolling_values_in_set('daily_orders', 'status', ['shipped', 'open'], 'order_date', 3, 0.9, DATE '2026-01-18')

query III
SELECT (SELECT COUNT(*) FROM rvs_range),
       (SELECT COUNT(*) FROM (SELECT * FROM rvs_range EXCEPT ALL SELECT * FROM rvs_single)),
