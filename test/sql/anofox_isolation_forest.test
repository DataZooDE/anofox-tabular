# ===--------------------------------------------------------------------===
# Regression Test for Issue #7 (GitHub)
# https://github.com/DataZooDE/anofox-tabular/issues/7
# User reported: all rows marked as anomalies for normal data (4112-4117)
# Root cause was: placeholder logic used value > 300 instead of real algorithm
# ===--------------------------------------------------------------------===

statement ok
CREATE TABLE iso_issue7_regression (id INTEGER, value DOUBLE)

statement ok
INSERT INTO iso_issue7_regression VALUES
    (1, 4112.0), (2, 4117.0), (3, 4117.0), (4, 4117.0), (5, 4112.0), (6, 4112.0)

# Test 76: Issue #7 - similar values should NOT all be anomalies
query TI
SELECT status, outlier_count FROM isolation_forest('iso_issue7_regression', 'value', 100, 256, 0.1, 'summary', 42)
----
pass	0

# Test 77: Issue #7 - all scores should be identical for identical values
query I
SELECT COUNT(DISTINCT ROUND(anomaly_score, 4)) FROM isolation_forest('iso_issue7_regression', 'value', 100, 256, 0.1, 'scores', 42)
----
1

# Test 78: Issue #7 - no individual row should be marked as anomaly
query I
SELECT COUNT(*) FROM isolation_forest('iso_issue7_regression', 'value', 100, 256, 0.1, 'scores', 42) WHERE is_anomaly = true
----
0

# ===--------------------------------------------------------------------===
# Additional Algorithm Validation Tests (isotree-style)
# ===--------------------------------------------------------------------===

# Test 79: Obvious outlier should have highest score
statement ok
CREATE TABLE iso_obvious_outlier (id INTEGER, value DOUBLE)

statement ok
INSERT INTO iso_obvious_outlier VALUES
    (1, 10.0), (2, 10.5), (3, 9.8), (4, 10.2), (5, 9.9), (6, 100.0)

query I
SELECT row_id FROM isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1
----
6

# Test 80: Reproducibility with same seed
query I
SELECT COUNT(*) FROM (
    SELECT a.anomaly_score - b.anomaly_score as diff
    FROM isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 42) a
    JOIN isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 42) b
    ON a.row_id = b.row_id
    WHERE ABS(a.anomaly_score - b.anomaly_score) > 0.0001
)
----
0

# Test 81: Scores should be in valid [0,1] range
query I
SELECT COUNT(*) FROM isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 42)
WHERE anomaly_score < 0.0 OR anomaly_score > 1.0
----
0

# Test 82: Multivariate outlier detection - point far from cluster should be detected
statement ok
CREATE TABLE iso_multivar_outlier (id INTEGER, x DOUBLE, y DOUBLE)

statement ok
INSERT INTO iso_multivar_outlier VALUES
    (1, 0.0, 0.0), (2, 0.1, 0.1), (3, -0.1, -0.1), (4, 0.05, -0.05),
    (5, -0.05, 0.05), (6, 10.0, 10.0)

query I
SELECT row_id FROM isolation_forest_mv('iso_multivar_outlier', 'x,y', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1
----
6

# ===--------------------------------------------------------------------===
# Additional Tests Derived from isotree Reference Implementation
# https://github.com/david-cortes/isotree
# ===--------------------------------------------------------------------===

# Test 83: Isotree Canonical Test - 20 points around origin + outlier at (3,3)
# From isotree C++ example: outlier at (3,3) should have highest anomaly score
statement ok
CREATE TABLE iso_canonical (id INTEGER, x DOUBLE, y DOUBLE)

statement ok
INSERT INTO iso_canonical VALUES
    (1, 0.1, 0.2), (2, -0.3, 0.1), (3, 0.2, -0.1), (4, -0.1, 0.3),
    (5, 0.0, 0.0), (6, 0.15, -0.2), (7, -0.2, 0.15), (8, 0.25, 0.1),
    (9, -0.15, -0.1), (10, 0.1, 0.25), (11, -0.25, 0.0), (12, 0.05, -0.15),
    (13, 0.3, 0.05), (14, -0.05, 0.2), (15, 0.2, -0.25), (16, -0.1, 0.1),
    (17, 0.15, 0.15), (18, -0.2, -0.2), (19, 0.0, 0.1), (20, 0.1, 0.0),
    (21, 3.0, 3.0)

# Outlier (row 21) should have highest score
query I
SELECT row_id FROM isolation_forest_mv('iso_canonical', 'x,y', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1
----
21

# Test 84: Two Clusters + Outlier Between Them
# From isotree vignette: two clusters at (-1,-1) and (1,1), outlier at (-1,1)
statement ok
CREATE TABLE iso_two_clusters (id INTEGER, x DOUBLE, y DOUBLE)

statement ok
INSERT INTO iso_two_clusters VALUES
    (1, -1.0, -1.0), (2, -0.9, -1.1), (3, -1.1, -0.9), (4, -0.8, -1.2),
    (5, -1.2, -0.8), (6, -1.0, -0.9), (7, -0.9, -1.0), (8, -1.1, -1.1),
    (9, 1.0, 1.0), (10, 0.9, 1.1), (11, 1.1, 0.9), (12, 0.8, 1.2),
    (13, 1.2, 0.8), (14, 1.0, 0.9), (15, 0.9, 1.0), (16, 1.1, 1.1),
    (17, -1.0, 1.0)

# Outlier (row 17) should have highest score
query I
SELECT row_id FROM isolation_forest_mv('iso_two_clusters', 'x,y', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1
----
17

# Test 85: Extreme Value Outlier Detection - scores should be ordered by extremity
statement ok
CREATE TABLE iso_multiple_outliers (id INTEGER, value DOUBLE)

statement ok
INSERT INTO iso_multiple_outliers VALUES
    (1, 10.0), (2, 10.1), (3, 9.9), (4, 10.2), (5, 9.8),
    (6, 50.0), (7, 100.0), (8, 500.0)

# Extreme outlier (row 8, value 500) should have highest score
query I
SELECT row_id FROM isolation_forest('iso_multiple_outliers', 'value', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1
----
8

# Moderate outlier (row 7, value 100) should have second highest score
query I
SELECT row_id FROM isolation_forest('iso_multiple_outliers', 'value', 100, 256, 0.1, 'scores', 42)
ORDER BY anomaly_score DESC LIMIT 1 OFFSET 1
----
7

# Test 86: Pure Normal Data Score Distribution
# When all data is from same distribution, scores should cluster together
# and no anomalies should be detected with default contamination
statement ok
CREATE TABLE iso_pure_normal (id INTEGER, value DOUBLE)

statement ok
INSERT INTO iso_pure_normal VALUES
    (1, 0.1), (2, 0.2), (3, -0.1), (4, 0.15), (5, -0.2),
    (6, 0.05), (7, -0.05), (8, 0.1), (9, -0.15), (10, 0.0)

# All scores should be similar (max - min < 0.3)
query I
SELECT CASE WHEN (MAX(anomaly_score) - MIN(anomaly_score)) < 0.3 THEN 1 ELSE 0 END
FROM isolation_forest('iso_pure_normal', 'value', 100, 256, 0.1, 'scores', 42)
----
1

# No anomalies should be detected with contamination=0.0
# (contamination=0.1 would flag top 10% = 1 row even if no true anomalies)
query I
SELECT COUNT(*) FROM isolation_forest('iso_pure_normal', 'value', 100, 256, 0.0, 'scores', 42)
WHERE is_anomaly = true
----
0

