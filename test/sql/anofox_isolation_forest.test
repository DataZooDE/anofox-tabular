# Consistency Tests
# ===--------------------------------------------------------------------===

# Test 38: Multiple calls with same parameters return consistent results
query T
SELECT s1.status FROM
  (SELECT status FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')) s1,
  (SELECT status FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')) s2
WHERE s1.status = s2.status
----
fail

# Test 39: Scores mode is reproducible with same parameters
query I
SELECT COUNT(DISTINCT is_anomaly) FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
----
2

