query I
SELECT COUNT(*) FROM (
    SELECT a.anomaly_score - b.anomaly_score as diff
    FROM isolation_forest_mv('eif_2d', 'x,y',
        100, 256, 0.1, 'scores', 42, 1, 'uniform', 'density') a
    JOIN isolation_forest_mv('eif_2d', 'x,y',
        100, 256, 0.1, 'scores', 42, 1, 'uniform', 'density') b
    ON a.row_id = b.row_id
    WHERE ABS(a.anomaly_score - b.anomaly_score) > 0.0001
)
----
0

