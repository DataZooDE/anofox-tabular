# Test 111: Density scores are unbounded (can be < 0 or > 1)
# For density, positive score = anomaly, negative = normal
# We just verify the function returns without error
query I
SELECT COUNT(*) FROM isolation_forest_mv('iso_normal_data',
    'value', 100, 256, 0.1, 'scores', 42, 1, 'uniform', 'density')
----
6

# Test 112: Density scoring detects anomalies (outlier has higher score than inliers)
query I
SELECT CASE WHEN max_score > min_score THEN 1 ELSE 0 END as anomaly_detected FROM (
    SELECT MAX(anomaly_score) as max_score, MIN(anomaly_score) as min_score
    FROM isolation_forest_mv('iso_normal_data',
        'value', 100, 256, 0.1, 'scores', 42, 1, 'uniform', 'density')
)
----
1

# Test 113: scoring_metric='adj_depth' works
query I
SELECT COUNT(*) FROM isolation_forest_mv('eif_2d',
    'x,y', 100, 256, 0.1, 'scores', 42, 1, 'uniform', 'adj_depth')
----
6

