require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# ===--------------------------------------------------------------------===
# Isolation Forest Test Suite
# Tests for anomaly detection using isolation forest algorithm
# ===--------------------------------------------------------------------===

# ===--------------------------------------------------------------------===
# Test Setup: Create test tables
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE iso_normal_data (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO iso_normal_data VALUES
    (1, 100.0),
    (2, 105.0),
    (3, 102.0),
    (4, 101.0),
    (5, 103.0),
    (6, 500.0)

statement ok
CREATE TEMP TABLE iso_small_data (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO iso_small_data VALUES
    (1, 10.0),
    (2, 12.0)

statement ok
CREATE TEMP TABLE iso_single_row (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO iso_single_row VALUES
    (1, 42.0)

statement ok
CREATE TEMP TABLE iso_identical_values (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO iso_identical_values VALUES
    (1, 50.0),
    (2, 50.0),
    (3, 50.0),
    (4, 50.0)

statement ok
CREATE TEMP TABLE iso_with_nulls (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO iso_with_nulls VALUES
    (1, 100.0),
    (2, NULL),
    (3, 102.0),
    (4, 500.0),
    (5, NULL),
    (6, 101.0)

statement ok
CREATE TEMP TABLE iso_empty (
    id INTEGER,
    value DOUBLE
)

# ===--------------------------------------------------------------------===
# Univariate Summary Mode Tests
# ===--------------------------------------------------------------------===

# Test 1: Basic summary mode with default parameters
query TIIR
SELECT status, outlier_count, total_count, n_trees FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
fail	1	6	100

# Test 2: Summary mode with different n_trees parameter
query I
SELECT n_trees FROM metric_isolation_forest('iso_normal_data', 'value', 50, 256, 0.1, 'summary')
----
50

# Test 3: Summary mode with different sample_size parameter
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 128, 0.1, 'summary')
----
1

# Test 4: Summary mode with higher contamination threshold
query I
SELECT outlier_count FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.2, 'summary')
----
1

# Test 5: Check message field in summary mode
query T
SELECT message FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
1 anomalies detected

# Test 6: Summary on data with no outliers (all normal values)
query T
SELECT status FROM metric_isolation_forest('iso_identical_values', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 7: Summary on small dataset
query T
SELECT status FROM metric_isolation_forest('iso_small_data', 'value', 100, 256, 0.1, 'summary')
----
pass

# ===--------------------------------------------------------------------===
# Univariate Scores Mode Tests
# ===--------------------------------------------------------------------===

# Test 8: Basic scores mode returns per-row data
query III
SELECT COUNT(*), COUNT(DISTINCT row_id), COUNT(DISTINCT is_anomaly) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
----
6	6	2

# Test 9: Scores mode - check anomaly_score range
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
WHERE anomaly_score >= 0.0 AND anomaly_score <= 1.0
----
6

# Test 10: Scores mode - verify all rows included
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
----
6

# Test 11: Scores mode - check ordering by row_id (ascending)
query I
SELECT COUNT(*) FROM (
  SELECT row_id, LAG(row_id) OVER (ORDER BY row_id) as prev_row
  FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
) WHERE row_id > prev_row OR prev_row IS NULL
----
6

# ===--------------------------------------------------------------------===
# Edge Cases: Empty and Single Row
# ===--------------------------------------------------------------------===

# Test 12: Empty table - summary mode
query T
SELECT status FROM metric_isolation_forest('iso_empty', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 13: Empty table - scores mode
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_empty', 'value', 100, 256, 0.1, 'scores')
----
0

# Test 14: Single row - summary mode
query T
SELECT status FROM metric_isolation_forest('iso_single_row', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 15: Single row - scores mode
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_single_row', 'value', 100, 256, 0.1, 'scores')
----
1

# ===--------------------------------------------------------------------===
# Edge Cases: Identical Values
# ===--------------------------------------------------------------------===

# Test 16: Identical values - summary mode
query T
SELECT status FROM metric_isolation_forest('iso_identical_values', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 17: Identical values - scores mode
query I
SELECT COUNT(DISTINCT is_anomaly) FROM metric_isolation_forest('iso_identical_values', 'value', 100, 256, 0.1, 'scores')
----
1

# ===--------------------------------------------------------------------===
# Edge Cases: NULL Handling
# ===--------------------------------------------------------------------===

# Test 18: Table with NULLs - summary mode (NULLs should be filtered)
query I
SELECT total_count FROM metric_isolation_forest('iso_with_nulls', 'value', 100, 256, 0.1, 'summary')
----
4

# Test 19: Table with NULLs - scores mode (NULLs should be excluded)
query I
SELECT COUNT(*) FROM metric_isolation_forest('iso_with_nulls', 'value', 100, 256, 0.1, 'scores')
----
4

# ===--------------------------------------------------------------------===
# Parameter Validation Tests
# ===--------------------------------------------------------------------===

# Test 20: n_trees too low (below 1)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 0, 256, 0.1, 'summary')
----
n_trees must be between

# Test 21: n_trees too high (above 500)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 501, 256, 0.1, 'summary')
----
n_trees must be between

# Test 22: sample_size too low (below 1)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 0, 0.1, 'summary')
----
sample_size must be between

# Test 23: sample_size too high (above 10000)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 10001, 0.1, 'summary')
----
sample_size must be between

# Test 24: contamination too low (below 0.0)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, -0.1, 'summary')
----
contamination must be between

# Test 25: contamination too high (above 0.5)
statement error
SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.6, 'summary')
----
contamination must be between

