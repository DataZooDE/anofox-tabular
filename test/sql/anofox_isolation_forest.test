query I
SELECT outlier_count FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.5, 'summary')
----
1

# Test 28: Mid-range contamination (0.25)
query I
SELECT outlier_count FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.25, 'summary')
----
1

