# Test 20: n_trees too low (below 1)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 0, 256, 0.1, 'summary')
----
n_trees must be between

# Test 21: n_trees too high (above 500)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 501, 256, 0.1, 'summary')
----
n_trees must be between

# Test 22: sample_size too low (below 1)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 100, 0, 0.1, 'summary')
----
sample_size must be between

# Test 23: sample_size too high (above 10000)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 100, 10001, 0.1, 'summary')
----
sample_size must be between

# Test 24: contamination too low (below 0.0)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 100, 256, -0.1, 'summary')
----
contamination must be between

# Test 25: contamination too high (above 0.5)
statement error
SELECT * FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.6, 'summary')
----
contamination must be between

# ===--------------------------------------------------------------------===
# Different Contamination Thresholds
# ===--------------------------------------------------------------------===

# Test 26: Very low contamination (0.01) - stricter anomaly detection
query I
SELECT outlier_count FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.01, 'summary')
----
1

# Test 27: Very high contamination (0.5) - allows up to 50% anomalies (3 of 6)
query I
SELECT outlier_count FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.5, 'summary', 42)
----
3

# Test 28: Mid-range contamination (0.25) - allows up to 25% anomalies (about 1-2 of 6)
query I
SELECT outlier_count FROM isolation_forest('iso_normal_data', 'value', 100, 256, 0.25, 'summary', 42)
----
2

