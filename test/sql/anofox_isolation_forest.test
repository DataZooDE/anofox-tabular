# ===--------------------------------------------------------------------===
# Return Value Type Tests
# ===--------------------------------------------------------------------===

# Test 54: Summary mode - status column is VARCHAR
query T
SELECT typeof(status) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
VARCHAR

# Test 55: Summary mode - outlier_count is INTEGER
query T
SELECT typeof(outlier_count) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
BIGINT

# Test 56: Summary mode - total_count is INTEGER
query T
SELECT typeof(total_count) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
BIGINT

# Test 57: Summary mode - avg_value is DOUBLE
query T
SELECT typeof(avg_value) FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'summary')
----
DOUBLE

# Test 58: Scores mode - row_id is INTEGER
query T
SELECT typeof(row_id) FROM (
  SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
  LIMIT 1
)
----
BIGINT

# Test 59: Scores mode - anomaly_score is numeric
query T
SELECT typeof(anomaly_score) FROM (
  SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
  LIMIT 1
)
----
DECIMAL(3,2)

# Test 60: Scores mode - is_anomaly is BOOLEAN
query T
SELECT typeof(is_anomaly) FROM (
  SELECT * FROM metric_isolation_forest('iso_normal_data', 'value', 100, 256, 0.1, 'scores')
  LIMIT 1
)
----
BOOLEAN

# ===--------------------------------------------------------------------===
# Multivariate Isolation Forest Tests
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE iso_multivar_data (
    id INTEGER,
    x DOUBLE,
    y DOUBLE
)

statement ok
INSERT INTO iso_multivar_data VALUES
    (1, 100.0, 50.0),
    (2, 105.0, 55.0),
    (3, 102.0, 52.0),
    (4, 101.0, 51.0),
    (5, 103.0, 53.0),
    (6, 600.0, 300.0)

statement ok
CREATE TEMP TABLE iso_multivar_3col (
    id INTEGER,
    a DOUBLE,
    b DOUBLE,
    c DOUBLE
)

statement ok
INSERT INTO iso_multivar_3col VALUES
    (1, 10.0, 20.0, 30.0),
    (2, 11.0, 21.0, 31.0),
    (3, 12.0, 22.0, 32.0),
    (4, 800.0, 400.0, 200.0),
    (5, 13.0, 23.0, 33.0)

# Test 61: Multivariate summary mode - basic test
query TIIR
SELECT status, outlier_count, total_count, n_columns FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 100, 256, 0.1, 'summary')
----
fail	1	6	2

# Test 62: Multivariate summary mode - two columns
query I
SELECT n_columns FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x, y', 100, 256, 0.1, 'summary')
----
2

# Test 63: Multivariate summary mode - three columns
query I
SELECT n_columns FROM metric_isolation_forest_multivariate('iso_multivar_3col', 'a,b,c', 100, 256, 0.1, 'summary')
----
3

# Test 64: Multivariate scores mode - returns per-row data
query I
SELECT COUNT(*) FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 100, 256, 0.1, 'scores')
----
6

# Test 65: Multivariate scores mode - check ordering
query I
SELECT COUNT(*) FROM (
  SELECT row_id, LAG(row_id) OVER (ORDER BY row_id) as prev_row
  FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 100, 256, 0.1, 'scores')
) WHERE row_id > prev_row OR prev_row IS NULL
----
6

# Test 66: Multivariate with quoted column names
query T
SELECT status FROM metric_isolation_forest_multivariate('iso_multivar_data', '"x","y"', 100, 256, 0.1, 'summary')
----
fail

# Test 67: Multivariate parameter validation - n_trees
statement error
SELECT * FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 501, 256, 0.1, 'summary')
----
n_trees must be between

# Test 68: Multivariate parameter validation - sample_size
statement error
SELECT * FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 100, 10001, 0.1, 'summary')
----
sample_size must be between

# Test 69: Multivariate parameter validation - contamination
statement error
SELECT * FROM metric_isolation_forest_multivariate('iso_multivar_data', 'x,y', 100, 256, 0.6, 'summary')
----
contamination must be between

