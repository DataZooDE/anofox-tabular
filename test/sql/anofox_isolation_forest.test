query T
SELECT status FROM isolation_forest('iso_empty', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 13: Empty table - scores mode
query I
SELECT COUNT(*) FROM isolation_forest('iso_empty', 'value', 100, 256, 0.1, 'scores')
----
0

# Test 14: Single row - summary mode
query T
SELECT status FROM isolation_forest('iso_single_row', 'value', 100, 256, 0.1, 'summary')
----
pass

# Test 15: Single row - scores mode
query I
SELECT COUNT(*) FROM isolation_forest('iso_single_row', 'value', 100, 256, 0.1, 'scores')
----
1

