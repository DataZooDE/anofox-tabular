# With same seed, results should be identical (already tested in #80)
# With different seeds on same data, outlier detection should still work
query I
SELECT row_id FROM isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 123)
ORDER BY anomaly_score DESC LIMIT 1
----
6

query I
SELECT row_id FROM isolation_forest('iso_obvious_outlier', 'value', 100, 256, 0.1, 'scores', 456)
ORDER BY anomaly_score DESC LIMIT 1
----
6

