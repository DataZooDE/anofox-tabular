statement ok
CREATE TABLE iso_multivar_data (
    id INTEGER,
    x DOUBLE,
    y DOUBLE
)

statement ok
INSERT INTO iso_multivar_data VALUES
    (1, 100.0, 50.0),
    (2, 105.0, 55.0),
    (3, 102.0, 52.0),
    (4, 101.0, 51.0),
    (5, 103.0, 53.0),
    (6, 600.0, 300.0)

statement ok
CREATE TABLE iso_multivar_3col (
    id INTEGER,
    a DOUBLE,
    b DOUBLE,
    c DOUBLE
)

statement ok
INSERT INTO iso_multivar_3col VALUES
    (1, 10.0, 20.0, 30.0),
    (2, 11.0, 21.0, 31.0),
    (3, 12.0, 22.0, 32.0),
    (4, 800.0, 400.0, 200.0),
    (5, 13.0, 23.0, 33.0)

# Test 61: Multivariate summary mode - basic test
query TIIR
SELECT status, outlier_count, total_count, n_columns FROM isolation_forest_mv('iso_multivar_data', 'x,y', 100, 256, 0.1, 'summary')
----
fail	1	6	2

# Test 62: Multivariate summary mode - two columns
query I
SELECT n_columns FROM isolation_forest_mv('iso_multivar_data', 'x, y', 100, 256, 0.1, 'summary')
----
2

# Test 63: Multivariate summary mode - three columns
query I
SELECT n_columns FROM isolation_forest_mv('iso_multivar_3col', 'a,b,c', 100, 256, 0.1, 'summary')
----
3

# Test 64: Multivariate scores mode - returns per-row data
query I
SELECT COUNT(*) FROM isolation_forest_mv('iso_multivar_data', 'x,y', 100, 256, 0.1, 'scores')
----
6

# Test 65: Multivariate scores mode - check ordering
query I
