# name: test/sql/anofox_ner_truncation.test
# description: NER on inputs longer than the model's 512 tokens (requires OpenVINO + model assets): the text is split into overlapping windows, so entities before and after the 512th token are found
# group: [anofox_tabular]

# Inputs longer than the model's maximum sequence length (512 tokens for
# the BERT-class models) must not fail inside OpenVINO (issue #56). They used to be
# truncated at 512 tokens; now overlapping windows of 256 tokens cover the
# whole text, so entities after the first 512 tokens are found as well.
require-env OPENVINO_AVAILABLE

require anofox_tabular

statement ok
LOAD anofox_tabular

# Short input baseline: NER detects the organization
query I
SELECT list_contains(
    list_transform(pii_detect('John Smith works at Microsoft in Seattle.'), lambda x: x.type),
    'ORGANIZATION');
----
true

# Long input (~1200 tokens): entity in the leading text must still be found.
# Without bounding the input this threw inside OpenVINO and returned no NER entities.
query I
SELECT list_contains(
    list_transform(
        pii_detect('John Smith works at Microsoft in Seattle. ' ||
                   repeat('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. ', 60)),
        lambda x: x.type),
    'ORGANIZATION');
----
true

# Entities after the first 512 tokens are found too (they were ignored when
# the input was truncated)
query II
SELECT list_contains(list_transform(m, lambda x: x.type), 'ORGANIZATION'),
       list_contains(list_transform(list_filter(m, lambda x: x.type = 'NAME'), lambda x: x.text), 'Maria Garcia')
FROM (SELECT pii_detect(repeat('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. ', 60) ||
                        'Maria Garcia works at Microsoft in Seattle.') AS m);
----
true	true

# Long input must not break subsequent short inputs (no corrupted state)
query I
SELECT list_contains(
    list_transform(pii_detect('Maria Garcia visited the Eiffel Tower in Paris.'), lambda x: x.type),
    'LOCATION');
----
true

# Re-setting the currently loaded model name after load stays a no-op success
statement ok
SET anofox_ner_model = 'bert-multi';

# Switching to a different model after load is rejected (issue #56): compiled
# model and tokenizer are immutable once loaded
statement error
SET anofox_ner_model = 'distilbert-en';
----
anofox_ner_model cannot be changed after the NER model has been loaded (currently 'bert-multi')

query T
SELECT current_setting('anofox_ner_model');
----
bert-multi
