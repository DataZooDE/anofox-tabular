require anofox_tabular

statement ok
SELECT * FROM phonenumber_status();

statement ok
SET anofox_tab_phonenumber_default_region='US';

query TTTTT
SELECT (parsed).valid, (parsed).country_code, (parsed).national_number, (parsed).region, (parsed).type
FROM (SELECT phonenumber_parse('+1 650-253-0000', NULL) AS parsed);
----
true	1	6502530000	US	fixed_line_or_mobile

query TT
SELECT * FROM phonenumber_status();
----
true	US

query T
SELECT phonenumber_format('6502530000', 'US', 'E164');
----
+16502530000

query T
SELECT phonenumber_region('+44 20 8366 1177', NULL);
----
GB

query T
SELECT phonenumber_format('2025550179', NULL, 'national');
----
(202) 555-0179

query T
SELECT phonenumber_parse('2025550179', NULL).valid;
----
true

query T
SELECT phonenumber_parse('not a number', NULL).valid;
----
false

# Issue #54: unknown format strings must raise an error instead of silently
# falling back to NATIONAL and echoing the input.
statement error
SELECT phonenumber_format('123', 'US', 'foobar');
----
foobar

# Issue #54: invalid numbers with a valid format option return NULL instead of echoing the input.
query T
SELECT phonenumber_format('123', 'US', 'E164');
----
NULL

statement ok
SET anofox_tab_phonenumber_default_region='GB';

query T
SELECT (parsed).region
FROM (SELECT phonenumber_parse('02083661177', NULL) AS parsed);
----
GB

statement ok
SET anofox_tab_phonenumber_default_region='US';

# Test phonenumber_is_valid function
query T
SELECT phonenumber_is_valid('+1 650-253-0000', 'US');
----
true

query T
SELECT phonenumber_is_valid('6502530000', 'US');
----
true

query T
SELECT phonenumber_is_valid('123', 'US');
----
false

query T
SELECT phonenumber_is_valid('not a number', 'US');
----
false

# Test phonenumber_is_valid with NULL region (should use default)
query T
SELECT phonenumber_is_valid('2025550179', NULL);
----
true

# Test phonenumber_is_possible function
query T
SELECT phonenumber_is_possible('+1 650-253-0000', 'US');
----
true

query T
SELECT phonenumber_is_possible('6502530000', 'US');
----
true

query T
SELECT phonenumber_is_possible('123', 'US');
----
false

query T
SELECT phonenumber_is_possible('not a number', 'US');
----
false

# Test phonenumber_is_valid_for_region function
query T
SELECT phonenumber_is_valid_for_region('+1 650-253-0000', 'US');
----
true

query T
SELECT phonenumber_is_valid_for_region('6502530000', 'US');
----
true

# UK number should be valid for GB region
query T
SELECT phonenumber_is_valid_for_region('+44 20 8366 1177', 'GB');
----
true

# UK number should not be valid for US region
query T
SELECT phonenumber_is_valid_for_region('+44 20 8366 1177', 'US');
----
false

# Test with NULL region (should use default region which is US)
query T
SELECT phonenumber_is_valid_for_region('2025550179', NULL);
----
true

# Test phonenumber_match function
# Exact match: same number in different formats
query T
SELECT phonenumber_match('+1 650-253-0000', '6502530000', 'US');
----
EXACT_MATCH

# NSN match: numbers match when ignoring country code
query T
SELECT phonenumber_match('+1 650-253-0000', '+1 (650) 253-0000', 'US');
----
EXACT_MATCH

# Short NSN match (for short numbers)
query T
SELECT phonenumber_match('411', '411', 'US');
----
EXACT_MATCH

# No match: different numbers
query T
SELECT phonenumber_match('+1 650-253-0000', '+1 415-555-1234', 'US');
----
NO_MATCH

# Different country codes
query T
SELECT phonenumber_match('+1 650-253-0000', '+44 20 8366 1177', NULL);
----
NO_MATCH

# With NULL region (should use default)
query T
SELECT phonenumber_match('2025550179', '(202) 555-0179', NULL);
----
EXACT_MATCH

# Invalid first number should return NO_MATCH
query T
SELECT phonenumber_match('invalid', '6502530000', 'US');
----
NO_MATCH

# Invalid second number should return NO_MATCH
query T
SELECT phonenumber_match('6502530000', 'invalid', 'US');
----
NO_MATCH

# Test phonenumber_example function
# Get example number for US
query T
SELECT phonenumber_example('US');
----
+12015550123

# Get example number for GB
query T
SELECT phonenumber_example('GB');
----
+441212345678

# Get example number for DE
query T
SELECT phonenumber_example('DE');
----
+4930123456

# Get example number for FR
query T
SELECT phonenumber_example('FR');
----
+33123456789

# With lowercase region code (should be normalized to uppercase internally)
query T
SELECT phonenumber_example('us');
----
+12015550123

# ----------------------------------------------------------------------
# Issue #54: region-hint and national-number parsing correctness
# ----------------------------------------------------------------------

# Region hints must be honored for shared country codes (NANPA).
# 506 is a Canadian (New Brunswick) area code, so a CA hint must resolve to CA.
query T
SELECT phonenumber_is_valid_for_region('+1 5062345678', 'CA');
----
true

query T
SELECT phonenumber_region('+1 5062345678', 'CA');
----
CA

# Parse roundtrip with a CA region hint on a +1 number.
query TTTT
SELECT (p).valid, (p).country_code, (p).national_number, (p).region
FROM (SELECT phonenumber_parse('+1 506-234-5678', 'CA') AS p);
----
true	1	5062345678	CA

# A national number with a region hint must keep the hinted region,
# not the main region of the shared country code.
query T
SELECT (phonenumber_parse('5062345678', 'CA')).region;
----
CA

# US numbers without a hint still resolve to US (main NANPA region).
query T
SELECT phonenumber_region('+1 6502530000', NULL);
----
US

# An explicit international prefix wins over a conflicting region hint
# when the hint does not belong to the country code.
query T
SELECT phonenumber_region('+44 20 8366 1177', 'US');
----
GB

# National numbers must not be misparsed as international: 442 is a US
# area code (Apple Valley, CA), not country code 44 (GB).
query TT
SELECT (p).valid, (p).region
FROM (SELECT phonenumber_parse('4423456789', 'US') AS p);
----
true	US

query T
SELECT phonenumber_is_valid('4423456789', 'US');
----
true

query T
SELECT phonenumber_is_valid_for_region('4423456789', 'US');
----
true

# Unknown region codes must be rejected by the SET callback.
statement error
SET anofox_tab_phonenumber_default_region='ZZ';
----
ZZ

# NULL region must be rejected as before.
statement error
SET anofox_tab_phonenumber_default_region=NULL;
----
anofox_phonenumber_default_region cannot be NULL

# Lowercase region codes are normalized and accepted.
statement ok
SET anofox_tab_phonenumber_default_region='ca';

query TT
SELECT * FROM phonenumber_status();
----
true	CA

statement ok
SET anofox_tab_phonenumber_default_region='US';

# The default region is session-scoped: a SET in one connection must not
# leak into other sessions through process-wide mutable state.
statement ok con1
SET anofox_tab_phonenumber_default_region='GB';

query T con2
SELECT (phonenumber_parse('2025550179', NULL)).region;
----
US

statement ok con1
SET anofox_tab_phonenumber_default_region='US';

# Misspelled format options must raise an error.
statement error
SELECT phonenumber_format('6502530000', 'US', 'INTERNATIONL');
----
INTERNATIONL

# All documented format options keep working.
query T
SELECT phonenumber_format('6502530000', 'US', 'NATIONAL');
----
(650) 253-0000

query T
SELECT phonenumber_format('6502530000', 'US', 'INTERNATIONAL');
----
+1 650 253 0000

query T
SELECT phonenumber_format('6502530000', 'US', 'RFC3966');
----
tel:+1-650-253-0000
