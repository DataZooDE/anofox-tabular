# name: test/sql/anofox_ner_options.test
# description: NER configuration options tests (no OpenVINO required)
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

# ============================================================================
# anofox_ner_device option tests
# ============================================================================

# 1. Default value is 'AUTO'
query T
SELECT current_setting('anofox_ner_device');
----
AUTO

# 2. Visible in duckdb_settings() with correct default
query I
SELECT COUNT(*) FROM duckdb_settings() WHERE name = 'anofox_ner_device' AND value = 'AUTO';
----
1

# 3. SET to 'CPU' -> current_setting() reflects new value
statement ok
SET anofox_ner_device = 'CPU';

query T
SELECT current_setting('anofox_ner_device');
----
CPU

# 4. SET to 'AUTO' (round-trip) -> current_setting() reflects new value
statement ok
SET anofox_ner_device = 'AUTO';

query T
SELECT current_setting('anofox_ner_device');
----
AUTO

# 5. SET to 'GPU' (no validation at SET time) - accepted and stored
statement ok
SET anofox_ner_device = 'GPU';

query T
SELECT current_setting('anofox_ner_device');
----
GPU

# 6. SET to 'GPU.0' (indexed GPU) - accepted and stored
statement ok
SET anofox_ner_device = 'GPU.0';

query T
SELECT current_setting('anofox_ner_device');
----
GPU.0

# 7. SET to 'HETERO:GPU,CPU' (heterogeneous device) - accepted and stored
statement ok
SET anofox_ner_device = 'HETERO:GPU,CPU';

query T
SELECT current_setting('anofox_ner_device');
----
HETERO:GPU,CPU

# 8. SET to NULL - throws InvalidInputException
statement error
SET anofox_ner_device = NULL;
----
anofox_ner_device cannot be NULL

# 8b. Device names are validated at SET time. Accepted: AUTO, CPU, GPU, NPU,
# an indexed GPU or NPU (GPU.1), and AUTO:/HETERO:/MULTI: with a device list;
# names are upper-cased the way OpenVINO spells them
statement ok
SET anofox_ner_device = 'npu';

query T
SELECT current_setting('anofox_ner_device');
----
NPU

statement ok
SET anofox_ner_device = 'multi:gpu.1, cpu';

query T
SELECT current_setting('anofox_ner_device');
----
MULTI:GPU.1,CPU

statement ok
SET anofox_ner_device = 'AUTO:GPU,CPU';

query T
SELECT current_setting('anofox_ner_device');
----
AUTO:GPU,CPU

statement error
SET anofox_ner_device = 'NPU2';
----
Unsupported anofox_ner_device 'NPU2'. Use AUTO, CPU, GPU, NPU, an indexed device such as GPU.0, or AUTO:, HETERO: or MULTI: followed by a comma-separated device list (HETERO:GPU,CPU)

statement error
SET anofox_ner_device = 'TPU';
----
Unsupported anofox_ner_device 'TPU'

statement error
SET anofox_ner_device = 'GPU.';
----
Unsupported anofox_ner_device 'GPU.'

statement error
SET anofox_ner_device = 'CPU.0';
----
Unsupported anofox_ner_device 'CPU.0'

statement error
SET anofox_ner_device = 'HETERO:';
----
Unsupported anofox_ner_device 'HETERO:'

statement error
SET anofox_ner_device = 'HETERO:GPU,,CPU';
----
Unsupported anofox_ner_device 'HETERO:GPU,,CPU'

statement error
SET anofox_ner_device = 'HETERO:AUTO';
----
Unsupported anofox_ner_device 'HETERO:AUTO'

statement error
SET anofox_ner_device = '';
----
Unsupported anofox_ner_device ''

# A rejected value leaves the previous setting in place
query T
SELECT current_setting('anofox_ner_device');
----
AUTO:GPU,CPU

# 9. Reset to AUTO; verify setting is stored correctly
statement ok
SET anofox_ner_device = 'AUTO';

query T
SELECT current_setting('anofox_ner_device');
----
AUTO

# ============================================================================
# anofox_ner_cache_size option tests
# ============================================================================

# 10. Default value is 10000 (returned as BIGINT)
query I
SELECT current_setting('anofox_ner_cache_size');
----
10000

# 11. Visible in duckdb_settings() with correct default
query I
SELECT COUNT(*) FROM duckdb_settings() WHERE name = 'anofox_ner_cache_size' AND value = '10000';
----
1

# 12. SET to 0 (disable cache) - accepted and stored
statement ok
SET anofox_ner_cache_size = 0;

query I
SELECT current_setting('anofox_ner_cache_size');
----
0

# 13. SET to 5000 - accepted and stored
statement ok
SET anofox_ner_cache_size = 5000;

query I
SELECT current_setting('anofox_ner_cache_size');
----
5000

# 14. SET to 1 (minimum useful value) - accepted
statement ok
SET anofox_ner_cache_size = 1;

query I
SELECT current_setting('anofox_ner_cache_size');
----
1

# 15. SET to very large value (1000000) - accepted
statement ok
SET anofox_ner_cache_size = 1000000;

query I
SELECT current_setting('anofox_ner_cache_size');
----
1000000

# 16. SET to -1 (negative) - throws InvalidInputException
statement error
SET anofox_ner_cache_size = -1;
----
anofox_ner_cache_size cannot be negative

# 17. SET to NULL - throws InvalidInputException
statement error
SET anofox_ner_cache_size = NULL;
----
anofox_ner_cache_size cannot be NULL

# Reset to default for subsequent tests
statement ok
SET anofox_ner_cache_size = 10000;

query I
SELECT current_setting('anofox_ner_cache_size');
----
10000

# ============================================================================
# anofox_ner_model option tests
# ============================================================================

# 18. Default value is 'bert-multi'
query T
SELECT current_setting('anofox_ner_model');
----
bert-multi

# 19. Visible in duckdb_settings() with correct default
query I
SELECT COUNT(*) FROM duckdb_settings() WHERE name = 'anofox_ner_model' AND value = 'bert-multi';
----
1

# 20. SET to 'bert-multi' (valid, round-trip) - accepted. Only the default is
# set here: in a test run with OpenVINO the default model may already be
# loaded, and switching to another model is then an error
statement ok
SET anofox_ner_model = 'bert-multi';

query T
SELECT current_setting('anofox_ner_model');
----
bert-multi

# 21. SET to 'xlm-roberta-multi' - rejected: no downloadable assets exist for
# this model, so advertising it would be a silent no-op (issue #56). The error
# lists the supported models.
statement error
SET anofox_ner_model = 'xlm-roberta-multi';
----
Unsupported NER model

query T
SELECT current_setting('anofox_ner_model');
----
bert-multi

# 22. SET to 'invalid-model' - throws (model name validated at SET time);
# the error message lists the valid model names
statement error
SET anofox_ner_model = 'invalid-model';
----
Unsupported NER model: invalid-model. Valid models: distilbert-en, distilbert-multi, bert-multi

# 22b. The setting description lists every model with its languages, size and licence
query T
SELECT description FROM duckdb_settings() WHERE name = 'anofox_ner_model';
----
NER model to use: distilbert-en (en, 66 MB, Apache-2.0); distilbert-multi (ar de en es fr it lv nl pt zh, 135 MB, AFL-3.0); bert-multi (ar de en es fr it lv nl pt zh, 178 MB, AFL-3.0); must be set before the model is first loaded

# 23. SET to 'DISTILBERT-EN' (wrong case) - throws (case-sensitive validation)
statement error
SET anofox_ner_model = 'DISTILBERT-EN';
----
Unsupported NER model

# 24. SET to '' (empty string) - throws (not a valid model name)
statement error
SET anofox_ner_model = '';
----
Unsupported NER model

# 25. SET to NULL - throws InvalidInputException
statement error
SET anofox_ner_model = NULL;
----
anofox_ner_model cannot be NULL

# Reset model to default
statement ok
SET anofox_ner_model = 'bert-multi';

query T
SELECT current_setting('anofox_ner_model');
----
bert-multi

# ============================================================================
# anofox_ner_required option tests
# ============================================================================

# 26. Default false: without the model, detection falls back silently
query T
SELECT current_setting('anofox_ner_required');
----
false

statement ok
SET anofox_ner_required = true;

query T
SELECT current_setting('anofox_ner_required');
----
true

statement error
SET anofox_ner_required = NULL;
----
anofox_ner_required cannot be NULL

statement ok
SET anofox_ner_required = false;

# Pattern-only detection never needs the model, also when it is required
statement ok
SET anofox_ner_required = true;

statement ok
SET anofox_pii_enabled_types = 'EMAIL,IBAN';

query T
SELECT pii_mask('Ticket 4711: refund to anna.berger@example.de, IBAN DE89 3704 0044 0532 0130 00');
----
Ticket 4711: refund to [EMAIL], IBAN [IBAN]

statement ok
SET anofox_pii_enabled_types = '';

statement ok
SET anofox_ner_required = false;

# ============================================================================
# Global option count
# ============================================================================

# 27. Exactly 5 anofox_ner% options registered in duckdb_settings()
query I
SELECT COUNT(*) FROM duckdb_settings() WHERE name LIKE 'anofox_ner%';
----
5
