# name: test/sql/anofox_check_table_name_collision.test
# description: The checks generate SQL with common table expressions. A user table that has the
#              name of one of them (a table of daily figures called 'daily', a lookup table
#              called 'ref', a view called 'summary') is still the table the check reads, not
#              the internal CTE (issue #131: metric_anomaly_iqr on a table named 'daily' failed
#              with 'Referenced column "day" not found ... Candidate bindings: "d"').
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# Issue #131: the daily revenue of a shop, one row per day, in a table named 'daily'
statement ok
CREATE TABLE daily AS
SELECT DATE '2026-06-01' + i::INTEGER AS day, 100.0 + (i * 13) % 17 AS revenue FROM range(30) t(i)

query TTRRRRRIT
SELECT status, reference_date, metric_value, q1, q3, lower_bound, upper_bound, baseline_days, message
FROM anofox_tab_metric_anomaly_iqr('daily', 'day', 'revenue', 14, 1.5, 'both', DATE '2026-06-20')
----
pass	2026-06-20	109.0	104.5	112.75	92.125	125.125	14	Metric 109.0 on 2026-06-20 is within IQR bounds [92.125, 125.125]

# A revenue spike on 2026-07-01: the 6-argument form evaluates the latest day and fails
statement ok
INSERT INTO daily VALUES (DATE '2026-07-01', 250.0)

query TTRRRI
SELECT status, reference_date, metric_value, lower_bound, upper_bound, baseline_days
FROM metric_anomaly_iqr('daily', 'day', 'revenue', 14, 1.5, 'both')
----
fail	2026-07-01	250.0	92.0	122.0	14

query TTTTRRT
SELECT ds, kind, label, severity, value, threshold, series
FROM anofox_tab_metric_anomaly_iqr_events('daily', 'day', 'revenue', 14, 1.5, 'both',
                                          start_date := DATE '2026-06-25', end_date := DATE '2026-07-01')
----
2026-07-01	metric_anomaly_iqr	Metric 250.0 on 2026-07-01 is outside IQR bounds [92.0, 122.0] (mode: both)	alarm	250.0	122.0	daily.revenue

# The orders of a web shop from 2026-05-01 to 2026-06-29: 6 to 12 orders a day, some cancelled
# or pending, an occasional bulk order, customers 20 to 22 are missing from the CRM
statement ok
CREATE TABLE shop_orders AS
SELECT 'ORD-' || strftime(day, '%Y%m%d') || '-' || lpad(CAST(i AS VARCHAR), 2, '0') AS order_id,
       day AS order_date,
       CAST((day_no * 31 + i * 37) % 23 AS INTEGER) AS customer_id,
       CASE WHEN (day_no + i) % 11 = 0 THEN 'cancelled' WHEN (day_no + i) % 5 = 0 THEN 'pending' ELSE 'shipped' END AS status,
       CASE WHEN day_no % 17 = 0 AND i = 0 THEN 1250.0 ELSE CAST(20 + (day_no * 13 + i * 29) % 97 + 0.5 AS DOUBLE) END AS amount
FROM (SELECT CAST(d AS DATE) AS day, CAST(row_number() OVER (ORDER BY d) AS INTEGER) AS day_no
      FROM generate_series(DATE '2026-05-01', DATE '2026-06-29', INTERVAL 1 DAY) g(d)) days,
     range(12) r(i)
WHERE i < 6 + (day_no * 5) % 7

statement ok
CREATE TABLE crm_customers AS SELECT CAST(i AS INTEGER) AS customer_id FROM range(20) t(i)

# The results on shop_orders that the tables named like a CTE must reproduce below
query TTRRRI
SELECT status, reference_date, metric_value, lower_bound, upper_bound, baseline_days
FROM metric_anomaly_iqr('shop_orders', 'order_date', 'amount', 14, 1.5, 'both', DATE '2026-06-20')
----
fail	2026-06-20	194.22222222222223	58.25000000000002	81.69444444444443	14

query I
