# The same suite on the table named like a CTE and on shop_orders
statement ok
CREATE OR REPLACE TABLE suite_checks AS
SELECT check_name || '@' || t.table_name AS check_name, check_type, t.table_name, column_name, params, identifier_column
FROM (VALUES
  ('iqr', 'metric_anomaly_iqr', 'amount', '{"date_column": "order_date", "window_days": 14, "reference_date": "2026-06-20"}', NULL),
  ('iqr_rows', 'metric_anomaly_iqr', NULL, '{"date_column": "order_date"}', NULL),
  ('rcc', 'rel_count_change', NULL, '{"date_column": "order_date", "fill_missing_days": true}', NULL),
  ('rvis', 'rolling_values_in_set', 'status', '{"date_column": "order_date", "allowed_values": ["shipped", "pending"]}', NULL),
  ('occ', 'occurrence', 'customer_id', '{}', NULL),
  ('dup', 'duplicate_count', 'customer_id', '{}', NULL),
  ('dup_by_status', 'duplicate_count', 'customer_id', '{}', 'status')
) c(check_name, check_type, column_name, params, identifier_column),
(VALUES ('${name}'), ('shop_orders')) t(table_name)

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (run_ts, table_name) REPLACE (split_part(check_name, '@', 1) AS check_name) FROM run_checks('suite_checks') WHERE table_name = '${name}'
   EXCEPT ALL
   SELECT * EXCLUDE (run_ts, table_name) REPLACE (split_part(check_name, '@', 1) AS check_name) FROM run_checks('suite_checks') WHERE table_name = 'shop_orders')
  UNION ALL
  (SELECT * EXCLUDE (run_ts, table_name) REPLACE (split_part(check_name, '@', 1) AS check_name) FROM run_checks('suite_checks') WHERE table_name = 'shop_orders'
   EXCEPT ALL
   SELECT * EXCLUDE (run_ts, table_name) REPLACE (split_part(check_name, '@', 1) AS check_name) FROM run_checks('suite_checks') WHERE table_name = '${name}')
)
----
0

query I
SELECT count(*) FROM run_checks('suite_checks') WHERE table_name = '${name}' AND status = 'error'
----
0

