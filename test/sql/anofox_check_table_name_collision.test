# run_checks on tables named like its CTEs: the daily revenue of issue #131 again (the loop
# dropped it), with the spike on 2026-07-01
statement ok
CREATE TABLE daily AS
SELECT DATE '2026-06-01' + i::INTEGER AS day, 100.0 + (i * 13) % 17 AS revenue FROM range(30) t(i)
UNION ALL SELECT DATE '2026-07-01', 250.0

statement ok
CREATE TABLE ref AS SELECT * FROM shop_orders

statement ok
CREATE TABLE win AS SELECT * FROM shop_orders

statement ok
CREATE TABLE dq_checks AS SELECT * FROM (VALUES
  ('iqr_daily', 'metric_anomaly_iqr', 'daily', 'revenue', '{"date_column": "day", "window_days": 14}'),
  ('iqr_ref', 'metric_anomaly_iqr', 'ref', 'amount', '{"date_column": "order_date", "window_days": 14, "reference_date": "2026-06-20"}'),
  ('rcc_daily', 'rel_count_change', 'daily', NULL, '{"date_column": "day", "fill_missing_days": true}'),
  ('rcc_ref', 'rel_count_change', 'ref', NULL, '{"date_column": "order_date"}'),
  ('rvis_ref', 'rolling_values_in_set', 'ref', 'status', '{"date_column": "order_date", "allowed_values": ["shipped", "pending"]}'),
  ('rvis_win', 'rolling_values_in_set', 'win', 'status', '{"date_column": "order_date", "allowed_values": ["shipped", "pending"]}')
) t(check_name, check_type, table_name, column_name, params)

query TTRRRT
SELECT check_name, status, value, lower_threshold, upper_threshold, message FROM run_checks('dq_checks')
----
iqr_daily	fail	250.0	92.0	122.0	metric_anomaly_iqr value 250.0 violates thresholds (250.0 > upper 122.0)
iqr_ref	fail	194.22222222222223	58.25000000000002	81.69444444444443	metric_anomaly_iqr value 194.222 violates thresholds (194.222 > upper 81.694)
rcc_daily	pass	0.0	NULL	NULL	rel_count_change value 0.0: no thresholds configured (monitor)
rcc_ref	pass	0.3333333333333333	NULL	NULL	rel_count_change value 0.333: no thresholds configured (monitor)
rvis_ref	pass	0.9206349206349206	NULL	NULL	rolling_values_in_set value 0.921: no thresholds configured (monitor)
rvis_win	pass	0.9206349206349206	NULL	NULL	rolling_values_in_set value 0.921: no thresholds configured (monitor)
