# The stored E164 form reads back without a country: same validity and region
query II
SELECT count(*), count(*) FILTER (WHERE phonenumber_is_valid(e164, NULL)
                                    AND phonenumber_region(e164, NULL) = country
                                    AND phonenumber_format(e164, NULL, 'E164') = e164)
FROM (SELECT country, phonenumber_format(phone, country, 'E164') AS e164 FROM eu_customers);
----
60	60

# A data-quality check over the list flags nothing
query I
SELECT count(*) FILTER (WHERE NOT phonenumber_is_valid(phone, country)) FROM eu_customers;
----
0

# Typos: eight digits too many are never valid. With the last digit dropped, a number of a
# region with variable-length numbers (AT, DE, FI, IT, ...) can still be valid; libphonenumber
# agrees on exactly these nine
query TI
SELECT string_agg(country || ' ' || phone, ', ' ORDER BY rowid) FILTER (WHERE phonenumber_is_valid(left(phone, -1), country)),
       count(*) FILTER (WHERE phonenumber_is_valid(phone || '99999999', country))
FROM eu_customers;
----
AT 01 234567890, AT 0664 123456, BG 02 123 456, DE 030 123456, EE 5123 4567, FI 013 1234567, FI 041 2345678, IT 02 1234 5678, LU 27 12 34 56	0

# Regions sharing a country code: the region follows the number (libphonenumber's leading
# digits and number ranges), a region hint decides only among regions where it is valid
query TTTT
SELECT p, r, phonenumber_region(p, r), phonenumber_format(p, r, 'NATIONAL')
FROM (VALUES (1, '+358 18 12345', NULL),     -- Åland shares +358 with Finland
             (2, '+44 1481 256789', NULL),   -- Guernsey shares +44 with the United Kingdom
             (3, '+44 7781 123456', 'GB'),   -- a Guernsey mobile, whatever the hint
             (4, '+7 701 234 5678', NULL),   -- Kazakhstan shares +7 with Russia
             (5, '+7 495 123 4567', NULL),
             (6, '+1 416 555 0199', 'US'),   -- a Toronto number is Canadian
             (7, '+1 242 359 1234', NULL),   -- the Bahamas are in the NANP
             (8, '+262 269 61 12 34', NULL), -- Mayotte shares +262 with Réunion
             (9, '+39 06 698 12345', NULL)   -- the Vatican shares +39 with Italy
) t(id, p, r) ORDER BY id;
----
+358 18 12345	NULL	AX	018 12345
+44 1481 256789	NULL	GG	01481 256789
+44 7781 123456	GB	GG	07781 123456
+7 701 234 5678	NULL	KZ	8 (701) 234 5678
+7 495 123 4567	NULL	RU	8 (495) 123-45-67
+1 416 555 0199	US	CA	(416) 555-0199
+1 242 359 1234	NULL	BS	(242) 359-1234
+262 269 61 12 34	NULL	YT	0269 61 12 34
+39 06 698 12345	NULL	VA	06 6981 2345

# National prefix transform: an Argentinian mobile written with the area code and the 15 of a
# domestic mobile call is the +54 9 number
query TTT
SELECT phonenumber_format('011 15 2345 6789', 'AR', 'E164'), phonenumber_format('011 15 2345 6789', 'AR', 'INTERNATIONAL'),
       (phonenumber_parse('011 15 2345 6789', 'AR')).type;
----
+5491123456789	+54 9 11 2345-6789	mobile

# Number types beyond fixed line and mobile are valid numbers with their own type
query TTT
SELECT (phonenumber_parse(p, r)).type, phonenumber_is_valid(p, r), phonenumber_format(p, r, 'INTERNATIONAL')
FROM (VALUES (1, '0900 123456', 'AT'), (2, '0810 123456', 'AT'), (3, '0780 123456', 'AT'),
             (4, '0800 123456', 'AT'), (5, '0180 1 234567', 'DE')) t(id, p, r) ORDER BY id;
----
premium_rate	true	+43 900 123456
shared_cost	true	+43 810 123456
voip	true	+43 780 123456
toll_free	true	+43 800 123456
shared_cost	true	+49 180 1 234567
