# name: test/sql/anofox_phonenumber_eu.test
# description: Issue #133 - numbers of every EU and EEA country are judged with libphonenumber's
#              metadata. Expected values are libphonenumber's (phonenumbers 9.0.43).
# group: [phonenumber]

require anofox_tabular

statement ok
LOAD anofox_tabular;

statement ok
SET anofox_tab_trace_level='warn';

# The query of the issue report: Austrian and Belgian numbers were all invalid
query TTTTT
SELECT p, r, phonenumber_is_valid(p, r), phonenumber_is_possible(p, r), phonenumber_region(p, r)
FROM (VALUES ('+43 1 234567890', 'AT'), ('+43 664 123456', 'AT'),
             ('+32 12 34 56 78', 'BE'), ('+32 470 12 34 56', 'BE'),
             ('+49 30 123456',   'DE')) t(p, r);
----
+43 1 234567890	AT	true	true	AT
+43 664 123456	AT	true	true	AT
+32 12 34 56 78	BE	true	true	BE
+32 470 12 34 56	BE	true	true	BE
+49 30 123456	DE	true	true	DE

# ... and its check which regions have metadata: all of them now
query TI
SELECT string_agg(r, ' ' ORDER BY r) FILTER (WHERE phonenumber_example(r) IS NULL) AS missing,
       count(*) FILTER (WHERE phonenumber_example(r) IS NOT NULL) AS present
FROM (SELECT unnest(['AT','BE','BG','CY','CZ','DE','DK','EE','ES','FI','FR','GR','HR','HU','IE','IT','LT','LU',
                     'LV','MT','NL','PL','PT','RO','SE','SI','SK','GB','CH','NO','US','CA','AU','JP','IN','BR','CN']) AS r);
----
NULL	37

# A customer list from all EU and EEA countries: one fixed-line and one mobile number each,
# written nationally as the customers typed them, with the country in its own column
