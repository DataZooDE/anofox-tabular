query TTTTTTTT
SELECT country, phone, phonenumber_is_valid(phone, country), phonenumber_region(phone, country),
       (phonenumber_parse(phone, country)).type, phonenumber_format(phone, country, 'E164'),
       phonenumber_format(phone, country, 'INTERNATIONAL'), phonenumber_format(phone, country, 'NATIONAL')
FROM eu_customers ORDER BY rowid;
