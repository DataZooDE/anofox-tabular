# name: test/sql/anofox_check_events.test
# description: Contract `events` companions of the time-aware checks (#107):
#              rel_count_change_events, metric_anomaly_iqr_events, rolling_values_in_set_events.
#              One row per failing (or warning) reference date of the base check, in the
#              contract's events shape (ds, kind, label, severity, value, threshold, series).
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# Same feed as anofox_check_temporal.test: ~10 orders/day from 2026-01-01 to 2026-01-15, a collapse
# on 2026-01-14 (2 orders), a spike on 2026-01-15 (40 orders) with dirty 'SHIPPED ' values.
statement ok
CREATE TEMP TABLE daily_orders AS
SELECT
    ROW_NUMBER() OVER () AS order_id,
    d::DATE AS order_date,
    CASE WHEN d = DATE '2026-01-15' AND r % 3 = 0 THEN 'SHIPPED '
         WHEN r % 2 = 0 THEN 'shipped'
         ELSE 'open' END AS status
FROM (
    SELECT d, unnest(range(1, CASE
        WHEN d = DATE '2026-01-14' THEN 3
        WHEN d = DATE '2026-01-15' THEN 41
        ELSE 11 END)) AS r
    FROM (SELECT unnest(generate_series(DATE '2026-01-01', DATE '2026-01-15', INTERVAL '1 day')) AS d)
)

# ===--------------------------------------------------------------------===
# rel_count_change_events
# ===--------------------------------------------------------------------===

# only the failing dates, ordered by ds; fail -> alarm; the violated bound is the threshold
query TTTRRT
SELECT ds, kind, severity, ROUND(value, 3), threshold, series
FROM rel_count_change_events('daily_orders', 'order_date', start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
----
2026-01-14	rel_count_change	alarm	-0.8	-0.5	daily_orders
2026-01-15	rel_count_change	alarm	3.516	0.5	daily_orders
2026-01-16	rel_count_change	alarm	-1.0	-0.5	daily_orders

# the events are exactly the base check's failing rows (label = message, value = rel_change)
query I
SELECT COUNT(*) FROM (
    (SELECT ds, label, value FROM rel_count_change_events('daily_orders', 'order_date', 'status', 3, -0.2, 0.2,
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
     EXCEPT ALL
     SELECT reference_date, message, rel_change FROM rel_count_change('daily_orders', 'order_date', 'status', 3, -0.2, 0.2,
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16') WHERE status = 'fail')
    UNION ALL
    (SELECT reference_date, message, rel_change FROM rel_count_change('daily_orders', 'order_date', 'status', 3, -0.2, 0.2,
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16') WHERE status = 'fail'
     EXCEPT ALL
     SELECT ds, label, value FROM rel_count_change_events('daily_orders', 'order_date', 'status', 3, -0.2, 0.2,
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16'))
)
----
0

# a count_column names the series
query T
SELECT DISTINCT series FROM rel_count_change_events('daily_orders', 'order_date', 'status', 3, -0.2, 0.2,
    start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
----
daily_orders.status

# single-date form: a passing date has no event, a failing date one
query I
SELECT COUNT(*) FROM rel_count_change_events('daily_orders', 'order_date', NULL, 7, -0.5, 0.5, DATE '2026-01-13')
----
0

query TT
SELECT ds, severity FROM rel_count_change_events('daily_orders', 'order_date', NULL, 7, -0.5, 0.5, DATE '2026-01-14')
----
2026-01-14	alarm

# defaults: the latest date (the spike) is the reference
query T
SELECT ds FROM anofox_tab_rel_count_change_events('daily_orders', 'order_date')
----
2026-01-15

# ===--------------------------------------------------------------------===
# metric_anomaly_iqr_events
# ===--------------------------------------------------------------------===

# 2026-01-16 has no orders: a row count of 0 is an event too
query TTTRRT
SELECT ds, kind, severity, value, threshold, series
FROM metric_anomaly_iqr_events('daily_orders', 'order_date', NULL, 30, 1.5, 'both', start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
----
2026-01-14	metric_anomaly_iqr	alarm	2.0	10.0	daily_orders
2026-01-15	metric_anomaly_iqr	alarm	40.0	10.0	daily_orders
2026-01-16	metric_anomaly_iqr	alarm	0.0	10.0	daily_orders

# mode 'lower' only reports the collapse and the day without orders
query T
SELECT ds FROM metric_anomaly_iqr_events('daily_orders', 'order_date', NULL, 30, 1.5, 'lower', start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
----
2026-01-14
2026-01-16

query I
SELECT COUNT(*) FROM (
    SELECT ds, label, value FROM metric_anomaly_iqr_events('daily_orders', 'order_date', NULL, 30, 1.5, 'both',
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16')
    EXCEPT ALL
    SELECT reference_date, message, metric_value FROM metric_anomaly_iqr('daily_orders', 'order_date', NULL, 30, 1.5, 'both',
        start_date := DATE '2026-01-01', end_date := DATE '2026-01-16') WHERE status = 'fail'
)
----
0

# ===--------------------------------------------------------------------===
# rolling_values_in_set_events
# ===--------------------------------------------------------------------===

query TTTRRT
SELECT ds, kind, severity, ROUND(value, 4), threshold, series
FROM rolling_values_in_set_events('daily_orders', 'status', ['shipped', 'open'], 'order_date', 2, 1.0,
    start_date := DATE '2026-01-13', end_date := DATE '2026-01-17')
----
2026-01-15	rolling_values_in_set	alarm	0.6905	1.0	daily_orders.status
2026-01-16	rolling_values_in_set	alarm	0.675	1.0	daily_orders.status

query I
SELECT COUNT(*) FROM rolling_values_in_set_events('daily_orders', 'status', ['shipped', 'open'], 'order_date', 7, 0.5)
----
0

# ===--------------------------------------------------------------------===
# Arguments are validated like the base check
# ===--------------------------------------------------------------------===

statement error
SELECT * FROM rel_count_change_events('daily_orders', 'order_date', start_date := DATE '2026-01-01')
----
start_date and end_date must be given together

statement error
SELECT * FROM metric_anomaly_iqr_events('daily_orders', 'order_date', NULL, 30, 1.5, 'sideways')
----
mode must be

statement error
SELECT * FROM rolling_values_in_set_events('daily_orders', 'status', ['open'], 'order_date', 0)
----
window_days must be >= 1
