# --- Bitcoin Addresses ---

# P2PKH (1 prefix - Legacy)
query I
SELECT list_contains(list_transform(pii_detect('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# P2SH (3 prefix)
query I
SELECT list_contains(list_transform(pii_detect('3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Bech32 (bc1 prefix - Native SegWit)
query I
SELECT list_contains(list_transform(pii_detect('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# --- Ethereum Addresses ---

# Standard format
query I
SELECT list_contains(list_transform(pii_detect('0x742d35Cc6634C0532925a3b844Bc454e4438f44e'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Lowercase
query I
SELECT list_contains(list_transform(pii_detect('0x742d35cc6634c0532925a3b844bc454e4438f44e'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Uppercase
query I
SELECT list_contains(list_transform(pii_detect('0x742D35CC6634C0532925A3B844BC454E4438F44E'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# --- Invalid Crypto Addresses ---

# Invalid Bitcoin checksum
query I
SELECT list_contains(list_transform(pii_detect('1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNb'), x -> x.type), 'CRYPTO_ADDRESS');
----
false

# Invalid Ethereum (wrong length)
query I
SELECT list_contains(list_transform(pii_detect('0x742d35Cc6634'), x -> x.type), 'CRYPTO_ADDRESS');
----
false

# --- Crypto in Context ---

# Bitcoin with label
query I
SELECT list_contains(list_transform(pii_detect('Send BTC to: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Ethereum with label
query I
SELECT list_contains(list_transform(pii_detect('ETH wallet: 0x742d35Cc6634C0532925a3b844Bc454e4438f44e'), x -> x.type), 'CRYPTO_ADDRESS');
----
true

# Multiple addresses
query I
SELECT pii_count('BTC: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa, ETH: 0x742d35Cc6634C0532925a3b844Bc454e4438f44e') >= 2;
----
true

# --- Crypto Masking ---

# Partial shows first 4 and last 4
query I
SELECT pii_mask('bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq', 'partial') = 'bc1q**********************************5mdq';
----
true

# Redact
query I
SELECT pii_mask('Wallet: 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa', 'redact') LIKE '%[CRYPTO_ADDRESS]%';
----
true

