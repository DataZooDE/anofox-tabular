query I
SELECT pii_detect('');
----
[]

query I
SELECT pii_detect('   ');
----
[]

query I
SELECT pii_detect('\t\n\r');
----
[]

# --- Unicode in Text ---

# Email with unicode context
query I
SELECT list_contains(list_transform(pii_detect('Kontakt: test@example.com für Anfragen'), x -> x.type), 'EMAIL');
