true

# --- IBAN with Spaces (not currently supported - requires no spaces) ---

# German with spaces
query I
SELECT list_contains(list_transform(pii_detect('DE89 3704 0044 0532 0130 00'), x -> x.type), 'IBAN');
----
false

# UK with spaces
query I
SELECT list_contains(list_transform(pii_detect('GB82 WEST 1234 5698 7654 32'), x -> x.type), 'IBAN');
----
false

# --- IBAN in Context ---

# With label
query I
SELECT list_contains(list_transform(pii_detect('IBAN: DE89370400440532013000'), x -> x.type), 'IBAN');
----
true

# In sentence
query I
SELECT list_contains(list_transform(pii_detect('Transfer to DE89370400440532013000 please'), x -> x.type), 'IBAN');
----
true

# Multiple IBANs
query I
SELECT pii_count('From: DE89370400440532013000, To: GB82WEST12345698765432') >= 2;
----
true

# --- Invalid IBAN (Bad Checksum) ---

query I
SELECT list_contains(list_transform(pii_detect('DE00000000000000000000'), x -> x.type), 'IBAN');
----
false

# --- IBAN Masking ---

# Partial shows first 4 and last 4
# Note: "IBAN" word may be detected as ORGANIZATION by NER and partially masked as "IBA*"
query I
SELECT pii_mask('Account DE89370400440532013000', 'partial') = 'Account DE89**************3000';
----
true

# Redact
query I
SELECT pii_mask('Pay to DE89370400440532013000', 'redact') = 'Pay to [IBAN]';
----
true

# ============================================================================
# IP ADDRESS DETECTION - Comprehensive Tests (30+ cases)
# ============================================================================

# --- IPv4 Addresses ---

# Standard IPv4
query I
SELECT list_contains(list_transform(pii_detect('192.168.1.1'), x -> x.type), 'IP_ADDRESS');
----
true

# Loopback
query I
SELECT list_contains(list_transform(pii_detect('127.0.0.1'), x -> x.type), 'IP_ADDRESS');
----
true

# Public IP
query I
SELECT list_contains(list_transform(pii_detect('8.8.8.8'), x -> x.type), 'IP_ADDRESS');
----
true

# Class A private
query I
SELECT list_contains(list_transform(pii_detect('10.0.0.1'), x -> x.type), 'IP_ADDRESS');
----
true

# Class B private
query I
SELECT list_contains(list_transform(pii_detect('172.16.0.1'), x -> x.type), 'IP_ADDRESS');
----
true

# Class C private
query I
SELECT list_contains(list_transform(pii_detect('192.168.0.1'), x -> x.type), 'IP_ADDRESS');
----
true

# Broadcast
query I
SELECT list_contains(list_transform(pii_detect('255.255.255.255'), x -> x.type), 'IP_ADDRESS');
----
true

# --- IPv6 Addresses (limited support) ---

# Full IPv6
query I
SELECT list_contains(list_transform(pii_detect('2001:0db8:85a3:0000:0000:8a2e:0370:7334'), x -> x.type), 'IP_ADDRESS');
----
true

# Compressed IPv6 (not currently supported)
query I
SELECT list_contains(list_transform(pii_detect('2001:db8:85a3::8a2e:370:7334'), x -> x.type), 'IP_ADDRESS');
----
false

# Loopback IPv6 (not currently supported - too short)
query I
SELECT list_contains(list_transform(pii_detect('::1'), x -> x.type), 'IP_ADDRESS');
----
false

# --- IP in Context ---

# With label
query I
SELECT list_contains(list_transform(pii_detect('Server IP: 192.168.1.100'), x -> x.type), 'IP_ADDRESS');
----
true

# In log format
query I
SELECT list_contains(list_transform(pii_detect('[2024-01-01] Request from 10.0.0.55'), x -> x.type), 'IP_ADDRESS');
----
true

# Multiple IPs
query I
SELECT pii_count('Source: 192.168.1.1, Dest: 192.168.1.2') >= 2;
----
true

# --- IP Masking ---

# Partial shows first octet
query I
SELECT pii_mask('IP: 192.168.1.100', 'partial') = 'IP: 192.***.***.**';
----
true

# Redact
query I
SELECT pii_mask('Server at 10.0.0.1', 'redact') = 'Server at [IP_ADDRESS]';
----
true

