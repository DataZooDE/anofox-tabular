    (1, 'john@example.com', '+1-555-111-2222', '111-22-3333', '4111111111111111', 'DE89370400440532013000', '192.168.1.1', '00:1A:2B:3C:4D:5E', 'John Smith', 'No PII here'),
    (2, 'mary@test.com', '+44-20-7946-0958', '444-55-6666', '5500000000000004', 'GB82WEST12345698765432', '10.0.0.1', 'AA:BB:CC:DD:EE:FF', 'Mary Johnson', 'Safe text'),
    (3, 'bob@company.org', '+49-30-1234567', '777-88-9999', '340000000000009', 'FR7630006000011234567890189', '172.16.0.1', '11:22:33:44:55:66', 'Bob Williams', 'Clean data'),
    (4, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'Nothing here'),
    (5, 'alice@site.io', '+33-1-23456789', '123-45-6789', '370000000000002', 'ES9121000418450200051332', '8.8.8.8', 'DE:AD:BE:EF:CA:FE', 'Alice Brown', 'Regular text');

