true

# ============================================================================
# MAC ADDRESS DETECTION - Comprehensive Tests (25+ cases)
# ============================================================================

# --- Different MAC Formats ---

# Colon format (most common)
query I
SELECT list_contains(list_transform(pii_detect('00:1A:2B:3C:4D:5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Hyphen format (Windows)
query I
SELECT list_contains(list_transform(pii_detect('00-1A-2B-3C-4D-5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Dot format (Cisco)
query I
SELECT list_contains(list_transform(pii_detect('001A.2B3C.4D5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# No separator
query I
SELECT list_contains(list_transform(pii_detect('001A2B3C4D5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Lowercase
query I
SELECT list_contains(list_transform(pii_detect('00:1a:2b:3c:4d:5e'), x -> x.type), 'MAC_ADDRESS');
----
true

# Mixed case
query I
SELECT list_contains(list_transform(pii_detect('00:1A:2b:3C:4d:5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# --- MAC in Context ---

# With label
query I
SELECT list_contains(list_transform(pii_detect('Device MAC: 00:1A:2B:3C:4D:5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# In log
query I
SELECT list_contains(list_transform(pii_detect('Connected device 00-1A-2B-3C-4D-5E'), x -> x.type), 'MAC_ADDRESS');
----
true

# Multiple MACs
query I
SELECT pii_count('Router: 00:1A:2B:3C:4D:5E, PC: AA:BB:CC:DD:EE:FF') >= 2;
----
true

# --- MAC Masking ---

# Partial shows vendor prefix
query I
SELECT pii_mask('MAC: 00:1A:2B:3C:4D:5E', 'partial') = 'MAC: 00:1A:**:**:**:**';
----
true

# Redact
query I
SELECT pii_mask('Device 00:1A:2B:3C:4D:5E', 'redact') LIKE '%[MAC_ADDRESS]%';
----
true

# ============================================================================
# UK NINO DETECTION - Comprehensive Tests (20+ cases)
# ============================================================================

# --- Valid NINO Formats ---

# Without spaces
query I
SELECT list_contains(list_transform(pii_detect('AB123456C'), x -> x.type), 'UK_NINO');
----
true

# With spaces
query I
SELECT list_contains(list_transform(pii_detect('AB 12 34 56 C'), x -> x.type), 'UK_NINO');
----
true

# Different valid prefixes
query I
SELECT list_contains(list_transform(pii_detect('AC123456A'), x -> x.type), 'UK_NINO');
----
true

query I
SELECT list_contains(list_transform(pii_detect('JA123456B'), x -> x.type), 'UK_NINO');
----
true

# Use valid prefix instead of ZZ (which is forbidden)
query I
SELECT list_contains(list_transform(pii_detect('AA123456D'), x -> x.type), 'UK_NINO');
----
true

# --- Invalid NINO Prefixes ---

# BG is forbidden
query I
SELECT list_contains(list_transform(pii_detect('BG123456C'), x -> x.type), 'UK_NINO');
----
false

# GB is forbidden
query I
SELECT list_contains(list_transform(pii_detect('GB123456C'), x -> x.type), 'UK_NINO');
----
false

# NK is forbidden
query I
SELECT list_contains(list_transform(pii_detect('NK123456C'), x -> x.type), 'UK_NINO');
----
false

# KN is forbidden
query I
SELECT list_contains(list_transform(pii_detect('KN123456C'), x -> x.type), 'UK_NINO');
----
false

# TN is forbidden
query I
SELECT list_contains(list_transform(pii_detect('TN123456C'), x -> x.type), 'UK_NINO');
----
false

# NT is forbidden
query I
SELECT list_contains(list_transform(pii_detect('NT123456C'), x -> x.type), 'UK_NINO');
----
false

# ZZ is forbidden
query I
SELECT list_contains(list_transform(pii_detect('ZZ123456C'), x -> x.type), 'UK_NINO');
----
false

# D cannot be first letter
query I
SELECT list_contains(list_transform(pii_detect('DA123456C'), x -> x.type), 'UK_NINO');
----
false

# --- NINO Masking ---

# Partial shows prefix and suffix
query I
SELECT pii_mask('NINO: AB123456C', 'partial') = 'NINO: AB ** ** ** C';
----
true

# Redact
query I
SELECT pii_mask('My NI is AB123456C', 'redact') LIKE '%[UK_NINO]%';
----
true

# ============================================================================
# US PASSPORT DETECTION - Comprehensive Tests (15+ cases)
# ============================================================================

# --- Valid Passport Formats ---

# Current format (9 digits). Note: a 9-digit number that also forms a valid
# SSN is reported as US_SSN by overlap resolution, so use a 9xx number here.
query I
SELECT list_contains(list_transform(pii_detect('Passport: 987654321'), x -> x.type), 'US_PASSPORT');
----
true

# Legacy format (letter + 8 digits)
query I
SELECT list_contains(list_transform(pii_detect('A12345678'), x -> x.type), 'US_PASSPORT');
----
true

# Different prefix letters
query I
SELECT list_contains(list_transform(pii_detect('B12345678'), x -> x.type), 'US_PASSPORT');
----
true

query I
SELECT list_contains(list_transform(pii_detect('Z12345678'), x -> x.type), 'US_PASSPORT');
----
true

# --- Invalid Passport ---

# Too many digits
query I
SELECT list_contains(list_transform(pii_detect('Passport: 1234567890'), x -> x.type), 'US_PASSPORT');
----
false

# --- Passport Masking ---

# Partial
query I
SELECT pii_mask('Passport A12345678', 'partial') LIKE '%A********%';
----
true

# Redact
query I
SELECT pii_mask('My passport is A12345678', 'redact') LIKE '%[US_PASSPORT]%';
----
true

# ============================================================================
# API KEY DETECTION - Comprehensive Tests (20+ cases)
# ============================================================================

# --- AWS Keys ---

# Access Key ID
query I
SELECT list_contains(list_transform(pii_detect('AKIAIOSFODNN7EXAMPLE'), x -> x.type), 'API_KEY');
----
true

# In config format
query I
SELECT list_contains(list_transform(pii_detect('aws_access_key_id = AKIAIOSFODNN7EXAMPLE'), x -> x.type), 'API_KEY');
----
true

# --- GitHub Tokens ---

# Personal Access Token (classic)
query I
SELECT list_contains(list_transform(pii_detect('ghp_1234567890abcdefghijklmnopqrstuvwxyz'), x -> x.type), 'API_KEY');
----
true

# OAuth Token
query I
SELECT list_contains(list_transform(pii_detect('gho_abcdefghijklmnopqrstuvwxyz012345'), x -> x.type), 'API_KEY');
----
true

# User-to-Server Token
query I
SELECT list_contains(list_transform(pii_detect('ghu_ABCDEFghijklmnopqrstuvwxyz012345'), x -> x.type), 'API_KEY');
----
true

# Server-to-Server Token
query I
SELECT list_contains(list_transform(pii_detect('ghs_mnopQRSTuvwxyz012345ABCDEFGHIJKL'), x -> x.type), 'API_KEY');
----
true

# --- Not API Keys (Low Entropy) ---

# Repetitive pattern
query I
SELECT list_contains(list_transform(pii_detect('aaaaaaaaaaaaaaaaaaaa'), x -> x.type), 'API_KEY');
----
false

# Sequential pattern
query I
SELECT list_contains(list_transform(pii_detect('abcdefghijklmnopqrst'), x -> x.type), 'API_KEY');
----
false

# --- API Key Masking ---

# Partial shows prefix
query I
SELECT pii_mask('Key: AKIAIOSFODNN7EXAMPLE', 'partial') LIKE '%AKIA****************%';
----
true

# Redact
query I
SELECT pii_mask('Token: ghp_1234567890abcdefghijklmnopqrstuvwxyz', 'redact') LIKE '%[API_KEY]%';
----
true

