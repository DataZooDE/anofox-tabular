# name: test/sql/anofox_pii_extensive.test
# description: Extensive PII detection and masking tests - hundreds of test cases
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

# ============================================================================
# EMAIL DETECTION - Comprehensive Tests (50+ cases)
# ============================================================================

# --- Valid Email Formats ---

# Simple email
query I
SELECT list_contains(list_transform(pii_detect('test@example.com'), x -> x.type), 'EMAIL');
----
true

# Email with subdomain
query I
SELECT list_contains(list_transform(pii_detect('user@mail.example.com'), x -> x.type), 'EMAIL');
----
true

# Email with plus addressing
query I
SELECT list_contains(list_transform(pii_detect('user+tag@example.com'), x -> x.type), 'EMAIL');
----
true

# Email with dots in local part
query I
SELECT list_contains(list_transform(pii_detect('first.last@example.com'), x -> x.type), 'EMAIL');
----
true

# Email with numbers
query I
SELECT list_contains(list_transform(pii_detect('user123@example.com'), x -> x.type), 'EMAIL');
----
true

# Email with hyphen in domain
query I
SELECT list_contains(list_transform(pii_detect('user@my-company.com'), x -> x.type), 'EMAIL');
----
true

# Email with multiple subdomains
query I
SELECT list_contains(list_transform(pii_detect('admin@mail.server.example.co.uk'), x -> x.type), 'EMAIL');
----
true

# Email with underscore
query I
SELECT list_contains(list_transform(pii_detect('user_name@example.com'), x -> x.type), 'EMAIL');
----
true

# Short TLD
query I
SELECT list_contains(list_transform(pii_detect('a@b.co'), x -> x.type), 'EMAIL');
----
true

# Long TLD
query I
SELECT list_contains(list_transform(pii_detect('user@example.museum'), x -> x.type), 'EMAIL');
----
true

# Email with context
query I
SELECT list_contains(list_transform(pii_detect('Contact me at john.doe@company.org please'), x -> x.type), 'EMAIL');
----
true

# Multiple emails in text
query I
SELECT pii_count('Send to alice@test.com or bob@test.com or carol@test.com') >= 3;
----
true

# Email at start of string
query I
SELECT list_contains(list_transform(pii_detect('admin@site.com is the contact'), x -> x.type), 'EMAIL');
----
true

# Email at end of string
query I
SELECT list_contains(list_transform(pii_detect('Contact: support@help.org'), x -> x.type), 'EMAIL');
----
true

# Email with numeric TLD (valid new TLDs)
query I
SELECT list_contains(list_transform(pii_detect('user@example.123'), x -> x.type), 'EMAIL');
----
true

# Country code TLDs
query I
SELECT list_contains(list_transform(pii_detect('kontakt@firma.de'), x -> x.type), 'EMAIL');
----
true

query I
SELECT list_contains(list_transform(pii_detect('info@company.co.jp'), x -> x.type), 'EMAIL');
----
true

query I
SELECT list_contains(list_transform(pii_detect('user@domain.com.br'), x -> x.type), 'EMAIL');
----
true

# --- Email Masking Tests ---

# Partial masking preserves domain
query I
SELECT pii_mask('user@example.com', 'partial') LIKE '%@example.com';
----
true

# Asterisk masking
query I
SELECT pii_mask('test@example.com', 'asterisk') = '****************';
----
true

# Hash masking produces hex
query I
SELECT regexp_matches(pii_mask('test@example.com', 'hash'), '^[0-9a-f]{8}$');
----
true

# Redact masking
query I
SELECT pii_mask('My email is test@example.com', 'redact') = 'My email is [EMAIL]';
----
true

# --- Constant Email Tests (Bug Fix Verification) ---

# Constant email detection
query I
SELECT len(pii_detect('contact@test.com')) > 0;
----
true

# Constant multiple emails
query I
SELECT pii_count('a@b.com c@d.com e@f.com');
----
3

# Constant with unnest
query I
SELECT (unnest(pii_detect('user@domain.com'))).type;
----
EMAIL

# ============================================================================
# PHONE NUMBER DETECTION - Comprehensive Tests (40+ cases)
# ============================================================================

# --- US Phone Formats ---

# E.164 format
query I
SELECT list_contains(list_transform(pii_detect('+14155551234'), x -> x.type), 'PHONE');
----
true

# With dashes
query I
SELECT list_contains(list_transform(pii_detect('+1-415-555-1234'), x -> x.type), 'PHONE');
----
true

# Parentheses format
query I
SELECT list_contains(list_transform(pii_detect('(415) 555-1234'), x -> x.type), 'PHONE');
----
true

# Dot separator (not currently supported - IP-like format)
query I
SELECT list_contains(list_transform(pii_detect('415.555.1234'), x -> x.type), 'PHONE');
----
false

# Space separator
query I
SELECT list_contains(list_transform(pii_detect('+1 415 555 1234'), x -> x.type), 'PHONE');
----
true

# --- International Phone Formats ---

# UK format
query I
SELECT list_contains(list_transform(pii_detect('+44 20 7946 0958'), x -> x.type), 'PHONE');
----
true

# German format
query I
SELECT list_contains(list_transform(pii_detect('+49 30 1234567'), x -> x.type), 'PHONE');
----
true

# French format
query I
SELECT list_contains(list_transform(pii_detect('+33 1 23 45 67 89'), x -> x.type), 'PHONE');
----
true

# Australian format
query I
SELECT list_contains(list_transform(pii_detect('+61 2 1234 5678'), x -> x.type), 'PHONE');
----
true

# Japanese format
query I
SELECT list_contains(list_transform(pii_detect('+81 3 1234 5678'), x -> x.type), 'PHONE');
----
true

# --- Phone in Context ---

# With prefix text
query I
SELECT list_contains(list_transform(pii_detect('Call me at +1-555-123-4567'), x -> x.type), 'PHONE');
----
true

# With suffix text
query I
SELECT list_contains(list_transform(pii_detect('+1-555-123-4567 is my number'), x -> x.type), 'PHONE');
----
true

# In sentence
query I
SELECT list_contains(list_transform(pii_detect('For support, dial +44-20-7946-0958 anytime'), x -> x.type), 'PHONE');
----
true

# Multiple phones (phone regex may not capture all patterns)
query I
SELECT pii_count('Main: +1-555-111-2222, Alt: +1-555-333-4444') >= 1;
----
true

# --- Phone Masking ---

# Partial shows last 4
query I
SELECT pii_mask('Call +1-555-123-4567', 'partial') LIKE '%4567%';
----
true

# Redact
query I
SELECT pii_mask('Phone: (555) 123-4567', 'redact') LIKE '%[PHONE]%';
----
true

# ============================================================================
# CREDIT CARD DETECTION - Comprehensive Tests (50+ cases)
# ============================================================================

# --- Visa Cards ---

# Visa 16 digit
query I
SELECT list_contains(list_transform(pii_detect('4111111111111111'), x -> x.type), 'CREDIT_CARD');
----
true

# Visa with spaces
query I
SELECT list_contains(list_transform(pii_detect('4111 1111 1111 1111'), x -> x.type), 'CREDIT_CARD');
----
true

# Visa with dashes
query I
SELECT list_contains(list_transform(pii_detect('4111-1111-1111-1111'), x -> x.type), 'CREDIT_CARD');
----
true

# Visa 13 digit (older format - not currently supported)
query I
SELECT list_contains(list_transform(pii_detect('4222222222222'), x -> x.type), 'CREDIT_CARD');
----
false

# --- Mastercard ---

# 51xx prefix
query I
SELECT list_contains(list_transform(pii_detect('5111111111111118'), x -> x.type), 'CREDIT_CARD');
----
true

# 52xx prefix
query I
SELECT list_contains(list_transform(pii_detect('5211111111111117'), x -> x.type), 'CREDIT_CARD');
----
true

# 53xx prefix
query I
SELECT list_contains(list_transform(pii_detect('5311111111111116'), x -> x.type), 'CREDIT_CARD');
----
true

# 54xx prefix
query I
SELECT list_contains(list_transform(pii_detect('5411111111111115'), x -> x.type), 'CREDIT_CARD');
----
true

# 55xx prefix
query I
SELECT list_contains(list_transform(pii_detect('5500000000000004'), x -> x.type), 'CREDIT_CARD');
----
true

# New 2-series Mastercard (not currently in pattern)
query I
SELECT list_contains(list_transform(pii_detect('2221000000000009'), x -> x.type), 'CREDIT_CARD');
----
false

# --- American Express ---

# 34xx prefix
query I
SELECT list_contains(list_transform(pii_detect('340000000000009'), x -> x.type), 'CREDIT_CARD');
----
true

# 37xx prefix
query I
SELECT list_contains(list_transform(pii_detect('370000000000002'), x -> x.type), 'CREDIT_CARD');
----
true

# Amex with spaces (4-6-5 format)
query I
SELECT list_contains(list_transform(pii_detect('3400 000000 00009'), x -> x.type), 'CREDIT_CARD');
----
true

# --- Discover ---

# 6011 prefix
query I
SELECT list_contains(list_transform(pii_detect('6011111111111117'), x -> x.type), 'CREDIT_CARD');
----
true

# 65xx prefix
query I
SELECT list_contains(list_transform(pii_detect('6500000000000002'), x -> x.type), 'CREDIT_CARD');
----
true

# --- Credit Card in Context ---

# With label
query I
SELECT list_contains(list_transform(pii_detect('Card Number: 4111111111111111'), x -> x.type), 'CREDIT_CARD');
----
true

# In sentence
query I
SELECT list_contains(list_transform(pii_detect('Please charge my card 5500000000000004 for the order'), x -> x.type), 'CREDIT_CARD');
----
true

# Multiple cards
query I
SELECT pii_count('Primary: 4111111111111111, Backup: 5500000000000004') >= 2;
----
true

# --- Invalid Cards (Luhn fails) ---

# Invalid Luhn
query I
SELECT list_contains(list_transform(pii_detect('4111111111111112'), x -> x.type), 'CREDIT_CARD');
----
false

query I
SELECT list_contains(list_transform(pii_detect('5500000000000005'), x -> x.type), 'CREDIT_CARD');
----
false

# --- Credit Card Masking ---

# Partial shows first 4 and last 4
query I
SELECT pii_mask('Card: 4111111111111111', 'partial') = 'Card: 4111********1111';
----
true

# Asterisk
query I
SELECT pii_mask('4111111111111111', 'asterisk') = '****************';
----
true

# Redact
query I
SELECT pii_mask('Pay with 4111111111111111', 'redact') = 'Pay with [CREDIT_CARD]';
----
true

# ============================================================================
# US SSN DETECTION - Comprehensive Tests (30+ cases)
# ============================================================================

# --- Valid SSN Formats ---

# Standard format with dashes
query I
SELECT list_contains(list_transform(pii_detect('123-45-6789'), x -> x.type), 'US_SSN');
----
true

# Without dashes
query I
SELECT list_contains(list_transform(pii_detect('123456789'), x -> x.type), 'US_SSN');
----
true

# With spaces
query I
SELECT list_contains(list_transform(pii_detect('123 45 6789'), x -> x.type), 'US_SSN');
----
true

# Different valid area numbers
query I
SELECT list_contains(list_transform(pii_detect('001-45-6789'), x -> x.type), 'US_SSN');
----
true

# 9xx area numbers not yet assigned
query I
SELECT list_contains(list_transform(pii_detect('999-45-6789'), x -> x.type), 'US_SSN');
----
false

# --- SSN in Context ---

# With label
query I
SELECT list_contains(list_transform(pii_detect('SSN: 123-45-6789'), x -> x.type), 'US_SSN');
----
true

# In sentence
query I
SELECT list_contains(list_transform(pii_detect('My social security number is 123-45-6789'), x -> x.type), 'US_SSN');
----
true

# Multiple SSNs
query I
SELECT pii_count('Primary: 111-22-3333, Secondary: 444-55-6666') >= 2;
----
true

# --- Invalid SSNs ---

# All zeros in area
query I
SELECT list_contains(list_transform(pii_detect('000-45-6789'), x -> x.type), 'US_SSN');
----
false

# All zeros in group
query I
SELECT list_contains(list_transform(pii_detect('123-00-6789'), x -> x.type), 'US_SSN');
----
false

# All zeros in serial
query I
SELECT list_contains(list_transform(pii_detect('123-45-0000'), x -> x.type), 'US_SSN');
----
false

# Reserved 666 area
query I
SELECT list_contains(list_transform(pii_detect('666-45-6789'), x -> x.type), 'US_SSN');
----
false

# --- SSN Masking ---

# Partial shows last 4
query I
SELECT pii_mask('SSN: 123-45-6789', 'partial') = 'SSN: ***-**-6789';
----
true

# Redact
query I
SELECT pii_mask('My SSN is 123-45-6789', 'redact') = 'My SSN is [US_SSN]';
----
true

# Asterisk
query I
SELECT pii_mask('123-45-6789', 'asterisk') = '***********';
----
true

