query I
SELECT list_contains(list_transform(pii_detect('Überweisung an: DE89370400440532013000'), x -> x.type), 'IBAN');
----
true

# --- Very Long Text ---

# PII at end of long text
query I
SELECT list_contains(list_transform(pii_detect(repeat('Lorem ipsum dolor sit amet. ', 100) || 'Email: test@test.com'), x -> x.type), 'EMAIL');
----
true

# PII at start of long text
query I
SELECT list_contains(list_transform(pii_detect('SSN: 123-45-6789 ' || repeat('Lorem ipsum dolor sit amet. ', 100)), x -> x.type), 'US_SSN');
----
true

# PII in middle of long text
query I
SELECT list_contains(list_transform(pii_detect(repeat('text ', 50) || 'Card: 4111111111111111' || repeat(' more text', 50)), x -> x.type), 'CREDIT_CARD');
----
true

# --- Special Characters Around PII ---

# PII in brackets
query I
SELECT list_contains(list_transform(pii_detect('[test@example.com]'), x -> x.type), 'EMAIL');
----
true

# PII in parentheses
query I
SELECT list_contains(list_transform(pii_detect('(123-45-6789)'), x -> x.type), 'US_SSN');
----
true

# PII in quotes
query I
SELECT list_contains(list_transform(pii_detect('"4111111111111111"'), x -> x.type), 'CREDIT_CARD');
----
true

# PII after colon
query I
SELECT list_contains(list_transform(pii_detect('IBAN:DE89370400440532013000'), x -> x.type), 'IBAN');
----
true

# PII after equals
query I
SELECT list_contains(list_transform(pii_detect('email=test@test.com'), x -> x.type), 'EMAIL');
----
true

# --- Newlines and Tabs ---

# PII after newline
query I
SELECT list_contains(list_transform(pii_detect('Contact info:
test@example.com'), x -> x.type), 'EMAIL');
----
true

# PII with tab separator
query I
SELECT list_contains(list_transform(pii_detect('Email	test@example.com'), x -> x.type), 'EMAIL');
----
true

