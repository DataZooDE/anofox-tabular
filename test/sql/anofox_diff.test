# Test 6: All rows different
statement ok
CREATE TABLE all_diff_source (id INTEGER, val INTEGER);

statement ok
CREATE TABLE all_diff_target (id INTEGER, val INTEGER);

statement ok
INSERT INTO all_diff_source VALUES (1, 100), (2, 200);

statement ok
INSERT INTO all_diff_target VALUES (3, 300), (4, 400);

query I
