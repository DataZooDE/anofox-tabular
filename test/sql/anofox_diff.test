statement ok
CREATE TABLE identical_source (id INTEGER, value VARCHAR);

statement ok
CREATE TABLE identical_target (id INTEGER, value VARCHAR);

statement ok
INSERT INTO identical_source VALUES (1, 'test'), (2, 'data');

statement ok
INSERT INTO identical_target VALUES (1, 'test'), (2, 'data');

query I
SELECT COUNT(*) FROM anofox_diff_joindiff('identical_source', 'identical_target', 'id');
----
