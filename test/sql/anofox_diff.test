# Phase 2: HashDiff Implementation Tests
#############################

# Test 1: Check HashDiff function registration
query T
SELECT COUNT(*) > 0 FROM duckdb_functions() WHERE function_name = 'anofox_diff_hashdiff';
----
true

# Test 2: Basic HashDiff with single primary key
query IIII rowsort
SELECT * FROM anofox_diff_hashdiff('source_data', 'target_data', 'id');
----
added	4	David	400
changed	2	Bob	250
removed	3	NULL	NULL

# Test 3: HashDiff with compound primary key
query IIIII rowsort
SELECT * FROM anofox_diff_hashdiff('orders_source', 'orders_target', ['user_id', 'order_date']);
----
added	3	2024-01-03	300.00	pending
changed	1	2024-01-02	200.00	completed
removed	2	2024-01-01	NULL	NULL

# Test 4: HashDiff with custom bisection_threshold
query I
SELECT COUNT(*) FROM anofox_diff_hashdiff('source_data', 'target_data', 'id', 1000);
----
3

# Test 5: HashDiff with bisection_threshold and bisection_factor
query I
SELECT COUNT(*) FROM anofox_diff_hashdiff('source_data', 'target_data', 'id', 1000, 5);
----
3

# Test 6: Verify HashDiff produces same results as JoinDiff
statement ok
CREATE TABLE verify_source (id INTEGER, val VARCHAR);

statement ok
CREATE TABLE verify_target (id INTEGER, val VARCHAR);

statement ok
INSERT INTO verify_source VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
INSERT INTO verify_target VALUES (1, 'a'), (2, 'x'), (4, 'd');

query T
SELECT
    (SELECT COUNT(*) FROM anofox_diff_joindiff('verify_source', 'verify_target', 'id')) =
    (SELECT COUNT(*) FROM anofox_diff_hashdiff('verify_source', 'verify_target', 'id')) AS same_count;
----
true
