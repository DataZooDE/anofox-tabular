----
1

# ===--------------------------------------------------------------------===
# Edge Cases: NULL Handling
# ===--------------------------------------------------------------------===

# Test 17: Table with NULLs - summary mode (NULLs should be filtered)
query I
SELECT total_count FROM metric_dbscan('dbscan_with_nulls', 'value', 0.5, 5, 'summary')
----
4

# Test 18: Table with NULLs - clusters mode (NULLs should be excluded)
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_with_nulls', 'value', 0.5, 5, 'clusters')
----
4

# ===--------------------------------------------------------------------===
# Parameter Validation Tests
# ===--------------------------------------------------------------------===

# Test 19: eps too low (below 0.0)
statement error
SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', -0.1, 5, 'summary')
----
eps must be

# Test 20: eps equal to 0.0
statement error
SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.0, 5, 'summary')
----
eps must be

# Test 21: min_pts too low (below 1)
statement error
SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 0, 'summary')
----
min_pts must be

# Test 22: min_pts - cast 0 as BIGINT
statement error
SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, CAST(0 AS BIGINT), 'summary')
----
min_pts must be

