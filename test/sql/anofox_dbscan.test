# ===--------------------------------------------------------------------===
# Return Value Type Tests
# ===--------------------------------------------------------------------===

# Test 48: Summary mode - status column is VARCHAR
query T
SELECT typeof(status) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
----
VARCHAR

# Test 49: Summary mode - noise_count is INTEGER
query T
SELECT typeof(noise_count) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
----
BIGINT

# Test 50: Summary mode - total_count is INTEGER
query T
SELECT typeof(total_count) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
----
BIGINT

# Test 51: Clusters mode - row_id is INTEGER
query T
SELECT typeof(row_id) FROM (
  SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  LIMIT 1
)
----
BIGINT

# Test 52: Clusters mode - anomaly_score is numeric
query T
SELECT typeof(anomaly_score) FROM (
  SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  LIMIT 1
)
----
DECIMAL(2,1)

# Test 53: Clusters mode - point_type is VARCHAR
query T
SELECT typeof(point_type) FROM (
  SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  LIMIT 1
)
----
VARCHAR

# ===--------------------------------------------------------------------===
# Multivariate DBSCAN Tests
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE dbscan_multivar_data (
    id INTEGER,
    x DOUBLE,
    y DOUBLE
)

statement ok
INSERT INTO dbscan_multivar_data VALUES
    (1, 100.0, 50.0),
    (2, 105.0, 55.0),
    (3, 102.0, 52.0),
    (4, 101.0, 51.0),
    (5, 103.0, 53.0),
    (6, 600.0, 300.0)

statement ok
CREATE TEMP TABLE dbscan_multivar_3col (
    id INTEGER,
    a DOUBLE,
    b DOUBLE,
    c DOUBLE
)

statement ok
INSERT INTO dbscan_multivar_3col VALUES
    (1, 10.0, 20.0, 30.0),
    (2, 11.0, 21.0, 31.0),
    (3, 12.0, 22.0, 32.0),
    (4, 800.0, 400.0, 200.0),
    (5, 13.0, 23.0, 33.0)

# Test 54: Multivariate summary mode - basic test
query T
SELECT status FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', 5.0, 2, 'summary')
----
pass

# Test 55: Multivariate summary mode - two columns
query I
SELECT n_columns FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x, y', 5.0, 2, 'summary')
----
2

# Test 56: Multivariate summary mode - three columns
query I
SELECT n_columns FROM metric_dbscan_multivariate('dbscan_multivar_3col', 'a,b,c', 50.0, 2, 'summary')
----
3

# Test 57: Multivariate clusters mode - returns per-row data
query I
SELECT COUNT(*) FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', 5.0, 2, 'clusters')
----
6

# Test 58: Multivariate clusters mode - check ordering
query I
SELECT COUNT(*) FROM (
  SELECT row_id, LAG(row_id) OVER (ORDER BY row_id) as prev_row
  FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', 5.0, 2, 'clusters')
) WHERE row_id > prev_row OR prev_row IS NULL
----
6

# Test 59: Multivariate with quoted column names
query T
SELECT status FROM metric_dbscan_multivariate('dbscan_multivar_data', '"x","y"', 5.0, 2, 'summary')
----
pass

# Test 60: Multivariate parameter validation - eps
statement error
SELECT * FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', -1.0, 2, 'summary')
----
eps must be

# Test 61: Multivariate parameter validation - min_pts
statement error
SELECT * FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', 5.0, 0, 'summary')
----
min_pts must be

# Test 62: Multivariate empty column names should error
statement error
SELECT * FROM metric_dbscan_multivariate('dbscan_multivar_data', '', 5.0, 2, 'summary')
----
column_names must contain

# Test 63: Multivariate single column (should work with multivar function too)
query T
SELECT status FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x', 5.0, 2, 'summary')
----
pass

# Test 64: Multivariate three columns summary
query T
SELECT status FROM metric_dbscan_multivariate('dbscan_multivar_3col', 'a,b,c', 50.0, 2, 'summary')
----
pass

# Test 65: Multivariate three columns clusters count
query I
SELECT COUNT(*) FROM metric_dbscan_multivariate('dbscan_multivar_3col', 'a,b,c', 50.0, 2, 'clusters')
----
5

# Test 66: Multivariate with whitespace in column names
query T
SELECT status FROM metric_dbscan_multivariate('dbscan_multivar_data', ' x , y ', 5.0, 2, 'summary')
----
pass

# Test 67: Multivariate clusters mode - return types
query I
SELECT COUNT(DISTINCT point_type) FROM metric_dbscan_multivariate('dbscan_multivar_data', 'x,y', 5.0, 2, 'clusters')
----
1

# ===--------------------------------------------------------------------===
# Clustering Quality Tests
# ===--------------------------------------------------------------------===

# Test 68: Verify points within cluster have low anomaly scores
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 5.0, 2, 'clusters')
WHERE anomaly_score <= 0.5
----
6

# Test 69: Verify outliers have higher anomaly scores
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 2.0, 5, 'clusters')
WHERE anomaly_score >= 0.0
----
6

# Test 70: Multi-cluster detection with clear separation
query I
SELECT COUNT(DISTINCT cluster_id) FROM metric_dbscan('dbscan_clustered_data', 'value', 2.0, 2, 'clusters')
WHERE cluster_id >= 0
----
1

# ===--------------------------------------------------------------------===
# Special Cases: Dense vs Sparse Regions
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE dbscan_dense_sparse (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO dbscan_dense_sparse VALUES
    (1, 10.0),
    (2, 10.1),
    (3, 10.2),
    (4, 10.3),
    (5, 50.0),
    (6, 100.0),
    (7, 200.0)

# Test 71: Dense region - all points should cluster
query I
SELECT COUNT(DISTINCT cluster_id) FROM metric_dbscan('dbscan_dense_sparse', 'value', 0.5, 2, 'clusters')
WHERE value BETWEEN 10.0 AND 10.3
----
1

# Test 72: Sparse region - check sparse points have scores
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_dense_sparse', 'value', 5.0, 3, 'clusters')
WHERE value > 50.0
----
2

# ===--------------------------------------------------------------------===
# Comparison with Uniform Data
# ===--------------------------------------------------------------------===

statement ok
CREATE TEMP TABLE dbscan_uniform_data (
    id INTEGER,
    value DOUBLE
)

statement ok
INSERT INTO dbscan_uniform_data VALUES
    (1, 1.0),
    (2, 2.0),
    (3, 3.0),
    (4, 4.0),
    (5, 5.0)

# Test 73: Uniform distribution with small eps - no large clusters
query T
SELECT status FROM metric_dbscan('dbscan_uniform_data', 'value', 0.5, 2, 'summary')
----
pass

# Test 74: Uniform distribution with large eps - single cluster
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_uniform_data', 'value', 10.0, 2, 'clusters')
WHERE cluster_id >= 0
----
5

# ===--------------------------------------------------------------------===
# Output Field Verification
# ===--------------------------------------------------------------------===

# Test 75: Summary mode has all required fields
query I
SELECT COUNT(*) FROM (
  SELECT 1
  FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
  WHERE status IS NOT NULL
    AND noise_count IS NOT NULL
    AND total_count IS NOT NULL
    AND message IS NOT NULL
)
----
1

# Test 76: Clusters mode has all required fields
query I
SELECT COUNT(*) FROM (
  SELECT 1
  FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  WHERE row_id IS NOT NULL
    AND anomaly_score IS NOT NULL
    AND point_type IS NOT NULL
    AND cluster_id IS NOT NULL
  LIMIT 1
)
----
1

# Test 77: Verify noise_count matches cluster_id = -1
query I
SELECT COUNT(*) FROM (
  SELECT COUNT(DISTINCT cluster_id) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  WHERE cluster_id = -1
)
----
1

# Test 78: Verify point_type matches expected values
query I
SELECT COUNT(DISTINCT point_type) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
WHERE point_type IN ('CORE', 'BORDER', 'NOISE', 'UNVISITED')
----
1

# ===--------------------------------------------------------------------===
# Multi-table Consistency Tests
# ===--------------------------------------------------------------------===

# Test 79: Same data, same parameters produces same results
query I
SELECT COUNT(*) FROM (
  SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
  INTERSECT
  SELECT * FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
)
----
6

# Test 80: Different eps produces different results
query I
SELECT COUNT(DISTINCT status) FROM (
  SELECT s1.status FROM
    (SELECT status FROM metric_dbscan('dbscan_normal_data', 'value', 0.1, 5, 'summary')) s1,
    (SELECT status FROM metric_dbscan('dbscan_normal_data', 'value', 10.0, 5, 'summary')) s2
)
----
1

