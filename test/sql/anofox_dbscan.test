# ===--------------------------------------------------------------------===
# Consistency Tests
# ===--------------------------------------------------------------------===

# Test 34: Multiple calls with same parameters return consistent results
query T
SELECT s1.status FROM
  (SELECT status FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')) s1,
  (SELECT status FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')) s2
WHERE s1.status = s2.status
----
pass

# Test 35: Clusters mode is reproducible with same parameters
query I
SELECT COUNT(DISTINCT point_type) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
----
1

