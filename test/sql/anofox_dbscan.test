# ===--------------------------------------------------------------------===
# Univariate Summary Mode Tests
# ===--------------------------------------------------------------------===

# Test 1: Basic summary mode with default parameters
query T
SELECT status FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
----
pass

# Test 2: Summary mode with different eps parameter
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 1.0, 5, 'summary')
----
1

# Test 3: Summary mode with different min_pts parameter
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 2, 'summary')
----
1

# Test 4: Check message field in summary mode
query T
SELECT message FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'summary')
----
DBSCAN clustering complete

# Test 5: Summary on data with clear clusters
query T
SELECT status FROM metric_dbscan('dbscan_clustered_data', 'value', 2.0, 2, 'summary')
----
pass

# Test 6: Summary on small dataset
query T
SELECT status FROM metric_dbscan('dbscan_small_data', 'value', 5.0, 1, 'summary')
----
pass

# ===--------------------------------------------------------------------===
# Univariate Clusters Mode Tests (per-row output)
# ===--------------------------------------------------------------------===

# Test 7: Basic clusters mode returns per-row data
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
----
6

# Test 8: Clusters mode - check anomaly_score range
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
WHERE anomaly_score >= 0.0 AND anomaly_score <= 1.0
----
6

# Test 9: Clusters mode - verify all rows included
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
----
6

# Test 10: Clusters mode - check ordering by row_id (ascending)
query I
SELECT COUNT(*) FROM (
  SELECT row_id, LAG(row_id) OVER (ORDER BY row_id) as prev_row
  FROM metric_dbscan('dbscan_normal_data', 'value', 0.5, 5, 'clusters')
) WHERE row_id > prev_row OR prev_row IS NULL
----
6

