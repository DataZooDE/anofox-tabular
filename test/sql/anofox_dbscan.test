query T
SELECT status FROM metric_dbscan('dbscan_empty', 'value', 0.5, 5, 'summary')
----
pass

# Test 12: Empty table - clusters mode
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_empty', 'value', 0.5, 5, 'clusters')
----
0

# Test 13: Single row - summary mode
query T
SELECT status FROM metric_dbscan('dbscan_single_row', 'value', 0.5, 5, 'summary')
----
pass

# Test 14: Single row - clusters mode
query I
SELECT COUNT(*) FROM metric_dbscan('dbscan_single_row', 'value', 0.5, 5, 'clusters')
----
1

