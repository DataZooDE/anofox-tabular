query T
SELECT status FROM dbscan('dbscan_identical_values', 'value', 0.5, 2, 'summary')
----
pass

# Test 16: Identical values - clusters mode (all points are CORE)
query I
SELECT COUNT(DISTINCT point_type) FROM dbscan('dbscan_identical_values', 'value', 0.5, 2, 'clusters')
----
1

# ===--------------------------------------------------------------------===
# Edge Cases: NULL Handling
# ===--------------------------------------------------------------------===

# Test 17: Table with NULLs - summary mode (NULLs should be filtered)
query I
SELECT total_count FROM dbscan('dbscan_with_nulls', 'value', 0.5, 5, 'summary')
----
4

# Test 18: Table with NULLs - clusters mode (NULLs should be excluded)
query I
SELECT COUNT(*) FROM dbscan('dbscan_with_nulls', 'value', 0.5, 5, 'clusters')
----
4

