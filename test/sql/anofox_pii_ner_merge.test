# name: test/sql/anofox_pii_ner_merge.test
# description: Test NER entity merging for fragmented entities
# Bug: NER model sometimes outputs multiple B- tags for consecutive tokens of same entity,
#      causing fragmentation like "Donauwoerth" -> [Don, au, wo, ert, h]
# Fix: MergeConsecutiveSameTypeEntities() merges consecutive same-type entities with no gaps

require anofox_tabular

statement ok
LOAD anofox_tabular;

# Test original bug report - Donauwoerth should not be fragmented
# Before fix: 5 separate LOCATION entities [Don, au, wo, ert, h]
# After fix: Single LOCATION entity "Donauwoerth"
query I
SELECT COUNT(*) FROM (
    SELECT m.type, m.text
    FROM (SELECT unnest(pii_detect('My name is Joachim, I am married to Linda, we live in Donauwoerth, Germany, my phone number is +49177307373')) as m)
    WHERE m.type = 'LOCATION' AND m.text LIKE '%Donauwoerth%'
);
----
1

# Test that fragmented text like "Donauwoerth" doesn't have tiny fragments
# If merging works, there should be NO LOCATION entities with len <= 3
query I
SELECT COUNT(*) FROM (
    SELECT m.type, m.text
    FROM (SELECT unnest(pii_detect('My name is Joachim, I am married to Linda, we live in Donauwoerth, Germany, my phone number is +49177307373')) as m)
    WHERE m.type = 'LOCATION' AND len(m.text) <= 3
);
----
0

# Test fragmented organization name - DataZoo GmbH
# Before fix: 3 separate ORGANIZATION entities [Data, Z, oo GmbH]
# After fix: Single ORGANIZATION entity "DataZoo GmbH"
query I
SELECT COUNT(*) FROM (
    SELECT DISTINCT m.text
    FROM (SELECT unnest(pii_detect('I work for DataZoo GmbH in Berlin')) as m)
    WHERE m.type = 'ORGANIZATION' AND m.text LIKE '%DataZoo%'
);
----
1

# Test that DataZoo GmbH is merged into single entity (not fragmented)
query I
SELECT COUNT(*) FROM (
    SELECT m.text
    FROM (SELECT unnest(pii_detect('I work for DataZoo GmbH in Berlin')) as m)
    WHERE m.type = 'ORGANIZATION' AND len(m.text) <= 4
);
----
0

# Test that Berlin is detected as LOCATION
query I
SELECT COUNT(*) FROM (
    SELECT m.type, m.text
    FROM (SELECT unnest(pii_detect('I work for DataZoo GmbH in Berlin')) as m)
    WHERE m.type = 'LOCATION' AND m.text = 'Berlin'
);
----
1

# Test that non-consecutive entities are NOT merged
# "John" and "Linda" should remain separate NAME entities
query I
SELECT COUNT(*) FROM (
    SELECT DISTINCT m.text
    FROM (SELECT unnest(pii_detect('John and Linda are friends')) as m)
    WHERE m.type = 'NAME'
);
----
2

# Verify Germany is detected as a single LOCATION (not fragmented)
query I
SELECT COUNT(*) FROM (
    SELECT m.type, m.text
    FROM (SELECT unnest(pii_detect('I live in Germany')) as m)
    WHERE m.type = 'LOCATION' AND m.text = 'Germany'
);
----
1

# Verify merged entities have valid confidence scores (0.0 - 1.0 range)
query I
SELECT COUNT(*) FROM (
    SELECT m.confidence
    FROM (SELECT unnest(pii_detect('My name is Joachim, I am married to Linda, we live in Donauwoerth, Germany')) as m)
    WHERE m.type = 'LOCATION'
    AND m.confidence >= 0.0 AND m.confidence <= 1.0
);
----
2

# Test that NAME entities "Joachim" and "Linda" stay separate (not merged)
query I
SELECT COUNT(*) FROM (
    SELECT DISTINCT m.text
    FROM (SELECT unnest(pii_detect('My name is Joachim, I am married to Linda')) as m)
    WHERE m.type = 'NAME'
);
----
2
