# name: test/sql/anofox_pii_hash.test
# description: the hash strategy is the first 16 hex characters of the SHA-256 of the
#              normalised value, so differently formatted copies of one value hash alike
# group: [sql]

require anofox_tabular

statement ok
LOAD anofox_tabular;

# --- credit card: spaces and dashes are stripped before hashing ---

query IIT
SELECT count(DISTINCT h), max(length(h)), any_value(h)
FROM (SELECT pii_mask_column(x, 'CREDIT_CARD', 'hash') AS h
      FROM (VALUES ('4111 1111 1111 1111'), ('4111111111111111'), ('4111-1111-1111-1111')) v(x));
----
1	16	9bbef19476623ca5

query I
SELECT pii_mask_column('4111-1111-1111-1111', 'CREDIT_CARD', 'hash') = left(sha256('4111111111111111'), 16);
----
true

# Inside free text only the match is replaced
query I
SELECT pii_mask('Card 4111 1111 1111 1111 on file', 'hash') = 'Card ' || left(sha256('4111111111111111'), 16) || ' on file';
----
true

# --- phone: spaces, dashes, dots and parentheses are stripped, the leading + is kept ---

query I
SELECT count(DISTINCT pii_mask_column(x, 'PHONE', 'hash'))
FROM (VALUES ('+49 (30) 1234-5678'), ('+49 30 12345678'), ('+49.30.1234.5678')) v(x);
----
1

query I
SELECT pii_mask_column('+49 30 12345678', 'PHONE', 'hash') = left(sha256('+493012345678'), 16);
----
true

# --- US SSN ---

query I
SELECT count(DISTINCT pii_mask_column(x, 'US_SSN', 'hash'))
FROM (VALUES ('123-45-6789'), ('123 45 6789')) v(x);
----
1

query I
SELECT pii_mask_column('123-45-6789', 'US_SSN', 'hash') = left(sha256('123456789'), 16);
----
true

# --- UK NINO: spaces stripped ---

query I
SELECT pii_mask_column('AB 12 34 56 C', 'UK_NINO', 'hash') = pii_mask_column('AB123456C', 'UK_NINO', 'hash');
----
true

# --- IBAN ---

query I
SELECT pii_mask_column('DE89370400440532013000', 'IBAN', 'hash') = left(sha256('DE89370400440532013000'), 16);
----
true

# --- email: lower-cased before hashing ---

query I
SELECT pii_mask_column('John.Doe@Example.COM', 'EMAIL', 'hash') = pii_mask_column('john.doe@example.com', 'EMAIL', 'hash');
----
true

query I
SELECT pii_mask_column('John.Doe@Example.COM', 'EMAIL', 'hash') = left(sha256('john.doe@example.com'), 16);
----
true

# --- other types hash the matched text unchanged ---

query I
SELECT pii_mask_column('see https://example.com/a', 'URL', 'hash') = 'see ' || left(sha256('https://example.com/a'), 16);
----
true
