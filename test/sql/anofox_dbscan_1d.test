# name: test/sql/anofox_dbscan_1d.test
# description: Univariate dbscan uses a sorted sweep for its neighbour search. The results must be
#              identical to the former all-pairs search: the fingerprints below were captured with
#              the all-pairs implementation (cluster ids, point types, neighbour counts, scores).
#              Scores are rounded to 12 digits: the DuckDB 2.0 build compiles with -march=x86-64-v3,
#              whose fused multiply-add changes the last bit of some scores.
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# 400 rows: dense runs, three shifted groups, a repeated value, far-away noise and NULLs
statement ok
CREATE TABLE db1d AS
SELECT i AS id,
       CASE WHEN i % 50 = 7 THEN NULL
            WHEN i % 37 = 0 THEN 1000 + i * 7.3
            WHEN i % 11 = 0 THEN 5.0
            ELSE ((i * 7919) % 400) / 40.0 + (CASE WHEN i % 3 = 0 THEN 30 WHEN i % 5 = 0 THEN 60 ELSE 0 END)
       END::DOUBLE AS v
FROM range(0, 400) t(i)
ORDER BY i

# row_id is the table row number, so the NULL rows leave gaps in it
query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || round(anomaly_score, 12) || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.2, 6, 'clusters')
----
17281a7968969bdc16252eeedaef7284

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || round(anomaly_score, 12) || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.1, 4, 'clusters')
----
3cab22721913aeb7341c1c01fb079cb6

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || round(anomaly_score, 12) || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.05, 5, 'clusters')
----
760f949704c2aa15a4d73e02aac96c87

query TIIIIR
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size, round(noise_rate, 6)
FROM dbscan('db1d', 'v', 0.2, 6, 'summary')
----
fail	7	116	392	220	0.295918

query TIIIIR
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size, round(noise_rate, 6)
FROM dbscan('db1d', 'v', 0.1, 4, 'summary')
----
fail	30	151	392	50	0.385204

# Floating-point boundary (1.1 - 1.0 > 0.1 in binary, 1.2 - 1.1 < 0.1), NaN and infinities
statement ok
CREATE TABLE db1d_special (v DOUBLE)

statement ok
INSERT INTO db1d_special VALUES (1.0), (1.1), (1.2), ('NaN'), ('inf'), ('inf'), ('-inf'), (1.15), (5.0), (5.05), (5.1), ('NaN')

query IRITI
SELECT row_id, value, cluster_id, point_type, neighbor_count FROM dbscan('db1d_special', 'v', 0.1, 3, 'clusters') ORDER BY row_id
----
1	1.0	-1	NOISE	0
2	1.1	0	CORE	2
3	1.2	0	CORE	2
4	nan	-1	NOISE	0
5	inf	-1	NOISE	0
6	inf	-1	NOISE	0
7	-inf	-1	NOISE	0
8	1.15	0	CORE	2
9	5.0	1	CORE	2
10	5.05	1	CORE	2
11	5.1	1	CORE	2
12	nan	-1	NOISE	0

# A larger input (the all-pairs search took seconds here)
statement ok
CREATE TABLE db1d_large AS
SELECT ((i * 7919) % 20000) / 100.0 + CASE WHEN i % 1000 = 0 THEN 500 ELSE 0 END AS v FROM range(0, 20000) t(i)

query TIIII
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size FROM dbscan('db1d_large', 'v', 0.05, 5, 'summary')
----
fail	1	20	20000	19980

# Issue #140: NaN and +-Inf values no longer switch the call to the all-pairs search. They have no
# neighbours (their distance to every value is Inf or NaN), as in the all-pairs search. The
# fingerprints and rows below were captured with the all-pairs implementation.
statement ok
CREATE TABLE db1d_nf AS
SELECT id, CASE WHEN id % 97 = 3 THEN 'inf'::DOUBLE WHEN id % 89 = 5 THEN 'nan'::DOUBLE WHEN id = 211 THEN '-inf'::DOUBLE ELSE v END AS v
FROM db1d ORDER BY id

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || round(anomaly_score, 12) || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d_nf', 'v', 0.2, 6, 'clusters')
----
35aef788f744734441dfecefb2ab8ff1

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || round(anomaly_score, 12) || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d_nf', 'v', 0.1, 4, 'clusters')
----
6eeae20a75d8c0ac80a267f159c3cdda

# min_pts = 1: every point is a core point, so each NaN and Inf is a cluster of its own
query IRITIRT
SELECT row_id, value, cluster_id, point_type, neighbor_count, round(anomaly_score, 6), is_anomaly
FROM dbscan('db1d_special', 'v', 0.1, 1, 'clusters') ORDER BY row_id
----
1	1.0	0	CORE	0	0.3	false
2	1.1	1	CORE	2	0.1	false
3	1.2	1	CORE	2	0.1	false
4	nan	2	CORE	0	0.3	false
5	inf	3	CORE	0	0.3	false
6	inf	4	CORE	0	0.3	false
7	-inf	5	CORE	0	0.3	false
8	1.15	1	CORE	2	0.1	false
9	5.0	6	CORE	2	0.1	false
10	5.05	6	CORE	2	0.1	false
11	5.1	6	CORE	2	0.1	false
12	nan	7	CORE	0	0.3	false

# One Inf in the large input (the all-pairs search took seconds here; 200k rows would take minutes)
statement ok
CREATE TABLE db1d_large_inf AS
SELECT CASE WHEN i = 12345 THEN 'inf'::DOUBLE ELSE ((i * 7919) % 200000) / 1000.0 + CASE WHEN i % 10000 = 0 THEN 500 ELSE 0 END END AS v
FROM range(0, 200000) t(i)

query TIIII
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size FROM dbscan('db1d_large_inf', 'v', 0.05, 5, 'summary')
----
fail	1	21	200000	199979
