# name: test/sql/anofox_dbscan_1d.test
# description: Univariate dbscan uses a sorted sweep for its neighbour search. The results must be
#              identical to the former all-pairs search: the fingerprints below were captured with
#              the all-pairs implementation (cluster ids, point types, neighbour counts, scores).
# group: [anofox_tabular]

require anofox_tabular

statement ok
LOAD anofox_tabular

statement ok
SET anofox_tab_trace_enabled = false

# 400 rows: dense runs, three shifted groups, a repeated value, far-away noise and NULLs
statement ok
CREATE TABLE db1d AS
SELECT i AS id,
       CASE WHEN i % 50 = 7 THEN NULL
            WHEN i % 37 = 0 THEN 1000 + i * 7.3
            WHEN i % 11 = 0 THEN 5.0
            ELSE ((i * 7919) % 400) / 40.0 + (CASE WHEN i % 3 = 0 THEN 30 WHEN i % 5 = 0 THEN 60 ELSE 0 END)
       END::DOUBLE AS v
FROM range(0, 400) t(i)
ORDER BY i

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || anomaly_score || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.2, 6, 'clusters')
----
ecdbfd996c749ab216cf676a6e164f25

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || anomaly_score || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.1, 4, 'clusters')
----
89be111d593b00e328b76611a2fc3a3f

query T
SELECT md5(string_agg(row_id || ':' || value || ':' || cluster_id || ':' || point_type || ':' || neighbor_count || ':' || anomaly_score || ':' || is_anomaly, ',' ORDER BY row_id))
FROM dbscan('db1d', 'v', 0.05, 5, 'clusters')
----
743e804284852184e060b4fcda1d65e4

query TIIIIR
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size, round(noise_rate, 6)
FROM dbscan('db1d', 'v', 0.2, 6, 'summary')
----
fail	7	116	392	220	0.295918

query TIIIIR
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size, round(noise_rate, 6)
FROM dbscan('db1d', 'v', 0.1, 4, 'summary')
----
fail	30	151	392	50	0.385204

# Floating-point boundary (1.1 - 1.0 > 0.1 in binary, 1.2 - 1.1 < 0.1), NaN and infinities
statement ok
CREATE TABLE db1d_special (v DOUBLE)

statement ok
INSERT INTO db1d_special VALUES (1.0), (1.1), (1.2), ('NaN'), ('inf'), ('inf'), ('-inf'), (1.15), (5.0), (5.05), (5.1), ('NaN')

query IRITI
SELECT row_id, value, cluster_id, point_type, neighbor_count FROM dbscan('db1d_special', 'v', 0.1, 3, 'clusters') ORDER BY row_id
----
1	1.0	-1	NOISE	0
2	1.1	0	CORE	2
3	1.2	0	CORE	2
4	nan	-1	NOISE	0
5	inf	-1	NOISE	0
6	inf	-1	NOISE	0
7	-inf	-1	NOISE	0
8	1.15	0	CORE	2
9	5.0	1	CORE	2
10	5.05	1	CORE	2
11	5.1	1	CORE	2
12	nan	-1	NOISE	0

# A larger input (the all-pairs search took seconds here)
statement ok
CREATE TABLE db1d_large AS
SELECT ((i * 7919) % 20000) / 100.0 + CASE WHEN i % 1000 = 0 THEN 500 ELSE 0 END AS v FROM range(0, 20000) t(i)

query TIIII
SELECT status, cluster_count, noise_count, total_count, largest_cluster_size FROM dbscan('db1d_large', 'v', 0.05, 5, 'summary')
----
fail	1	20	20000	19980
